def format_tool_message(tool_name: str, params: dict, state: str = "ACTIVE") -> str:
    """Turn a tool execution event into an informative, human-readable live update."""
    action = str(params.get("toolAction") or "").strip().strip('"\'')
    summary = str(params.get("toolSummary") or "").strip().strip('"\'')
    desc = str(params.get("Description") or "").strip().strip('"\'')

    def short_path(p: str) -> str:
        if not p:
            return ""
        clean_p = p.strip().strip('"\'')
        try:
            path = Path(clean_p)
            home = Path.home()
            if path == home:
                return "~"
            if home in path.parents:
                return f"~/{path.relative_to(home)}"
            return path.name or clean_p
        except Exception:
            return clean_p

    # 1. File creation / writing
    if tool_name in ("write_to_file",):
        target = short_path(str(params.get("TargetFile") or params.get("path") or ""))
        if state == "ACTIVE":
            if action:
                return f"{action}: {target}" if target else action
            return f"Making file: {target}" if target else "Making file…"
        else:  # DONE
            return f"Created {target} · Double-checking code…" if target else "File created · Double-checking code…"

    # 2. File editing / modifying
    elif tool_name in ("replace_file_content", "multi_replace_file_content", "sed_file", "notebook_edit"):
        target = short_path(str(params.get("TargetFile") or params.get("path") or ""))
        instr = str(params.get("Instruction") or desc or "").strip().strip('"\'')
        if state == "ACTIVE":
            if action:
                return f"{action}: {target}" if target else action
            if instr:
                return f"Editing {target} ({clip(instr, 60)})" if target else f"Editing file: {clip(instr, 60)}"
            return f"Editing {target}" if target else "Editing file…"
        else:
            return f"Updated {target} · Verifying changes…" if target else "File updated · Verifying changes…"

    # 3. Running commands
    elif tool_name in ("run_command", "send_command_input", "execute_browser_javascript"):
        cmd = str(params.get("CommandLine") or params.get("command") or "").strip().strip('"\'')
        if state == "ACTIVE":
            if action:
                return f"{action}: {clip(cmd, 70, collapse=True)}" if cmd else action
            return f"Running: {clip(cmd, 80, collapse=True)}" if cmd else "Running command…"
        else:
            return "Command finished · Reviewing output…"

    # 4. Viewing / inspecting files
    elif tool_name in ("view_file", "read_resource"):
        target = short_path(str(params.get("AbsolutePath") or params.get("TargetFile") or params.get("path") or ""))
        if state == "ACTIVE":
            if action:
                return f"{action}: {target}" if target else action
            return f"Reading {target}" if target else "Reading file…"
        else:
            return ""

    # 5. Searching / grep
    elif tool_name in ("grep_search", "find_by_name"):
        q = str(params.get("query") or params.get("Pattern") or "").strip().strip('"\'')
        if state == "ACTIVE":
            return f"Searching code: {clip(q, 60)}" if q else "Searching codebase…"
        else:
            return ""

    # 6. Listing directories
    elif tool_name in ("list_dir",):
        target = short_path(str(params.get("Directory") or params.get("Path") or ""))
        if state == "ACTIVE":
            return f"Checking directory: {target}" if target else "Checking directory…"
        else:
            return ""

    # 7. Web / URL fetching
    elif tool_name in ("search_web",):
        q = str(params.get("query") or "").strip().strip('"\'')
        if state == "ACTIVE":
            return f"Searching web: {clip(q, 60)}" if q else "Searching web…"
        else:
            return ""
    elif tool_name in ("read_url_content", "open_browser_url"):
        url = str(params.get("Url") or params.get("url") or "").strip()
        if state == "ACTIVE":
            return f"Fetching URL: {clip(url, 70)}" if url else "Fetching web page…"
        else:
            return ""

    # 8. Subagents & tasks
    elif tool_name in ("invoke_subagent",):
        subs = params.get("Subagents") or []
        role = ""
        if isinstance(subs, list) and subs and isinstance(subs[0], dict):
            role = str(subs[0].get("Role") or subs[0].get("TypeName") or "")
        if state == "ACTIVE":
            return f"Launching subagent: {role}" if role else "Launching subagent…"
        else:
            return f"Subagent {role} finished" if role else ""
    elif tool_name in ("manage_task",):
        act = str(params.get("Action") or "").strip()
        if state == "ACTIVE":
            return f"Managing task: {act}" if act else "Managing background task…"
        else:
            return ""

    # Fallback to action/summary/desc or friendly tool name
    if state == "ACTIVE":
        if action:
            return action
        if summary:
            return summary
        if desc:
            return clip(desc, 80)
        friendly = tool_name.replace("_", " ").strip().capitalize()
        return f"Doing {friendly}…"
    return ""


def format_code_summary(
    response: str,
    created_files: list[str] | None = None,
    modified_files: list[str] | None = None,
    commands_run: list[str] | None = None,
) -> str:
    """Format a clean, concise completion summary without raw code blocks."""
    # 1. Remove all fenced code blocks ```...```
    cleaned = re.sub(r"```[\s\S]*?```", "", response or "")

    # 2. Remove markdown headings (### Heading, etc.)
    cleaned = re.sub(r"^#+\s*.*$", "", cleaned, flags=re.MULTILINE)

    # 3. Remove common lead-in boilerplate that introduced code blocks
    cleaned = re.sub(
        r"(?i)\b(here is the code|here's the code|compile and run|compile & run|run it using|you can run it using|you can run this|to run this|output:)\s*:?",
        "",
        cleaned,
    )

    # 4. Strip markdown file links: [`file`](file://...) -> file
    cleaned = re.sub(r"\[`?([^\]`]+)`?\]\(file://[^\)]+\)", r"\1", cleaned)
    cleaned = re.sub(r"\[`?([^\]`]+)`?\]\([^\)]+\)", r"\1", cleaned)

    # 5. Clean up inline backticks around filenames or single words
    cleaned = re.sub(r"`([^`]+)`", r"\1", cleaned)

    # 6. Clean empty lines and trailing colons
    lines = [line.strip().rstrip(":") for line in cleaned.splitlines() if line.strip()]
    text = " ".join(lines).strip()

    parts: list[str] = []
    if text:
        text = text.rstrip(" :-,")
        if not text.endswith((".", "!", "?")):
            text += "."
        parts.append(text)

    lower = text.lower()
    if "works as intended" not in lower and "working as intended" not in lower:
        parts.append("Everything works as intended.")

    final = " ".join(parts).strip()
    return final or "Everything works as intended."



def stream(request: str, history: list[dict], mode: str) -> int:
    key, model, brave_key = load_config(mode)
    if not key and mode == "local":
        emit("error", text="No API key. Add geminiKey to "
                           f"{config_path()} or set OMAGENT_GEMINI_KEY.")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, stop)

    if mode == MODE_CODE:
        if DRY_RUN:
            emit("agent", name="antigravity", label="Antigravity", model="",
                 mode=mode, web=False, engine=None, sources=0)
            emit("status", text="Would run: agy --print <request> --output-format stream-json --dangerously-skip-permissions"
                           + (" --conversation <saved-id>" if read_code_conv() else ""))
            emit("done", ok=True, code=0, stopped=False)
            return 0
        if shutil.which("agy") is None and shutil.which("antigravity") is None:
            emit("error", text="agy/antigravity not installed. Choose one with: omarchy default agent <name>")
            emit("done", ok=False, code=1, stopped=False)
            return 1
        if not history:
            # New pill thread → fresh harness conversation.
            clear_code_conv()
        conv_id = read_code_conv()

        emit("status", text="Launching Antigravity harness…")

        argv = ["agy", "--print", request, "--output-format", "stream-json",
                "--dangerously-skip-permissions"]
        if conv_id:
            argv += ["--conversation", conv_id]

        said_text = False
        emitted_result = False
        last_status = ""

        def emit_status(text: str) -> None:
            nonlocal last_status
            clean = text.strip()
            if clean and clean != last_status:
                last_status = clean
                emit("status", text=clean)
                try:
                    with open(CODE_LOG_FILE, "a", errors="ignore") as f:
                        f.write(f"[{time.strftime('%H:%M:%S')}] • {clean}\n")
                except OSError:
                    pass

        global ACTIVE_PROC
        try:
            proc = subprocess.Popen(argv, cwd=str(work_dir()),
                                    stdout=subprocess.PIPE, text=True, bufsize=1)
            ACTIVE_PROC = proc
            try:
                CODE_STATE_DIR.mkdir(parents=True, exist_ok=True)
                CODE_PID_FILE.write_text(str(proc.pid))
                CODE_LOG_FILE.write_text(f"[{time.strftime('%H:%M:%S')}] Launching Antigravity harness…\n")
            except OSError:
                pass
        except OSError as error:
            emit("error", text=f"Cannot start agy: {error}")
            emit("done", ok=False, code=1, stopped=False)
            return 1

        active_tools: dict[int, tuple[str, dict]] = {}
        created_files: list[str] = []
        modified_files: list[str] = []
        commands_run: list[str] = []

        try:
            for line in proc.stdout or []:
                line = line.strip()
                if not line:
                    continue
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                ev_name = ev.get("event")
                if ev_name == "init":
                    new_conv = ev.get("conversation_id") or ""
                    if new_conv:
                        write_code_conv(new_conv)
                    init_data = ev.get("init") or {}
                    model_name = str(init_data.get("model") or "")
                    emit("agent", name="antigravity", label="Antigravity",
                         model=model_name,
                         mode=mode, web=False, engine=None, sources=0)
                    emit_status("Antigravity harness launched")

                elif ev_name == "step_update":
                    su = ev.get("step_update") or {}
                    stype = su.get("step_type")
                    state = su.get("state")
                    step_idx = su.get("step_index", 0)

                    if stype == "user_input" and state == "DONE":
                        emit_status("Analyzing request & planning steps…")

                    elif stype == "tool":
                        tool_name = str(su.get("tool_name") or "tool")
                        params = (su.get("tool_info") or {}).get("parameters") or {}
                        if state == "ACTIVE":
                            active_tools[step_idx] = (tool_name, params)
                            if tool_name == "write_to_file":
                                tgt = Path(str(params.get("TargetFile") or "")).name
                                if tgt and tgt not in created_files:
                                    created_files.append(tgt)
                            elif tool_name in ("replace_file_content", "multi_replace_file_content", "sed_file"):
                                tgt = Path(str(params.get("TargetFile") or "")).name
                                if tgt and tgt not in modified_files:
                                    modified_files.append(tgt)
                            elif tool_name in ("run_command", "send_command_input"):
                                cmd = str(params.get("CommandLine") or "").strip()
                                if cmd and cmd not in commands_run:
                                    commands_run.append(cmd)

                            msg = format_tool_message(tool_name, params, state="ACTIVE")
                            if msg:
                                emit_status(msg)
                        elif state == "DONE":
                            tool_name, prev_params = active_tools.pop(step_idx, (tool_name, params))
                            done_params = {**prev_params, **params}
                            msg = format_tool_message(tool_name, done_params, state="DONE")
                            if msg:
                                emit_status(msg)

                    elif stype == "agent_response":
                        text_delta = su.get("text_delta")
                        if text_delta:
                            try:
                                with open(CODE_LOG_FILE, "a", errors="ignore") as f:
                                    f.write(text_delta)
                            except OSError:
                                pass

                elif ev_name == "result":
                    emitted_result = True
                    result = ev.get("result") or {}
                    usage = result.get("usage") or {}
                    total = usage.get("total_tokens")
                    if isinstance(total, (int, float)):
                        emit("usage", tokens=int(total), cost=None)
                    if result.get("status") == "SUCCESS":
                        raw_resp = str(result.get("response") or "")
                        summary = format_code_summary(
                            raw_resp,
                            created_files=created_files,
                            modified_files=modified_files,
                            commands_run=commands_run,
                        )
                        emit("text", text=summary)
                    else:
                        emit("error", text=f"Agent returned {result.get('status')}")
        finally:
            ACTIVE_PROC = None
            try:
                CODE_PID_FILE.unlink(missing_ok=True)
                with open(CODE_LOG_FILE, "a", errors="ignore") as f:
                    f.write(f"\n[{time.strftime('%H:%M:%S')}] ✦ Turn complete.\n")
            except OSError:
                pass
            proc.wait()

        if proc.returncode != 0 and not EMITTED_ERROR:
            emit("error", text=f"agy exited {proc.returncode}")
            emit("done", ok=False, code=proc.returncode or 1, stopped=False)
            return proc.returncode or 1
        if not emitted_result:
            emit("error", text="agy produced no result event")
            emit("done", ok=False, code=1, stopped=False)
            return 1
        emit("done", ok=True, code=0, stopped=False)
        return 0


    if mode == MODE_WEB:
        # WEB mode deliberately does not call Gemini. It answers straight from
        # the search results, so it works with no Gemini key at all.
        emit("agent", name="duckduckgo", label="DuckDuckGo", model="DuckDuckGo",
             mode=mode, web=True, engine=None, sources=0)

        # Follow-up question? First check whether the previous answer already
        # covers it — only hit the network when it does not.
        primary = last_answer_text(history)
        if primary and looks_like_followup(request, history):
            if DRY_RUN:
                emit("done", ok=True, code=0, stopped=False)
                return 0
            emit("tool", text="Checking previous answer…")
            covered = answer_from_primary(request, primary)
            if covered:
                emit("text", text=covered)
                emit("status", text="Answered from the previous response")
                emit("done", ok=True, code=0, stopped=False)
                return 0
            emit("tool", text="Not covered — searching the web…")

        # Fresh question, or a follow-up the previous answer could not cover:
        # do real research. Follow-ups get a context-ful query so the search
        # engine knows what "it"/"his" refers to.
        primary = last_answer_text(history)
        seed = fresh_query(request)
        if looks_like_followup(request, history):
            seed = contextual_search_query(request, history)
        found, engine, ddg_blocked = gather_sources(seed, mode, brave_key)
        emit("tool", text=(f"Searched {engine}" if found else "No web results"))
        if DRY_RUN:
            emit("done", ok=True, code=0, stopped=False)
            return 0
        if found:
            summary = summarize_web_answer(request, found, primary=primary)
            if summary and not summary_gives_up(summary):
                emit("text", text=summary)
            else:
                # Results did not answer the question: do one more targeted
                # search rather than giving up.
                emit("tool", text="Not answered — searching again…")
                better_seed = refined_search_query(request, history)
                found2, engine2, _b2 = gather_sources(better_seed, mode,
                                                      brave_key)
                tried2 = bool(found2)
                summary2 = (summarize_web_answer(request, found2,
                                                 primary=primary,
                                                 relaxed=True)
                            if tried2 else None)
                if summary2 and not summary_gives_up(summary2):
                    emit("tool", text=f"Searched {engine2} again")
                    emit("text", text=summary2)
                    found = found2
                elif tried2:
                    emit("tool", text=f"Searched {engine2} again")
                    emit("text", text=(summary2 or format_web_results(found2)))
                    found = found2
                else:
                    emit("text", text=(summary or format_web_results(found)))
            shown = ", ".join(
                dict.fromkeys(
                    urllib.parse.urlparse(item["url"]).netloc or item["url"]
                    for item in found if item["url"]
                )
            )
            if shown:
                emit("status", text="Sources: " + shown)
        else:
            if ddg_blocked:
                emit("text", text="DuckDuckGo is rate-limiting this machine "
                                  "right now — ask again in a moment, or add "
                                  "a braveKey to the config for a stronger "
                                  "backend.")
            else:
                emit("text", text="No web results. DuckDuckGo returned nothing "
                                  "for this — try rephrasing, or add a braveKey "
                                  "to the config for a stronger backend.")
        emit("done", ok=True, code=0, stopped=False)
        return 0

    found, engine, _blocked = gather_sources(request, mode, brave_key)

    body = build_body(request, history, mode, found, engine)
    emit("agent", name="gemini", label="Gemini", model=model, mode=mode,
         web=mode == MODE_WEB, engine=engine or None, sources=len(found))

    if DRY_RUN:
        emit("done", ok=True, code=0, stopped=False)
        return 0

    said = False
    tokens = 0
    blocked: str | None = None
    started_at = time.monotonic()
    budget = TOTAL_BUDGET_WEB if mode == MODE_WEB else TOTAL_BUDGET_LOCAL

    def out_of_budget() -> bool:
        return time.monotonic() - started_at >= budget

    for attempt in range(1, MAX_ATTEMPTS + 1):
        last = attempt == MAX_ATTEMPTS or out_of_budget()
        try:
            for event in sse_events(model, body, key, mode):
                usage = event.get("usageMetadata")
                if isinstance(usage, dict):
                    count = usage.get("totalTokenCount")
                    if isinstance(count, (int, float)):
                        tokens = max(tokens, int(count))

                block = event.get("promptFeedback", {})
                reason = (block.get("blockReason")
                          if isinstance(block, dict) else None)
                if reason:
                    blocked = str(reason)
                    break

                for candidate in event.get("candidates") or []:
                    if not isinstance(candidate, dict):
                        continue
                    content = candidate.get("content")
                    parts = (content.get("parts")
                             if isinstance(content, dict) else None)
                    for part in parts or []:
                        if not isinstance(part, dict) or part.get("thought"):
                            continue
                        piece = part.get("text")
                        if isinstance(piece, str) and piece:
                            said = True
                            emit("text", text=piece)
            break

        except ApiError as error:
            # Retrying once text is on screen would duplicate the answer, so
            # only a failure before the first chunk is worth repeating. A spent
            # quota is skipped entirely: waiting cannot help.
            if (error.code in RETRY_STATUS and not said and not last
                    and not quota_exhausted(error.code, "", error.message)):
                time.sleep(RETRY_BACKOFF_SECONDS * attempt)
                continue
            emit("error", text=error_text(error.code, "", error.message, mode))
            emit("done", ok=False, code=1, stopped=False)
            return 1
        except (TimeoutError, socket.timeout) as error:
            # A stalled socket before the first token is the common case and is
            # worth one more go, because the retry is invisible.
            if not said and not last:
                time.sleep(RETRY_BACKOFF_SECONDS * attempt)
                continue
            emit("error", text="Gemini stalled with no reply"
                  if not said else "Gemini stopped sending")
            emit("done", ok=False, code=1, stopped=False)
            return 1
        except (urllib.error.URLError, OSError, http.client.HTTPException) as error:
            if not said and not last:
                time.sleep(RETRY_BACKOFF_SECONDS * attempt)
                continue
            reason = getattr(error, "reason", None) or error
            emit("error", text=clip(f"Gemini unreachable: {reason}",
                                    MAX_ERROR_CHARS, collapse=True))
            emit("done", ok=False, code=1, stopped=False)
            return 1

    if blocked:
        emit("error", text=f"Blocked: {blocked}")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    if found:
        shown = ", ".join(
            dict.fromkeys(
                urllib.parse.urlparse(item["url"]).netloc or item["url"]
                for item in found if item["url"]
            )
        )
        if shown:
            emit("status", text="Sources: " + shown)
    if tokens:
        emit("usage", tokens=tokens, cost=None)
    if not said and not EMITTED_ERROR:
        emit("error", text="Empty answer")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    emit("done", ok=True, code=0, stopped=False)
    return 0


def main() -> int:
    arguments = sys.argv[1:]
    mode = MODE_LOCAL
    history_raw = ""

    while arguments and arguments[0].startswith("--"):
        option = arguments.pop(0)
        if option == "--":
            break
        elif option == "--mode" and arguments:
            mode = arguments.pop(0)
            if mode not in MODE_RULES:
                print(f"Unknown mode: {mode} "
                      f"(expected {MODE_LOCAL} or {MODE_WEB})", file=sys.stderr)
                return 2
        elif option == "--history" and arguments:
            history_raw = arguments.pop(0)
        else:
            print(f"Unknown option: {option}", file=sys.stderr)
            return 2

    if len(arguments) != 1 or not arguments[0].strip():
        print("Usage: omagent-route [--mode local|web] [--history JSON] <request>",
              file=sys.stderr)
        return 2

    request = arguments[0].strip()
    if len(request) > MAX_REQUEST_CHARS:
        emit("error",
             text=f"Requests are limited to {MAX_REQUEST_CHARS} characters")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    return stream(request, trim_history(history_raw), mode)


if __name__ == "__main__":
    raise SystemExit(main())
