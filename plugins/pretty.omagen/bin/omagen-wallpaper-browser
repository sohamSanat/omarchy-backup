#!/usr/bin/env python3

# Omagen wallpaper browser launcher.
#
# Runs the bundled QtWebEngine wallpaper browser (Wallpaper Flare). Follows
# the same stdio contract as omagen-file-select:
#   stdout: path of the chosen wallpaper  -> exit 0
#   (user cancelled / closed window)      -> exit 1
#   stderr: error message                 -> exit 2
#
# The browser app cannot print to stdout under this distro's QML setup, so the
# selected file is discovered structurally: the browser app downloads the
# wallpaper into QtWebEngine's default download directory, and the wrapper
# picks the newest PNG/JPEG created during this session.

import os
import shutil
import subprocess
import sys
import time

QML_APP = os.path.normpath(
    os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        os.pardir,
        "qml",
        "views",
        "WallpaperBrowserApp.qml",
    )
)

IMAGE_EXTENSIONS = (".jpg", ".jpeg", ".png")
RESULT_FILE = "/tmp/omagen-wallpaper-browser.ini"


def download_dirs():
    home = os.path.expanduser("~")
    candidates = []
    xdg_download = None
    config_expected = os.path.join(home, ".config", "user-dirs.dirs")
    try:
        with open(config_expected, "r", encoding="utf-8") as config:
            for line in config:
                if line.startswith("XDG_DOWNLOAD_DIR="):
                    xdg_download = line.split("=", 1)[1].strip().strip('"').replace("$HOME", home)
    except OSError:
        pass
    if xdg_download:
        candidates.append(xdg_download)
    candidates.append(os.path.join(home, "Downloads"))
    candidates.append(os.path.join(home, "downloads"))
    candidates.append(os.path.join(home, "Images"))
    return [path for path in candidates if os.path.isdir(path)]


def snapshot(dirs):
    files = {}
    for directory in dirs:
        try:
            for entry in os.scandir(directory):
                if entry.is_file() and entry.name.lower().endswith(IMAGE_EXTENSIONS):
                    files[entry.path] = entry.stat().st_mtime
        except OSError:
            pass
    return files


def find_new_wallpaper(dirs, before, started_at):
    best = None
    best_mtime = 0
    for directory in dirs:
        try:
            for entry in os.scandir(directory):
                if not entry.is_file() or not entry.name.lower().endswith(IMAGE_EXTENSIONS):
                    continue
                stat = entry.stat()
                if stat.st_mtime < started_at - 2:
                    continue
                prior_mtime = before.get(entry.path)
                if prior_mtime == stat.st_mtime:
                    continue
                if stat.st_mtime > best_mtime:
                    best = entry.path
                    best_mtime = stat.st_mtime
        except OSError:
            pass
    return best


def read_result():
    try:
        with open(RESULT_FILE, "r", encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("resultPath="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        return None
    return None


def main():
    qml6 = shutil.which("qml6")
    if qml6 is None:
        print("omagen-wallpaper-browser: qml6 runtime is not installed", file=sys.stderr)
        return 2
    if not os.path.isfile(QML_APP):
        print(f"omagen-wallpaper-browser: missing {QML_APP}", file=sys.stderr)
        return 2

    try:
        os.unlink(RESULT_FILE)
    except OSError:
        pass

    dirs = download_dirs()
    before = snapshot(dirs)
    started_at = time.time()

    proc = subprocess.Popen([qml6, QML_APP])
    try:
        proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        proc.wait()
        return 1

    if proc.returncode == 0:
        candidate = read_result()
        if candidate is not None and os.path.isfile(candidate):
            print(candidate)
            return 0
        # Fallback: discover the newest wallpaper downloaded this session.
        candidate = find_new_wallpaper(dirs, before, started_at)
        if candidate is not None:
            print(candidate)
            return 0
        print("omagen-wallpaper-browser: browser exited successfully but no wallpaper was saved", file=sys.stderr)
        return 2

    if proc.returncode == 1:
        return 1

    print(f"omagen-wallpaper-browser: browser failed (exit {proc.returncode})", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
