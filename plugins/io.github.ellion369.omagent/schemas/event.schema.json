{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omagent.local/schemas/event.schema.json",
  "title": "Omagent controller event",
  "type": "object",
  "required": ["schema_version", "conversation_id", "run_id", "sequence", "kind", "timestamp", "data"],
  "properties": {
    "schema_version": {"const": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": ["string", "null"]},
    "attempt_id": {"type": ["string", "null"]},
    "provider_session_id": {"type": ["string", "null"]},
    "sequence": {"type": "integer", "minimum": 1},
    "kind": {"type": "string"},
    "timestamp": {"type": "string"},
    "data": {"type": "object"}
  },
  "additionalProperties": false
}
