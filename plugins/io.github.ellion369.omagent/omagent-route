def search_duckduckgo(query: str, max_results: int = 4) -> list[dict]:
    url = "https://html.duckduckgo.com/html/?q=" + urllib.parse.quote(query)
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": (
                "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"
            )
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            content = resp.read().decode("utf-8", errors="ignore")
            snippets = re.findall(r'<a class="result__snippet[^>]*>(.*?)</a>', content, re.DOTALL)
            links = re.findall(r'<a class="result__url[^>]*>(.*?)</a>', content, re.DOTALL)
            results = []
            for i, s in enumerate(snippets[:max_results]):
                snippet_clean = html.unescape(re.sub(r"<[^>]+>", "", s)).strip()
                link_clean = html.unescape(re.sub(r"<[^>]+>", "", links[i])).strip() if i < len(links) else ""
                if snippet_clean:
                    results.append({"snippet": snippet_clean, "link": link_clean})
            return results
    except Exception as e:
        if DEBUG:
            print(f"DuckDuckGo search error: {e}", file=sys.stderr)
        return []


def resolve_contextual_query(query: str, history: list[dict], api_key: str, model: str = "gemini-3.5-flash") -> str:
    """Expands pronouns and references in search queries using conversation context."""
    if not history or not api_key:
        return query

    needs_context = bool(re.search(
        r"\b(he|she|it|they|his|her|their|them|this|that|these|those|the 1st|the 2nd|the first|the second|1st|2nd|former|latter|who was|who is|what was|what is|how about|why did|when did|where did|and what|what of)\b",
        query, re.IGNORECASE
    ))
    if not needs_context:
        return query

    snippet_lines = []
    for turn in history[-4:]:
        role = "User" if turn.get("role") == "user" else "Assistant"
        parts = turn.get("parts", [{}])
        txt = parts[0].get("text", "").strip() if parts else ""
        if txt:
            snippet_lines.append(f"{role}: {clip(txt, 300)}")
    history_ctx = "\n".join(snippet_lines)

    clean_model = sanitize_rest_model(model)
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{clean_model}:generateContent?key={api_key}"
    prompt = (
        f"Conversation history:\n{history_ctx}\n\n"
        f"Current user query: {query}\n\n"
        f"Rewrite the current query into a standalone search query that resolves all pronouns and references. "
        f"Return ONLY the search query, nothing else."
    )
    body = {"contents": [{"parts": [{"text": prompt}]}]}
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            resolved = data.get("candidates", [{}])[0].get("content", {}).get("parts", [{}])[0].get("text", "").strip()
            if resolved and len(resolved) < 150:
                return resolved.strip("\"'")
    except Exception:
        pass
    return query


