def cmd_save_session(session_id: str) -> int:
    if not session_id:
        print(json.dumps({"ok": False, "error": "Missing session ID"}))
        return 1

    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    session_file = SESSION_DIR / f"{session_id}.json"
    last_file = STATE_DIR / "last.json"

    data: dict = {}
    if session_file.is_file():
        try:
            existing = json.loads(session_file.read_text("utf-8"))
            if isinstance(existing, dict):
                data = existing
        except Exception:
            pass

    if last_file.is_file():
        try:
            last_state = json.loads(last_file.read_text("utf-8"))
            if isinstance(last_state, dict) and last_state.get("sessionId") == session_id:
                for key in ("entries", "agentName", "agentLabel", "agentCwd", "resumeLabel",
                            "resumeArgv", "priorTokens", "priorCost", "sawCost", "elapsedMs", "title"):
                    if key in last_state:
                        data[key] = last_state[key]
        except Exception as e:
            if DEBUG:
                print(f"Error merging last.json for session {session_id}: {e}", file=sys.stderr)

    data["sessionId"] = session_id
    data["updatedAt"] = int(time.time() * 1000)

    if "title" not in data or not data["title"]:
        entries = data.get("entries", [])
        for e in entries:
            if e.get("rowKind") == "you":
                data["title"] = clip(e.get("rowText", ""), 80, collapse=True)
                break

    try:
        session_file.write_text(json.dumps(data, indent=2), "utf-8")
        print(json.dumps({"ok": True}))
        return 0
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)}))
        return 1


def cmd_delete_session(session_id: str) -> int:
    if not session_id:
        print(json.dumps({"ok": False, "error": "Missing session ID"}))
        return 1

    session_file = SESSION_DIR / f"{session_id}.json"
    if session_file.is_file():
        try:
            session_file.unlink()
        except Exception as e:
            if DEBUG:
                print(f"Error deleting session file: {e}", file=sys.stderr)

    last_file = STATE_DIR / "last.json"
    if last_file.is_file():
        try:
            data = json.loads(last_file.read_text("utf-8"))
            if data.get("sessionId") == session_id:
                data["entries"] = []
                data["sessionId"] = ""
                data["agentName"] = ""
                data["agentLabel"] = ""
                data["title"] = ""
                last_file.write_text(json.dumps(data, indent=2), "utf-8")
        except Exception:
            pass

    print(json.dumps({"ok": True}))
    return 0


def cmd_clear_history() -> int:
    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    for p in SESSION_DIR.glob("*.json"):
        try:
            p.unlink()
        except Exception:
            pass

    last_file = STATE_DIR / "last.json"
    if last_file.is_file():
        try:
            data = json.loads(last_file.read_text("utf-8"))
            data["entries"] = []
            data["sessionId"] = ""
            data["agentName"] = ""
            data["agentLabel"] = ""
            data["title"] = ""
            last_file.write_text(json.dumps(data, indent=2), "utf-8")
        except Exception:
            pass

    print(json.dumps({"ok": True}))
    return 0


def emit(kind: str, **fields: object) -> None:
    global EMITTED_ERROR
    if kind == "error":
        EMITTED_ERROR = True
    print(json.dumps({"kind": kind, **fields}), flush=True)


def clip(text: str, limit: int, *, collapse: bool = False) -> str:
    text = " ".join(str(text).split()) if collapse else str(text).strip()
    return text if len(text) <= limit else text[: limit - 1] + "…"


