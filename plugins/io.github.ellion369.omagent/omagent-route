def resolve_compound_skill(prompt: str) -> tuple[str, list[str], str]:
    prompt_lower = prompt.lower()
    for skill in COMPOUND_SKILLS_MAP:
        if skill in prompt_lower:
            meta = COMPOUND_SKILLS_MAP[skill]
            return skill, meta["aux"], meta["desc"]

    for skill, data in COMPOUND_SKILLS_MAP.items():
        for pattern in data["keywords"]:
            if re.search(pattern, prompt_lower, re.IGNORECASE):
                return skill, data["aux"], data["desc"]

    return "ce-work", COMPOUND_SKILLS_MAP["ce-work"]["aux"], COMPOUND_SKILLS_MAP["ce-work"]["desc"]


def load_prior_learnings(cwd: Path) -> str:
    """Scans for prior repo and system learnings (ce-compound) to inform the agent before coding."""
    learning_dirs = [
        cwd / "solutions",
        cwd / "docs/solutions",
        cwd / ".agents/learnings",
        Path.home() / ".agents/learnings",
    ]
    learnings = []
    seen_files = set()
    for d in learning_dirs:
        if d.is_dir():
            for f in sorted(d.glob("*.md"))[:5]:
                if f.name in seen_files:
                    continue
                seen_files.add(f.name)
                try:
                    content = f.read_text(encoding="utf-8", errors="ignore").strip()
                    if content:
                        lines = [line.strip() for line in content.splitlines() if line.strip() and not line.startswith("---")]
                        snippet = " - ".join(lines[:2])
                        learnings.append(f"• [{f.name}]: {clip(snippet, 180)}")
                except Exception:
                    continue
    if learnings:
        return "[Prior Repository Learnings & Caveats (ce-compound)]\n" + "\n".join(learnings[:8]) + "\n\n"
    return ""


def extract_crash_context(prompt: str) -> str:
    """If prompt is about a crash or coredump, extracts recent coredumpctl info."""
    if not re.search(r"\b(crash|coredump|segfault|sigsegv|sigabrt)\b", prompt, re.IGNORECASE):
        return ""
    m = re.search(r"\b(?:crash|coredump|pid)\s*#?(\d+)\b", prompt, re.IGNORECASE)
    pid = m.group(1) if m else None
    cmd = ["coredumpctl", "info", pid] if pid else ["coredumpctl", "info", "-n", "1"]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=3)
        if res.returncode == 0 and res.stdout.strip():
            lines = res.stdout.splitlines()
            header = []
            trace = []
            in_trace = False
            for line in lines:
                if "Stack trace of thread" in line:
                    in_trace = True
                if in_trace:
                    trace.append(line)
                    if len(trace) > 16:
                        break
                elif any(k in line for k in ("PID:", "Signal:", "Executable:", "Command Line:", "Message:")):
                    header.append(line.strip())
            return (
                "[Crash Telemetry from coredumpctl (diagnose-crash)]\n"
                + "\n".join(header)
                + "\n"
                + "\n".join(trace)
                + "\n\n"
            )
    except Exception:
        pass
    return ""


