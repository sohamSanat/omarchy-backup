def work_dir() -> Path:
    cfg = load_config()
    if cfg.get("work_dir"):
        p = Path(cfg["work_dir"]).expanduser().resolve()
        if p.is_dir():
            return p
    try:
        cur = Path.cwd().resolve()
        if cur != Path.home() and cur.is_dir():
            return cur
    except Exception:
        pass
    for candidate in [Path.home() / "Projects", Path.home() / "Work", Path.home() / "src"]:
        if candidate.is_dir():
            return candidate
    return Path.home()


def extend_path() -> None:
    home = Path.home()
    extra = [
        str(home / ".local/bin"),
        str(home / ".local/share/mise/shims"),
        "/usr/local/bin",
        "/usr/bin",
    ]
    current = os.environ.get("PATH", "").split(os.pathsep)
    os.environ["PATH"] = os.pathsep.join(current + [p for p in extra if p not in current])


