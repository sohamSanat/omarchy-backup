def run_lane_general(request: str, config: dict, session_id: str) -> int:
    api_key = config.get("gemini_api_key", "").strip()
    cwd = work_dir()

    emit(
        "agent",
        name="jarvis",
        label="Jarvis",
        session=session_id,
        cwd=str(cwd),
        resume=[],
        resumeLabel="Expand",
        pid=0,
    )

