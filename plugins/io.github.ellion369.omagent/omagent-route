    try:
        data = json.loads(session_file.read_text("utf-8"))
        if isinstance(data, dict):
            if not data.get("entries") and data.get("history"):
                entries = []
                for turn in data["history"]:
                    role = turn.get("role")
                    parts = turn.get("parts", [{}])
                    txt = parts[0].get("text", "") if parts else ""
