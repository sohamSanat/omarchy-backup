def run_firstmate_bridge(
    request: str,
    config: dict,
    session_id: str,
    fleet_info: dict,
    *,
    harness: str = "",
    model: str = "",
) -> int:
    """Answers user queries and manages fleet operations as Firstmate, the fleet supervisor.
    Has live visibility into all Herdr subagents, panes, and workspace files.
    Dispatches directives, modifications, and steers to the crew in Herdr, and immediately
    briefs the Captain (the user) on the UI without blocking.
    """
    api_key = config.get("gemini_api_key", "").strip()
    raw_cwd = fleet_info.get("cwd") or str(work_dir())
    cwd = Path(raw_cwd)
    pane_id = fleet_info.get("herdrPaneId")
    ws_id = fleet_info.get("herdrWorkspaceId")
    fm_task_id = fleet_info.get("fmTaskId", "crewmate")
    ws_label = fleet_info.get("wsLabel", f"Firstmate: {fm_task_id}")
    clean_req = clean_prefix(request)
    req_lower = clean_req.lower()

    # Track and resolve potential harness or model hot-swap
    catalog = get_harness_catalog()
    stored_harness = (fleet_info or {}).get("harness", "antigravity-agy")
    stored_provider = (fleet_info or {}).get("provider", "agy" if "agy" in stored_harness else "firstmate")
    stored_model = (fleet_info or {}).get("model", "")

    target_harness_key = (harness or stored_provider or "agy").lower().strip()
    if target_harness_key in ("antigravity", "agy"):
        target_harness_key = "agy"
    elif target_harness_key in ("opencode", "open-code"):
        target_harness_key = "opencode"
    elif target_harness_key in ("cline",):
        target_harness_key = "cline"
    else:
        target_harness_key = "agy"

    target_meta = catalog.get(target_harness_key, catalog["agy"])
    target_model = (model or stored_model or target_meta["default_model"]).strip()

    swapped_harness = bool(harness and target_harness_key != stored_provider)
    swapped_model = bool(model and target_model != stored_model and stored_model)
    is_swapped = swapped_harness or swapped_model

    if is_swapped:
        swap_desc = []
        if swapped_harness:
            prev_disp = catalog.get(stored_provider, {}).get("display_name", stored_provider)
            swap_desc.append(f"Harness: **{target_meta['display_name']}** (was {prev_disp})")
        if swapped_model:
            swap_desc.append(f"Model: **{target_model}** (was {stored_model})")
        emit("text", text=f"• **Coding Engine Swapped**: {', '.join(swap_desc)}\n")

        stored_provider = target_harness_key
        stored_model = target_model
        if target_harness_key == "agy":
            stored_harness = "antigravity-agy"
        elif target_harness_key == "opencode":
            stored_harness = "omagent-opencode"
        elif target_harness_key == "cline":
            stored_harness = "omagent-cline"

        fleet_info["provider"] = stored_provider
        fleet_info["model"] = stored_model
        fleet_info["harness"] = stored_harness
        save_session_fleet(session_id, fleet_info)

        if fm_task_id and pane_id and ws_id:
            register_firstmate_task(
                fm_task_id,
                pane_id,
                ws_id,
                cwd,
                harness=stored_provider,
                model=stored_model,
                role="lead-engineer",
                skill="ce-work",
            )
            emit("text", text=f"• **Firstmate Updated**: Lead crewmate metadata updated to `{stored_provider}` / `{stored_model}`\n")

    active_ui_set = get_session_ui_set(session_id) or (fleet_info or {}).get("uiSet")
    if any(k in req_lower for k in ("set 1", "set 2", "set 3", "set 4", "impeccable", "aesthetic style", "saas style", "jaw drop", "switch style", "change style", "full aesthetic")):
        new_set = parse_ui_set_choice(clean_req)
        if new_set in (1, 2, 3, 4) and new_set != active_ui_set:
            active_ui_set = new_set
            save_session_ui_set(session_id, active_ui_set)
            if fleet_info:
                fleet_info["uiSet"] = active_ui_set
                save_session_fleet(session_id, fleet_info)
            set_meta = UI_SKILL_SETS[active_ui_set]
            emit("text", text=f"• **UI Archetype Switched**: Guiding engine updated to Set {active_ui_set} — **{set_meta['name']}**\n")

    emit(
        "agent",
        name="firstmate",
        label=f"Firstmate · Fleet Supervisor ({target_meta['display_name']})",
        session=session_id,
        cwd=str(cwd),
        resume=["omarchy-launch-terminal", "herdr"],
        resumeLabel="Expand in Herdr",
        pid=0,
    )

    if not api_key:
        emit("error", text="Gemini API key is missing. Please add it to ~/.config/omagent/config.json")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    # 1. Collect live multi-agent fleet telemetry
    telemetry = get_fleet_telemetry(ws_id, pane_id)

    # 2. Inspect workspace directory files
    project_files: list[str] = []
    scan_target = cwd if cwd.is_dir() else Path.home() / "Projects"
    if scan_target.is_dir():
        try:
            for item in sorted(scan_target.rglob("*")):
                if item.is_file() and not any(part.startswith((".", "node_modules", ".git", "venv", "__pycache__")) for part in item.parts):
                    try:
                        rel = item.relative_to(scan_target)
                        size = item.stat().st_size
                        project_files.append(f"{rel} ({size} bytes)")
                    except Exception:
                        pass
                if len(project_files) >= 30:
                    break
        except Exception:
            pass

    files_summary = "\n".join(f"- {f}" for f in project_files) if project_files else "No local project files detected yet."

    # 3. Detect if the user's message is an action directive / change / steer / new task
    is_info = any(re.search(p, req_lower, re.IGNORECASE) for p in INFO_QUESTION_PATTERNS)
    has_code_action = any(re.search(p, req_lower, re.IGNORECASE) for p in CODE_ACTION_PATTERNS)
    is_directive = has_code_action or (not is_info and len(clean_req.split()) > 1)

    dispatch_status = "Informational query only — no new modification orders were dispatched to the crew."
    if is_directive and pane_id:
        # Deliver instruction to lead crewmate inbox via Firstmate
        if shutil.which("firstmate") and fm_task_id:
            try:
                fm_send_res = subprocess.run(["firstmate", "send", fm_task_id, clean_req], capture_output=True, text=True, timeout=8)
                if fm_send_res.returncode == 0:
                    emit("text", text=f"• **Firstmate Relayed Directive**: Dispatched modification to crew inbox (`{fm_task_id}`)\n")
            except Exception as e:
                if DEBUG:
                    print(f"Firstmate send error in bridge: {e}", file=sys.stderr)

        # Ring doorbell or re-engage idle agent in the pane
        is_agy = "agy" in stored_harness or "antigravity" in stored_harness or stored_provider == "agy"
        proc_running = False
        try:
            p_res = subprocess.run(["herdr", "pane", "process-info", "--pane", pane_id], capture_output=True, text=True, timeout=2)
            if p_res.returncode == 0:
                p_data = json.loads(p_res.stdout).get("result", {}).get("process_info", {})
                target_proc = "agy" if is_agy else ("opencode" if stored_provider == "opencode" or "opencode" in stored_harness else ("cline" if stored_provider == "cline" or "cline" in stored_harness else "pi"))
                if is_harness_process_running(p_data, target_proc):
                    proc_running = True
        except Exception:
            pass

        doorbell = f"Firstmate instruction waiting: list {FM_STATE_DIR}/{fm_task_id}.inbox/*.msg and, in numeric order, read and act on each, then mv each handled file to {FM_STATE_DIR}/{fm_task_id}.inbox/handled/."

        if is_swapped and proc_running:
            try:
                subprocess.run(["herdr", "pane", "send-keys", pane_id, "C-c"], capture_output=True, text=True, timeout=2)
