def extract_image_visual_profile(img_p: Path) -> dict:
    """Extracts technical visual metrics and color distribution using ImageMagick."""
    w, h, fmt = 1280, 800, "PNG"
    try:
        cmd_id = ["magick", "identify", "-format", "%w|%h|%m", str(img_p)]
        p1 = subprocess.run(cmd_id, capture_output=True, text=True, timeout=5)
        if p1.returncode == 0 and p1.stdout.strip():
            parts = p1.stdout.strip().split("|")
            w = int(parts[0]) if len(parts) > 0 and parts[0].isdigit() else 1280
            h = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 800
            fmt = parts[2] if len(parts) > 2 else "PNG"
    except Exception:
        pass

    ratio = w / max(1, h)
    if ratio >= 1.6:
        aspect = "16:9 / Ultrawide Desktop"
    elif ratio >= 1.2:
        aspect = "4:3 / Presentation Card"
    elif ratio <= 0.7:
        aspect = "9:16 / Mobile Portrait"
    else:
        aspect = "1:1 / Balanced Square"

    colors = []
    total_pixels = 0
    total_luma = 0.0

    try:
        cmd_hist = ["magick", str(img_p), "-resize", "150x150", "-colors", "8", "-format", "%c\n", "histogram:info:"]
        p2 = subprocess.run(cmd_hist, capture_output=True, text=True, timeout=5)
        if p2.returncode == 0:
            for line in p2.stdout.strip().splitlines():
                m = re.search(r":\s*\(.*?\)\s*(#[0-9A-Fa-f]{6,8})", line)
                cnt_m = re.search(r"^\s*(\d+):", line)
                if m:
                    hex_c = m.group(1)[:7].upper()
                    cnt = int(cnt_m.group(1)) if cnt_m else 1
                    total_pixels += cnt
                    r = int(hex_c[1:3], 16)
                    g = int(hex_c[3:5], 16)
                    b = int(hex_c[5:7], 16)
                    luma = 0.2126 * r + 0.7152 * g + 0.0722 * b
                    total_luma += luma * cnt
                    colors.append({"hex": hex_c, "count": cnt, "luma": luma, "r": r, "g": g, "b": b})
    except Exception:
        pass

    if not colors:
        colors = [
            {"hex": "#0A0B0E", "count": 1000, "luma": 10.0, "r": 10, "g": 11, "b": 14},
            {"hex": "#C8A97E", "count": 300, "luma": 160.0, "r": 200, "g": 169, "b": 126},
            {"hex": "#14171F", "count": 200, "luma": 22.0, "r": 20, "g": 23, "b": 31},
            {"hex": "#E6E8EC", "count": 100, "luma": 230.0, "r": 230, "g": 232, "b": 236},
        ]
        total_pixels = 1600
        total_luma = 10.0 * 1000 + 160.0 * 300 + 22.0 * 200 + 230.0 * 100

    avg_luma = (total_luma / max(1, total_pixels)) if total_pixels else 40.0
    is_dark = avg_luma < 128.0
    theme_mode = "Dark Luxury / High Contrast" if is_dark else "Light Clean / High Luminance"

    colors.sort(key=lambda c: c["count"], reverse=True)
    bg_color = colors[0]["hex"]

    accents = [c for c in colors[1:] if abs(c["luma"] - colors[0]["luma"]) > 35]
    accent_color = accents[0]["hex"] if accents else (colors[1]["hex"] if len(colors) > 1 else "#C8A97E")

    return {
        "width": w,
        "height": h,
        "format": fmt,
        "aspect": aspect,
        "is_dark": is_dark,
        "theme_mode": theme_mode,
        "bg_color": bg_color,
        "accent_color": accent_color,
        "top_colors": colors[:5],
    }


