def extract_keywords(prompt: str) -> list[str]:
    stopwords = {"make", "build", "create", "design", "website", "landing", "page", "app", "for", "with", "the", "and", "that", "this", "jaw", "dropping", "aesthetic", "saas", "clean", "best", "good"}
    words = re.findall(r"\b[a-zA-Z]{3,}\b", prompt.lower())
    return [w for w in words if w not in stopwords]


def parse_grill_answers(text: str, questions: list[dict]) -> dict[str, int]:
    t = text.strip().lower()
    results: dict[str, int] = {}
    num_q = len(questions)
    if num_q == 0:
        return results

    # Strategy 1: Explicit question + answer patterns
    # Matches:
    # "question 1 ans: 2", "question 1 ans 2", "q1: 2", "q1 = 2", "q1 - 2"
    # "a: 2", "b: 3", "c: 1", "first: 2", "second: 3"
    explicit_pat = re.compile(
        r"(?:(?:question|q)\s*([1-9]|first|second|third|fourth|fifth|[a-z])|([a-z])\s*[:=-])\s*"
        r"(?:ans(?:wer)?|option|is)?\s*[:=-]?\s*(?:option|opt)?\s*([1-9])",
        re.I
    )

    word_to_idx = {
        "1": 0, "first": 0, "a": 0,
        "2": 1, "second": 1, "b": 1,
        "3": 2, "third": 2, "c": 2,
        "4": 3, "fourth": 3, "d": 3,
        "5": 4, "fifth": 4, "e": 4,
    }

    for m in explicit_pat.finditer(t):
        q_raw = (m.group(1) or m.group(2) or "").lower()
        ans_raw = m.group(3)
        if q_raw in word_to_idx:
            q_idx = word_to_idx[q_raw]
            if q_idx < num_q:
                qid = questions[q_idx]["id"]
                results[qid] = int(ans_raw)

    if len(results) == num_q:
        return results

    # Strategy 1b: Explicit pairs like "1: 2, 2: 3, 3: 2" (question_num : option_num)
    pairs = re.findall(r"\b([1-9])\s*[:=-]\s*([1-9])\b", t)
    if pairs:
        for q_num_str, opt_num_str in pairs:
            q_idx = int(q_num_str) - 1
            if 0 <= q_idx < num_q:
                results[questions[q_idx]["id"]] = int(opt_num_str)
        if len(results) == num_q:
            return results

    # Strategy 2: Strip out "question X" / "qX" prefixes before scanning for bare digits
    # to avoid question indices polluting answer selections
    clean_t = re.sub(r"\b(?:question|q)\s*[1-9]\b", "", t, flags=re.I)
    clean_t = re.sub(r"\b(?:ans(?:wer)?|option|choice)\b", "", clean_t, flags=re.I)

    bare_digits = [int(d) for d in re.findall(r"\b([1-9])\b", clean_t)]
    if bare_digits:
        unanswered = [q for q in questions if q["id"] not in results]
        if len(bare_digits) == len(unanswered):
            for q, d in zip(unanswered, bare_digits):
                results[q["id"]] = d
            return results
        elif len(bare_digits) == num_q and not results:
            for idx in range(num_q):
                results[questions[idx]["id"]] = bare_digits[idx]
            return results
        elif len(bare_digits) == 1 and unanswered:
            results[unanswered[0]["id"]] = bare_digits[0]
            return results

    # Strategy 3: Keyword / title matching against question options
    for q in questions:
        qid = q["id"]
        if qid in results:
            continue
        for opt in q.get("options", []):
            opt_title = opt.get("title", "").lower()
            key_words = [w for w in re.findall(r"\w+", opt_title) if len(w) > 3 and w not in ("with", "from", "that", "this", "pure", "deep", "canvas", "accents")]
            if key_words and sum(1 for w in key_words if w in t) >= min(2, len(key_words)):
                results[qid] = opt["id"]
                break

    return results


