)

CODING_ACTION_VERBS = (
    r"\b(write|code|implement|script|program|develop|debug|fix|refactor|compile|run|benchmark|test|parse|scrape|make|create|build|generate)\b"
)


def is_normal_coding_request(request: str) -> bool:
    """Detects whether a request is a normal/standard coding task (Python, Java, C#, scripts, backend, etc.)
    that must NOT be confused with UI development."""
    req_lower = request.lower().strip()

    # If user explicitly requested a UI Set, it's UI
    if detect_ui_archetype(request) is not None:
        return False

    # Explicit phrases for normal coding
    if re.search(r"\b(python\s+script|java\s+program|c#\s+script|csharp\s+script|bash\s+script|shell\s+script|c\+\+\s+program|rust\s+tool|go\s+service)\b", req_lower):
        return True
    if re.search(r"\b(nor?m[ae]l\s+coding|regular\s+coding|standard\s+coding|backend\s+code|cli\s+tool|console\s+app|terminal\s+tool|script\s+or\s+program)\b", req_lower):
        return True

    has_lang = bool(re.search(CODING_LANGUAGES, req_lower))
    has_target = bool(re.search(NORMAL_CODING_TARGETS, req_lower))
    has_action = bool(re.search(CODING_ACTION_VERBS, req_lower))

    # Language mentioned with target or action:
    if has_lang and (has_target or has_action):
        # Unless it explicitly asks for a UI framework/library like React/Vue/Svelte or landing page
        if not re.search(r"\b(react|vue|svelte|tailwind|landing\s*page|webpage|three\.?js|awwwards|3d\s*scene)\b", req_lower):
            return True

    # Standalone coding target with action without UI framework
    if has_target and has_action and not bool(re.search(UI_FRAMEWORK_TERMS, req_lower)):
        if not re.search(r"\b(landing\s*page|webpage|website|portfolio|hero\s*section|three\.?js|awwwards|3d\s*showcase)\b", req_lower):
            return True

    return False


def is_ui_creation_request(request: str, image_path: str = "") -> bool:
    if is_normal_coding_request(request):
        return False
    if image_path:
        return True
    req_lower = request.lower()
    if detect_ui_archetype(request) is not None:
        return True

    has_ui_target = bool(re.search(UI_TARGET_NOUNS, req_lower))
    has_framework = bool(re.search(UI_FRAMEWORK_TERMS, req_lower))
    has_verb = bool(re.search(UI_CREATION_VERBS, req_lower))
    has_non_ui = bool(re.search(NON_UI_EXCLUSIONS, req_lower))

    if has_non_ui and not has_ui_target:
        return False

    if has_verb and (has_ui_target or (has_framework and any(k in req_lower for k in ("page", "app", "ui", "site")))):
        return True

    if has_ui_target and any(k in req_lower for k in ("landing", "website", "web page", "webpage", "portfolio", "dashboard", "showcase")):
        return True

    return False


def detect_ui_archetype(request: str) -> int | None:
    req_lower = request.lower()

    if re.search(r"\b(set\s*1|skill\s*set\s*1|full\s*aesthetic|linear\s*style|stripe\s*press|swiss\s*style|braun\s*style)\b", req_lower):
        return 1
    if re.search(r"\b(full\s*aesthetic|ultra\s*aesthetic|pure\s*aesthetic)\b", req_lower) or re.search(r"\baesthetic\s+(ui|landing|page|site|website|design)\b", req_lower):
        return 1

    if re.search(r"\b(set\s*2|skill\s*set\s*2|saas\s*archetype|saas\s*app|saas\s*style|enterprise\s*dashboard|b2b\s*saas)\b", req_lower):
        return 2
    if re.search(r"\bsaas\b", req_lower) and any(w in req_lower for w in ("app", "dashboard", "platform", "product", "tool", "portal")):
        return 2

    if re.search(r"\b(set\s*3|skill\s*set\s*3|jaw\s*drop|jaw\s*dropping|jaw\s*droping|3d\s*showcase|awwwards\s*style|threejs\s*world|webgl\s*showcase)\b", req_lower):
        return 3
    if re.search(r"\b(jaw\s*drop|jaw\s*dropping|jaw\s*droping)\b", req_lower):
        return 3

    if re.search(r"\b(set\s*4|skill\s*set\s*4|impeccable|reference\s*fidelity|ref\s*fidelity)\b", req_lower):
        return 4

    return None


def detect_explicit_ui_set_directive(request: str) -> int | None:
    """Only matches explicit commands where the user deliberately specified a UI Set by number or command flag.
    Does NOT match descriptive words (like 'aesthetic', 'saas', 'jaw dropping') so the interactive selection menu is never bypassed."""
    req_lower = request.lower().strip()
    m = re.search(r"(?:^|[/\s])(?:ui[-_]?)?set\s*[:=-]?\s*([1234])\b", req_lower)
    if m:
        return int(m.group(1))
    m2 = re.search(r"^/(?:set|uiset)([1234])\b", req_lower)
    if m2:
        return int(m2.group(1))
    return None


def parse_ui_set_choice(text: str) -> int | None:
    t = text.strip().lower()

    if t in ("1", "1.", "(1)", "[1]", "#1"):
        return 1
    if t in ("2", "2.", "(2)", "[2]", "#2"):
        return 2
    if t in ("3", "3.", "(3)", "[3]", "#3"):
        return 3
    if t in ("4", "4.", "(4)", "[4]", "#4"):
        return 4

    if re.search(r"\b(set\s*1|option\s*1|opt\s*1|first\s*one|first|1st|full\s*aesthetic|aesthetic|linear|stripe|braun|swiss)\b", t):
        if not re.search(r"\b(set\s*[234]|option\s*[234]|saas|jaw\s*drop|impeccable)\b", t):
            return 1

    if re.search(r"\b(set\s*2|option\s*2|opt\s*2|second\s*one|second|2nd|saas|product\s*app|enterprise|dashboard\s*app)\b", t):
        if not re.search(r"\b(set\s*[134]|option\s*[134]|aesthetic|jaw\s*drop|impeccable)\b", t):
            return 2

    if re.search(r"\b(set\s*3|option\s*3|opt\s*3|third\s*one|third|3rd|jaw\s*drop|jaw\s*dropping|jaw\s*droping|3d|awwwards|showcase)\b", t):
        if not re.search(r"\b(set\s*[124]|option\s*[124]|aesthetic|saas|impeccable)\b", t):
            return 3

    if re.search(r"\b(set\s*4|option\s*4|opt\s*4|fourth\s*one|fourth|4th|impeccable|reference\s*fidelity|ref\s*fidelity)\b", t):
        if not re.search(r"\b(set\s*[123]|option\s*[123]|aesthetic|saas|jaw\s*drop)\b", t):
            return 4

    m = re.match(r"^([1234])\b", t)
    if m:
        return int(m.group(1))

    return None


