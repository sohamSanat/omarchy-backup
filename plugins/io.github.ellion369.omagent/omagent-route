def format_time_ago(updated_at_ms: int) -> str:
    now_ms = int(time.time() * 1000)
    diff = max(0, (now_ms - updated_at_ms) // 1000)
    if diff < 60:
        return "Just now"
    if diff < 3600:
        mins = max(1, diff // 60)
        return f"{mins}m ago"
    if diff < 86400:
        hours = diff // 3600
        return f"{hours}h ago"
    if diff < 86400 * 2:
        return "Yesterday"
    if diff < 86400 * 7:
        days = diff // 86400
        return f"{days}d ago"
    return time.strftime("%b %d", time.localtime(updated_at_ms / 1000))


def clean_preview_text(text: str) -> str:
    s = re.sub(r"```[\s\S]*?```", "", text)
    s = re.sub(r"`[^`]*`", "", s)
    s = re.sub(r"[#*_\-•]", " ", s)
    s = re.sub(r"\[([^\]]+)\]\([^\)]+\)", r"\1", s)
    return clip(" ".join(s.split()), 90)


def _extract_history_from_entries(entries: list) -> list[dict]:
    """Reconstructs conversation history from visual UI rows, stripping out status boilerplate."""
    hist: list[dict] = []
    for item in entries:
        kind = item.get("rowKind")
        text = item.get("rowText", "").strip()
        if not text:
            continue
        if kind == "you":
            if hist and hist[-1]["role"] == "user":
                hist[-1]["parts"][0]["text"] += "\n" + text
            else:
                hist.append({"role": "user", "parts": [{"text": text}]})
        elif kind == "text":
            # Filter out status bullet points and terminal hints
            lines = [
                l for l in text.split("\n")
                if not l.strip().startswith("• **")
                and not l.strip().startswith("*Press Ctrl+")
                and "Expand in Herdr" not in l
            ]
            clean = "\n".join(lines).strip()
            if not clean:
                continue
            if hist and hist[-1]["role"] == "model":
                hist[-1]["parts"][0]["text"] += "\n" + clean
            elif hist and hist[-1]["role"] == "user":
                hist.append({"role": "model", "parts": [{"text": clean}]})
    return hist


def load_session_history(session_id: str) -> list[dict]:
    """Loads past conversation turns for session_id from session storage or last.json."""
    if not session_id:
        return []

    # 1. Try dedicated history file first (.history.json is immune to QML debounce overwrites)
    history_file = SESSION_DIR / f"{session_id}.history.json"
    if history_file.is_file():
        try:
            data = json.loads(history_file.read_text("utf-8"))
            if isinstance(data, list) and len(data) > 0:
                return data
        except Exception as e:
            if DEBUG:
                print(f"Error reading history file {history_file}: {e}", file=sys.stderr)

    # 2. Try dedicated session file
    session_file = SESSION_DIR / f"{session_id}.json"
    if session_file.is_file():
        try:
            data = json.loads(session_file.read_text("utf-8"))
            if isinstance(data, list) and len(data) > 0:
                return data
            if isinstance(data, dict):
                if "history" in data and isinstance(data["history"], list) and len(data["history"]) > 0:
                    return data["history"]
                if "entries" in data and isinstance(data["entries"], list):
                    return _extract_history_from_entries(data["entries"])
        except Exception as e:
            if DEBUG:
                print(f"Error reading session file {session_file}: {e}", file=sys.stderr)

    # 3. Try last.json fallback
    last_file = STATE_DIR / "last.json"
    if last_file.is_file():
        try:
            state = json.loads(last_file.read_text("utf-8"))
            if state.get("sessionId") == session_id and "entries" in state:
                return _extract_history_from_entries(state.get("entries", []))
        except Exception as e:
            if DEBUG:
                print(f"Error reading last.json: {e}", file=sys.stderr)

    return []


def build_conversation_contents(history: list[dict], current_user_text: str) -> list[dict]:
    """Constructs alternating user/model turns for Gemini API with current prompt."""
    clean_req = current_user_text.strip()
    contents: list[dict] = []
    for turn in history:
        role = turn.get("role")
        parts = turn.get("parts", [])
        if role in ("user", "model") and parts and parts[0].get("text"):
            contents.append({
                "role": role,
                "parts": [{"text": parts[0]["text"]}]
            })

    if contents and contents[-1]["role"] == "user":
        if contents[-1]["parts"][0]["text"].strip() != clean_req:
            contents[-1]["parts"][0]["text"] = clean_req
    else:
        contents.append({"role": "user", "parts": [{"text": clean_req}]})

    while contents and contents[0]["role"] != "user":
        contents.pop(0)

    sanitized: list[dict] = []
    for turn in contents:
        if sanitized and sanitized[-1]["role"] == turn["role"]:
            sanitized[-1]["parts"][0]["text"] += "\n" + turn["parts"][0]["text"]
        else:
            sanitized.append(turn)

    if len(sanitized) > 16:
        sanitized = sanitized[-16:]
        while sanitized and sanitized[0]["role"] != "user":
            sanitized.pop(0)

    return sanitized


def save_session_history(session_id: str, contents: list[dict], model_response: str) -> None:
    """Persists updated conversation turns to session file and dedicated history file."""
    if not session_id or not model_response.strip():
        return
    updated = list(contents)
    if not (updated and updated[-1].get("role") == "model" and updated[-1].get("parts", [{}])[0].get("text") == model_response.strip()):
        updated.append({"role": "model", "parts": [{"text": model_response.strip()}]})

    try:
        SESSION_DIR.mkdir(parents=True, exist_ok=True)

        # 1. Dedicated history file (.history.json) - completely safe from QML debounce overwrites
        history_file = SESSION_DIR / f"{session_id}.history.json"
        history_file.write_text(json.dumps(updated, indent=2), "utf-8")

        # 2. Main session file (.json) - synced with QML state
        session_file = SESSION_DIR / f"{session_id}.json"
        data = {}
        if session_file.is_file():
            try:
                parsed = json.loads(session_file.read_text("utf-8"))
                if isinstance(parsed, dict):
                    data = parsed
            except Exception:
                data = {}

        data["sessionId"] = session_id
        data["history"] = updated
        data["updatedAt"] = int(time.time() * 1000)

        # Sync entries and metadata from last.json if active
        last_file = STATE_DIR / "last.json"
        if last_file.is_file():
            try:
                last_data = json.loads(last_file.read_text("utf-8"))
                if last_data.get("sessionId") == session_id:
                    for k in ("entries", "agentName", "agentLabel", "agentCwd", "resumeLabel", "resumeArgv", "title", "priorTokens", "priorCost", "sawCost", "elapsedMs"):
                        if k in last_data and last_data[k] is not None:
                            data[k] = last_data[k]
            except Exception:
                pass

        if "title" not in data or not data["title"]:
            for turn in updated:
                if turn.get("role") == "user" and turn.get("parts"):
                    data["title"] = clip(turn["parts"][0].get("text", ""), 80, collapse=True)
                    break

        session_file.write_text(json.dumps(data, indent=2), "utf-8")
    except Exception as e:
        if DEBUG:
            print(f"Error saving session history for {session_id}: {e}", file=sys.stderr)


