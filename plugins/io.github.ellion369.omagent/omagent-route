def resolve_agy_session_file(pane_id: str | None, launch_time: float) -> Path | None:
    """Finds the transcript file strictly belonging to the session launched in pane_id after launch_time."""
    # 1. Try Herdr pane native agent_session
    if pane_id:
        try:
            p_get = subprocess.run(["herdr", "pane", "get", pane_id], capture_output=True, text=True, timeout=2)
            if p_get.returncode == 0:
                p_info = json.loads(p_get.stdout).get("result", {}).get("pane", {})
                sess_val = p_info.get("agent_session", {}).get("value")
                if sess_val:
                    cand = Path.home() / f".gemini/antigravity-cli/brain/{sess_val}/.system_generated/logs/transcript.jsonl"
                    if cand.is_file():
                        return cand
        except Exception:
            pass

    # 2. Search brain directories created or modified strictly after launch_time - 3.0
    brain_dir = Path.home() / ".gemini/antigravity-cli/brain"
    if not brain_dir.is_dir():
        return None
    candidates = []
    try:
        for d in brain_dir.iterdir():
            if not d.is_dir() or d.name.startswith("."):
                continue
            try:
                st = d.stat()
                if st.st_ctime >= launch_time - 3.0 or st.st_mtime >= launch_time - 3.0:
                    t_file = d / ".system_generated/logs/transcript.jsonl"
                    if t_file.is_file():
                        candidates.append((t_file.stat().st_mtime, t_file))
            except Exception:
                continue
    except Exception:
        pass

    if candidates:
        candidates.sort(key=lambda x: x[0], reverse=True)
        return candidates[0][1]

    return None


def slugify_task(task_prompt: str) -> str:
    """Derives a clean, readable folder slug from a task prompt."""
    p = clean_prefix(task_prompt).lower()
    m = re.search(r'(?:called|named|project|app|folder)\s+["\']?([a-zA-Z0-9_-]{3,24})["\']?', p)
    if m:
        return m.group(1).lower()
    stop = {
        "make", "the", "a", "an", "for", "my", "in", "state", "of", "and", "we", "got",
        "as", "well", "ui", "create", "build", "design", "page", "website", "webpage",
        "site", "app", "dashboard", "want", "you", "to", "with", "from", "using", "like", "our"
    }
    words = [w for w in re.findall(r'[a-zA-Z0-9]+', p) if w not in stop and len(w) > 1]
    if words:
        slug = "-".join(words[:4])
        return slug[:32].strip("-")
    return f"project-{int(time.time()) % 10000}"


def resolve_project_cwd(task_prompt: str, config: dict) -> Path:
    """Ensures each project is isolated in its own dedicated subfolder under ~/Projects."""
    base_dir = work_dir()
    slug = slugify_task(task_prompt)
    target = base_dir / slug
    if target.is_dir() and any(target.iterdir()):
        suffix = 1
        cand = base_dir / f"{slug}-{suffix}"
        while cand.is_dir() and any(cand.iterdir()):
            suffix += 1
            cand = base_dir / f"{slug}-{suffix}"
        target = cand
    target.mkdir(parents=True, exist_ok=True)
    return target


def prune_stale_herdr_workspaces(keep_ws_id: str | None = None) -> list[str]:
    """Closes prior AI agent workspaces in Herdr to prevent zombie processes and cross-talk."""
    closed = []
    try:
        res = subprocess.run(["herdr", "workspace", "list"], capture_output=True, text=True, timeout=3)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            workspaces = data.get("result", {}).get("workspaces", [])
            for ws in workspaces:
                ws_id = ws.get("workspace_id")
                label = ws.get("label", "")
                num = ws.get("number", 0)
                if ws_id in ("w1", keep_ws_id) or num == 1:
                    continue
                if any(label.startswith(pfx) for pfx in ("AGY:", "Pi:", "Firstmate:", "FAIL:", "omagent:")) or ws.get("agent_status") in ("idle", "done", "unknown"):
                    subprocess.run(["herdr", "workspace", "close", ws_id], capture_output=True, text=True, timeout=3)
                    closed.append(ws_id)
    except Exception as e:
        if DEBUG:
            print(f"Error pruning stale Herdr workspaces: {e}", file=sys.stderr)
    return closed


def prune_stale_firstmate_tasks() -> list[str]:
    """Prunes dead Firstmate .meta and .inbox directories whose Herdr panes no longer exist."""
    pruned = []
    if not FM_STATE_DIR.is_dir():
        return pruned
    for meta_file in list(FM_STATE_DIR.glob("*.meta")):
        try:
            lines = meta_file.read_text("utf-8", errors="ignore").splitlines()
            pane = ""
            for l in lines:
                if l.startswith("herdr_pane_id="):
                    pane = l.split("=", 1)[1].strip()
                    break
            is_dead = False
            if pane:
                chk = subprocess.run(["herdr", "pane", "get", pane], capture_output=True, text=True, timeout=2)
                if chk.returncode != 0:
                    is_dead = True
            else:
                is_dead = True

            if is_dead:
                meta_file.unlink(missing_ok=True)
                task_name = meta_file.stem
                inbox = FM_STATE_DIR / f"{task_name}.inbox"
                if inbox.is_dir():
                    shutil.rmtree(inbox, ignore_errors=True)
                pruned.append(task_name)
        except Exception:
            pass
    return pruned


def is_new_project_directive(request: str) -> bool:
    """Checks if request is explicitly launching a new project rather than a minor steer to an existing fleet."""
    req_lower = request.lower().strip()
    if any(req_lower.startswith(pfx) for pfx in ("/new", "/code", "new:", "create project", "new project")):
        return True
    if is_ui_creation_request(request):
        creation_starters = (
            "make the ui", "build the ui", "create the ui", "design the ui",
            "make a website", "build a website", "create a website",
            "make a landing page", "build a landing page", "create a landing page",
            "make a web page", "build a web page", "create a web page",
            "make an app", "build an app", "create an app"
        )
        if any(req_lower.startswith(s) or f" {s}" in req_lower for s in creation_starters):
            return True
    return False


