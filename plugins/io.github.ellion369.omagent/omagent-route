    # Monitor Pi execution in Herdr and emit clean live highlights
    start_monitor = time.time()
    seen_actions: set[str] = set()
    read_offset = 0
    active_session_file = None

    time.sleep(0.8)

    while time.time() - start_monitor < 25.0:
