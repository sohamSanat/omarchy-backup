def build_model_handoff_brief(
    old_harness: str,
    old_model: str,
    error_text: str,
    cwd: Path,
    original_request: str,
    ui_set: int | None = None,
    pane_id: str | None = None,
) -> str:
    """Builds an exhaustive, structured continuity handoff brief for the target model."""
    git_status = ""
    git_diff = ""
    try:
        p_stat = subprocess.run(["git", "status", "--porcelain"], cwd=str(cwd), capture_output=True, text=True, timeout=3)
        if p_stat.returncode == 0:
            git_status = p_stat.stdout.strip()
        p_diff = subprocess.run(["git", "diff", "--stat", "HEAD"], cwd=str(cwd), capture_output=True, text=True, timeout=3)
        if p_diff.returncode == 0:
            git_diff = p_diff.stdout.strip()
    except Exception:
        pass

    pane_tail = ""
    if pane_id:
        try:
            p_tail = subprocess.run(
                ["herdr", "pane", "read", pane_id, "--source", "recent-unwrapped", "--lines", "60", "--format", "text"],
                capture_output=True, text=True, timeout=4,
            )
            if p_tail.returncode == 0 and p_tail.stdout.strip():
                pane_tail = p_tail.stdout.strip()
        except Exception:
            pass

    ui_note = ""
    if ui_set and ui_set in UI_SKILL_SETS:
        ui_meta = UI_SKILL_SETS[ui_set]
        ui_note = (
            f"\n[ACTIVE UI ARCHETYPE: SET {ui_set} — {ui_meta.get('name', 'UI Set')}]\n"
            f"- Guiding Skill: {ui_meta.get('primary_skill')}\n"
            f"- Animation System: {ui_meta.get('path')}/Animations-skills/skills/\n"
            f"- Precedence: UI skills completely override generic code styling. Enforce two phases (build DOM first, then animate).\n"
        )

    clean_err = error_text.strip()
    if len(clean_err) > 400:
        clean_err = clean_err[-400:]

    handoff = (
        f"[SYSTEM CONTINUITY HANDOFF BRIEF: SEAMLESS TRANSITION FROM {old_harness.upper()} ({old_model})]\n"
        f"You are taking over an active engineering mission in `{cwd}`. The prior agent ({old_harness} with model {old_model}) "
        f"encountered a runtime error and has handed off execution to you:\n"
        f"```text\n{clean_err}\n```\n"
        f"{ui_note}\n"
        f"ORIGINAL USER TASK & GOAL:\n"
        f"{original_request}\n\n"
        f"CODEBASE AUDIT AT HANDOFF:\n"
    )

    if git_status:
        handoff += f"Files Modified/Created by previous agent:\n```text\n{git_status}\n```\n"
    else:
        handoff += "Files Modified: Inspect working tree directly.\n"

    if git_diff:
        handoff += f"Git Diff Summary:\n```text\n{git_diff}\n```\n"

    if pane_tail:
        handoff += f"Terminal Output Excerpt Before Interruption:\n```text\n{pane_tail[-1000:]}\n```\n"

    handoff += (
        f"\nCRITICAL HANDOFF EXECUTION DIRECTIVES:\n"
        f"1. DO NOT RESTART FROM SCRATCH. Significant work and files have already been created in `{cwd}`.\n"
        f"2. Inspect the modified files and terminal logs above to verify what was already implemented.\n"
        f"3. Bypass, resolve, or recover from the error that blocked the prior model.\n"
        f"4. Seamlessly pick up and complete all remaining requirements of the original user request.\n"
        f"5. Verify all deliverables locally (syntax, tests, screenshots if UI).\n"
    )

    return handoff


def emit_model_switch_prompt(
    session_id: str,
    original_request: str,
    task_prompt: str,
    current_harness: str,
    current_model: str,
    error_text: str,
    pane_id: str,
    ws_id: str,
