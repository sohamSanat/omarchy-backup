def work_dir() -> Path:
    cfg = load_config()
    if cfg.get("work_dir"):
        p = Path(cfg["work_dir"]).expanduser().resolve()
        if p.is_dir():
            return p
    try:
        cur = Path.cwd().resolve()
        if cur != Path.home() and cur.is_dir():
            return cur
    except Exception:
        pass
    for candidate in [Path.home() / "Projects", Path.home() / "Work", Path.home() / "src"]:
        if candidate.is_dir():
