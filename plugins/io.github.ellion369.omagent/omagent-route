def route_request(raw_request: str, *, session: str = "", agent: str = "", mode: str = "", harness: str = "", model: str = "", image_path: str = "", track: str = "") -> int:
    extend_path()
    config = load_config()

    if len(raw_request) > MAX_REQUEST_CHARS:
        emit("error", text=f"Requests are limited to {MAX_REQUEST_CHARS} characters")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    request = raw_request.strip()
    if not request:
        emit("error", text="Request is empty")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    track_clean = (track or "").lower().strip()

    # Extract image path if embedded in prompt and not explicitly passed via flag
    if not image_path:
        img_match = re.search(r'\[(?:image|img|ref):\s*([^\s\]]+)\]', raw_request, flags=re.I)
        if img_match and os.path.exists(img_match.group(1)):
            image_path = img_match.group(1)

    session_id = session or str(uuid.uuid4())
    pending_switch = get_pending_model_switch(session_id)
    if pending_switch:
        return handle_pending_model_switch(session_id, request, pending_switch, config)

    pending_grill = get_pending_grill_me(session_id)
    if pending_grill:
        return handle_pending_grill_me(session_id, request, pending_grill, config, harness=harness, model=model)

    if request.lower().startswith(("/grill ", "/grill-me ", "grill: ", "grill-me: ")):
        cleaned_grill_req = re.sub(r"^/(?:grill|grill-me)\s*|^grill(?:-me)?:\s*", "", request, flags=re.I).strip()
        if not cleaned_grill_req:
            cleaned_grill_req = "Bespoke Web Application"
        return route_ui_creation_request(session_id, cleaned_grill_req, config, harness=harness, model=model, image_path=image_path)

    pending_ui = get_pending_ui_question(session_id)
    fleet_info = get_session_fleet(session_id)

    # 1. Check if user is replying to a pending UI Archetype selection
    if pending_ui:
        if track_clean == "coding" or is_normal_coding_request(request):
            clear_pending_ui_question(session_id)
            return run_lane_coding(request, config, session_id, harness=harness, model=model, is_coding_task=True)

        # If user attached an image during this turn, bypass archetype choice and switch directly to Set 4 (impeccable)
        if image_path and Path(image_path).expanduser().is_file():
            clear_pending_ui_question(session_id)
            save_session_ui_set(session_id, 4)
            orig_req = pending_ui.get("original_request", request)
            saved_harness = harness or pending_ui.get("harness", "")
            saved_model = model or pending_ui.get("model", "")
            return start_grill_me_session(
                session_id,
                orig_req,
                ui_set=4,
                harness=saved_harness,
                model=saved_model,
                config=config,
                image_path=image_path,
            )

        choice = parse_ui_set_choice(request)
        if choice in (1, 2, 3, 4):
            clear_pending_ui_question(session_id)
            save_session_ui_set(session_id, choice)
            orig_req = pending_ui.get("original_request", request)
            saved_harness = harness or pending_ui.get("harness", "")
            saved_model = model or pending_ui.get("model", "")
            saved_image = pending_ui.get("image_path") or image_path

            # Record choice turn into conversation history so chat displays the selection
            hist = load_session_history(session_id)
            hist_to_save = list(hist)
            hist_to_save.append({"role": "user", "parts": [{"text": request}]})
            set_meta = UI_SKILL_SETS[choice]
            save_session_history(session_id, hist_to_save, f"Selected UI Archetype: Set {choice} — {set_meta['name']}")

            return start_grill_me_session(session_id, orig_req, ui_set=choice, harness=saved_harness, model=saved_model, config=config, image_path=saved_image)
        elif request.lower().strip() in ("cancel", "exit", "abort", "quit", "stop"):
            clear_pending_ui_question(session_id)
            emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
            emit("text", text="UI design selection cancelled. Let me know what you'd like to work on instead!")
            emit("done", ok=True, code=0, stopped=False)
            return 0
        else:
            # Re-prompt user cleanly to pick 1, 2, or 3
            emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
            emit(
                "text",
                text=(
                    f"Please choose which design archetype to guide your UI:\n\n"
                    f"- **1**: Full Aesthetic (`Set 1`) — Linear / Stripe Press craft\n"
                    f"- **2**: SaaS / Product App (`Set 2`) — High-density dashboards & design systems\n"
                    f"- **3**: Jaw-Dropping / 3D Showcase (`Set 3`) — Awwwards 3D WebGL & kinetic motion\n\n"
                    f"👉 Reply with **1**, **2**, or **3** in this chat box, or type **cancel** to abort."
                ),
            )
            emit("done", ok=True, code=0, stopped=False)
            return 0

    mode_clean = (mode or "").lower().strip()

    # Manual mode overrides:
    # 1. Mode: 'regular' -> Direct internal knowledge (Lane 1)
    if mode_clean == "regular":
        if request.lower().startswith(("/web ", "web: ", "/search ", "search: ", "@web ")):
            return run_lane_web(request, config, session_id)
        if request.lower().startswith(("/code ", "code: ", "@code ", "@dev ")):
            return run_lane_coding(request, config, session_id, harness=harness, model=model)
        return run_lane_general(request, config, session_id)

    # 2. Mode: 'internet' -> Live web search (Lane 2)
    elif mode_clean == "internet":
        if request.lower().startswith(("/ask ", "ask: ", "@ask ")):
            return run_lane_general(request, config, session_id)
        if request.lower().startswith(("/code ", "code: ", "@code ", "@dev ")):
            return run_lane_coding(request, config, session_id, harness=harness, model=model)
        return run_lane_web(request, config, session_id)

    # 3. Mode: 'agentic' -> Trigger Lane 3 robust coding mechanism
    elif mode_clean == "agentic":
        if request.lower().startswith(("/ask ", "ask: ", "@ask ")):
            return run_lane_general(request, config, session_id)
        if request.lower().startswith(("/web ", "web: ", "/search ", "search: ", "@web ")):
            return run_lane_web(request, config, session_id)

        if fleet_info and is_new_project_directive(request):
            clear_session_fleet(session_id)
            clear_session_ui_set(session_id)
            fleet_info = None

        # Manual Track Selection Overrides
        if track_clean == "coding":
            if fleet_info:
                clear_session_fleet(session_id)
                clear_session_ui_set(session_id)
                fleet_info = None
            return run_lane_coding(request, config, session_id, harness=harness, model=model, is_coding_task=True)

        if track_clean == "ui":
            if fleet_info and not fleet_info.get("uiSet"):
                clear_session_fleet(session_id)
                clear_session_ui_set(session_id)
                fleet_info = None
            return route_ui_creation_request(session_id, request, config, harness=harness, model=model, image_path=image_path)

        if is_normal_coding_request(request):
            if fleet_info:
                clear_session_fleet(session_id)
                clear_session_ui_set(session_id)
                fleet_info = None
            return run_lane_coding(request, config, session_id, harness=harness, model=model, is_coding_task=True)

        if fleet_info:
            return run_firstmate_bridge(request, config, session_id, fleet_info, harness=harness, model=model)

        if is_ui_creation_request(request, image_path=image_path):
            return route_ui_creation_request(session_id, request, config, harness=harness, model=model, image_path=image_path)
        return run_lane_coding(request, config, session_id, harness=harness, model=model)

    # Default: Automatic intent classification fallback
    if fleet_info and is_new_project_directive(request):
        clear_session_fleet(session_id)
        clear_session_ui_set(session_id)
        fleet_info = None

    if track_clean == "coding" or is_normal_coding_request(request):
        if fleet_info:
            clear_session_fleet(session_id)
            clear_session_ui_set(session_id)
            fleet_info = None
        return run_lane_coding(request, config, session_id, harness=harness, model=model, is_coding_task=True)

    if track_clean == "ui":
        if fleet_info and not fleet_info.get("uiSet"):
            clear_session_fleet(session_id)
            clear_session_ui_set(session_id)
            fleet_info = None
        return route_ui_creation_request(session_id, request, config, harness=harness, model=model, image_path=image_path)

    if fleet_info:
        # Check if user explicitly requested web search
        if request.lower().startswith(("/web ", "web: ", "/search ", "search: ", "@web ")):
            return run_lane_web(request, config, session_id)
        # Check if user explicitly asked general question with /ask
        if request.lower().startswith(("/ask ", "ask: ", "@ask ")):
            return run_lane_general(request, config, session_id)

        # In a coding session with an existing fleet, ALL follow-ups, changes, steers,
        # and questions go through Firstmate as the bridge supervisor!
        return run_firstmate_bridge(request, config, session_id, fleet_info, harness=harness, model=model)

    lane = classify_intent(request, prior_agent=agent)

    if lane == LANE_CODE or image_path:
        if is_ui_creation_request(request, image_path=image_path):
            return route_ui_creation_request(session_id, request, config, harness=harness, model=model, image_path=image_path)
        return run_lane_coding(request, config, session_id, harness=harness, model=model)
    elif lane == LANE_WEB:
        return run_lane_web(request, config, session_id)
    else:
        if is_ui_creation_request(request, image_path=image_path):
            return route_ui_creation_request(session_id, request, config, harness=harness, model=model, image_path=image_path)
        return run_lane_general(request, config, session_id)


def main() -> int:
    arguments = sys.argv[1:]
    if not arguments:
        print("Usage: omagent-route [--list-harnesses | --list-sessions | --get-session ID | --save-session ID | --delete-session ID | --clear-history | [--auto] [--mode regular|internet|agentic] [--track ui|coding] [--harness agy|opencode|cline] [--model MODEL] [--image PATH] [--agent SLUG --session ID] <request>]", file=sys.stderr)
        return 2

    if arguments[0] == "--list-harnesses":
        return cmd_list_harnesses()

    # CLI actions for session history
    if arguments[0] == "--list-sessions":
        return cmd_list_sessions()
    if arguments[0] == "--get-session" and len(arguments) > 1:
        return cmd_get_session(arguments[1])
    if arguments[0] == "--save-session" and len(arguments) > 1:
        return cmd_save_session(arguments[1])
    if arguments[0] == "--delete-session" and len(arguments) > 1:
        return cmd_delete_session(arguments[1])
    if arguments[0] == "--clear-history":
        return cmd_clear_history()
    if arguments[0] == "--deconstruct-ref" and len(arguments) > 3:
        sid = arguments[1]
        img_p = arguments[2]
        user_req = arguments[3]
        domain = detect_project_domain(user_req)
        res = deconstruct_reference_image(img_p, user_req, domain, ui_set=0)
        if res:
            SESSION_DIR.mkdir(parents=True, exist_ok=True)
            (SESSION_DIR / f"{sid}.ref_analysis.json").write_text(json.dumps(res, indent=2), "utf-8")
        return 0

    session = ""
    agent = ""
    auto = False
    mode = ""
    track = ""
    harness = ""
    model = ""
    image_path = ""

    while arguments and arguments[0].startswith("--"):
        option = arguments.pop(0)
        if option == "--":
            break
        elif option == "--agent" and arguments:
            agent = arguments.pop(0)
        elif option == "--session" and arguments:
            session = arguments.pop(0)
        elif option == "--mode" and arguments:
            mode = arguments.pop(0)
        elif option in ("--track", "--task-type") and arguments:
            track = arguments.pop(0).lower().strip()
        elif option == "--harness" and arguments:
            harness = arguments.pop(0)
        elif option == "--model" and arguments:
            model = arguments.pop(0)
        elif option in ("--image", "--ref-image", "--image-path") and arguments:
            image_path = arguments.pop(0)
        elif option == "--auto":
            auto = True
        else:
            print(f"Unknown option: {option}", file=sys.stderr)
            return 2

    if len(arguments) != 1 or not arguments[0].strip():
        print("Usage: omagent-route [--auto] [--mode regular|internet|agentic] [--track ui|coding] [--harness agy|opencode|cline] [--model MODEL] [--image PATH] [--agent SLUG --session ID] <request>", file=sys.stderr)
        return 2

    return route_request(arguments[0], session=session, agent=agent, mode=mode, harness=harness, model=model, image_path=image_path, track=track)


if __name__ == "__main__":
    raise SystemExit(main())
