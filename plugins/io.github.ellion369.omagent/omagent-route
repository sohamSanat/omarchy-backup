        system_instruction=firstmate_system,
    )

    if not ok:
        emit("error", text=err)
        emit("done", ok=False, code=1, stopped=False)
        return 1

    save_session_history(session_id, contents, full_text)
    emit("done", ok=True, code=0, stopped=False)
    return 0


def run_lane_coding(request: str, config: dict, session_id: str, ui_set: int | None = None, *, harness: str = "", model: str = "", is_coding_task: bool = False) -> int:
