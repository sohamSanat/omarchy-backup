            pass

    crew_list = []
    terminal_snippets = []
    any_working = False
    all_idle = True if agents else False

    for a in agents:
        name = a.get("name") or a.get("agent") or "crewmate"
        status = a.get("agent_status") or "unknown"
        pane = a.get("pane_id") or primary_pane_id or "unknown"
        meta = meta_map.get(pane, {})
        role = meta.get("role", "lead-engineer" if pane == primary_pane_id else "subagent")
        skill = meta.get("skill", "ce-work")

        if status == "working":
            any_working = True
            all_idle = False
        elif status not in ("idle", "done"):
            all_idle = False

        crew_list.append({
            "name": name,
            "role": role,
            "skill": skill,
            "status": status,
            "pane_id": pane,
        })

        out = ""
        try:
            r = subprocess.run(["herdr", "agent", "read", name, "--source", "recent-unwrapped", "--lines", "25"], capture_output=True, text=True, timeout=2)
            if r.returncode == 0 and r.stdout.strip():
                out = r.stdout.strip()
        except Exception:
            pass
        if not out and pane:
            try:
                r2 = subprocess.run(["herdr", "pane", "read", pane, "--lines", "25"], capture_output=True, text=True, timeout=2)
                if r2.returncode == 0 and r2.stdout.strip():
                    out = r2.stdout.strip()
            except Exception:
                pass
        if out:
            terminal_snippets.append(f"[{name} (Role: {role}, Skill: {skill}, Status: {status}) in Pane {pane}]:\n{out[-1200:]}")

    crew_rows = []
    for c in crew_list:
        crew_rows.append(f"- {c['name']} (Role: {c['role']}, Skill: {c['skill']}, Status: {c['status'].upper()}, Pane: {c['pane_id']})")
    crew_table = "\n".join(crew_rows) if crew_rows else "- No active crewmates currently found."

    return {
        "agents": crew_list,
        "crew_table": crew_table,
        "any_working": any_working,
        "all_idle": all_idle,
        "terminal_snippets": "\n\n".join(terminal_snippets) if terminal_snippets else "No recent terminal activity captured.",
    }


