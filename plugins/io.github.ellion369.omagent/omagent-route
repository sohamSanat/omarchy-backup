def clip(text: str, limit: int, *, collapse: bool = False) -> str:
    text = " ".join(str(text).split()) if collapse else str(text).strip()
    return text if len(text) <= limit else text[: limit - 1] + "…"


def short_path(value: object) -> str:
    text = str(value or "").strip()
    home = str(Path.home())
    if text.startswith(home + "/"):
        text = "~" + text[len(home):]
    return text.rsplit("/", 1)[-1] if len(text) > 40 else text


