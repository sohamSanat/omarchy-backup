def run_firstmate_bridge(
    request: str,
    config: dict,
    session_id: str,
    fleet_info: dict,
    *,
    harness: str = "",
    model: str = "",
) -> int:
    """Answers user queries and manages fleet operations as Firstmate, the fleet supervisor.
    Has live visibility into all Herdr subagents, panes, and workspace files.
    Dispatches directives, modifications, and steers to the crew in Herdr, and immediately
    briefs the Captain (the user) on the UI without blocking.
    """
    api_key = config.get("gemini_api_key", "").strip()
    raw_cwd = fleet_info.get("cwd") or str(work_dir())
    cwd = Path(raw_cwd)
    pane_id = fleet_info.get("herdrPaneId")
    ws_id = fleet_info.get("herdrWorkspaceId")
    fm_task_id = fleet_info.get("fmTaskId", "crewmate")
    ws_label = fleet_info.get("wsLabel", f"Firstmate: {fm_task_id}")
    clean_req = clean_prefix(request)
    req_lower = clean_req.lower()

    # Track and resolve potential harness or model hot-swap
    catalog = get_harness_catalog()
    stored_harness = (fleet_info or {}).get("harness", "antigravity-agy")
    stored_provider = (fleet_info or {}).get("provider", "agy" if "agy" in stored_harness else "firstmate")
    stored_model = (fleet_info or {}).get("model", "")

    target_harness_key = (harness or stored_provider or "agy").lower().strip()
    if target_harness_key in ("antigravity", "agy"):
        target_harness_key = "agy"
    elif target_harness_key in ("opencode", "open-code"):
        target_harness_key = "opencode"
    elif target_harness_key in ("cline",):
        target_harness_key = "cline"
    else:
        target_harness_key = "agy"

    target_meta = catalog.get(target_harness_key, catalog["agy"])
    target_model = (model or stored_model or target_meta["default_model"]).strip()

    swapped_harness = bool(harness and target_harness_key != stored_provider)
    swapped_model = bool(model and target_model != stored_model and stored_model)
    is_swapped = swapped_harness or swapped_model

    if is_swapped:
        swap_desc = []
        if swapped_harness:
            prev_disp = catalog.get(stored_provider, {}).get("display_name", stored_provider)
            swap_desc.append(f"Harness: **{target_meta['display_name']}** (was {prev_disp})")
        if swapped_model:
            swap_desc.append(f"Model: **{target_model}** (was {stored_model})")
        emit("text", text=f"• **Coding Engine Swapped**: {', '.join(swap_desc)}\n")

        stored_provider = target_harness_key
        stored_model = target_model
        if target_harness_key == "agy":
            stored_harness = "antigravity-agy"
        elif target_harness_key == "opencode":
            stored_harness = "omagent-opencode"
        elif target_harness_key == "cline":
            stored_harness = "omagent-cline"

        fleet_info["provider"] = stored_provider
        fleet_info["model"] = stored_model
        fleet_info["harness"] = stored_harness
        save_session_fleet(session_id, fleet_info)

        if fm_task_id and pane_id and ws_id:
            register_firstmate_task(
                fm_task_id,
                pane_id,
                ws_id,
                cwd,
                harness=stored_provider,
                model=stored_model,
                role="lead-engineer",
                skill="ce-work",
            )
            emit("text", text=f"• **Firstmate Updated**: Lead crewmate metadata updated to `{stored_provider}` / `{stored_model}`\n")

    active_ui_set = get_session_ui_set(session_id) or (fleet_info or {}).get("uiSet")
    if any(k in req_lower for k in ("set 1", "set 2", "set 3", "aesthetic style", "saas style", "jaw drop", "switch style", "change style", "full aesthetic")):
        new_set = parse_ui_set_choice(clean_req)
        if new_set in (1, 2, 3) and new_set != active_ui_set:
            active_ui_set = new_set
            save_session_ui_set(session_id, active_ui_set)
            if fleet_info:
                fleet_info["uiSet"] = active_ui_set
                save_session_fleet(session_id, fleet_info)
            set_meta = UI_SKILL_SETS[active_ui_set]
            emit("text", text=f"• **UI Archetype Switched**: Guiding engine updated to Set {active_ui_set} — **{set_meta['name']}**\n")

    emit(
        "agent",
        name="firstmate",
        label=f"Firstmate · Fleet Supervisor ({target_meta['display_name']})",
        session=session_id,
        cwd=str(cwd),
        resume=["omarchy-launch-terminal", "herdr"],
        resumeLabel="Expand in Herdr",
        pid=0,
    )

    if not api_key:
        emit("error", text="Gemini API key is missing. Please add it to ~/.config/omagent/config.json")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    # 1. Collect live multi-agent fleet telemetry
    telemetry = get_fleet_telemetry(ws_id, pane_id)

    # 2. Inspect workspace directory files
    project_files: list[str] = []
    scan_target = cwd if cwd.is_dir() else Path.home() / "Projects"
    if scan_target.is_dir():
        try:
            for item in sorted(scan_target.rglob("*")):
                if item.is_file() and not any(part.startswith((".", "node_modules", ".git", "venv", "__pycache__")) for part in item.parts):
                    try:
                        rel = item.relative_to(scan_target)
                        size = item.stat().st_size
                        project_files.append(f"{rel} ({size} bytes)")
                    except Exception:
                        pass
                if len(project_files) >= 30:
                    break
        except Exception:
            pass

    files_summary = "\n".join(f"- {f}" for f in project_files) if project_files else "No local project files detected yet."

    # 3. Detect if the user's message is an action directive / change / steer / new task
    is_info = any(re.search(p, req_lower, re.IGNORECASE) for p in INFO_QUESTION_PATTERNS)
    has_code_action = any(re.search(p, req_lower, re.IGNORECASE) for p in CODE_ACTION_PATTERNS)
    is_directive = has_code_action or (not is_info and len(clean_req.split()) > 1)

    dispatch_status = "Informational query only — no new modification orders were dispatched to the crew."
    if is_directive and pane_id:
        # Deliver instruction to lead crewmate inbox via Firstmate
        if shutil.which("firstmate") and fm_task_id:
            try:
                fm_send_res = subprocess.run(["firstmate", "send", fm_task_id, clean_req], capture_output=True, text=True, timeout=8)
                if fm_send_res.returncode == 0:
                    emit("text", text=f"• **Firstmate Relayed Directive**: Dispatched modification to crew inbox (`{fm_task_id}`)\n")
            except Exception as e:
                if DEBUG:
                    print(f"Firstmate send error in bridge: {e}", file=sys.stderr)

        # Ring doorbell or re-engage idle agent in the pane
        is_agy = "agy" in stored_harness or "antigravity" in stored_harness or stored_provider == "agy"
        proc_running = False
        try:
            p_res = subprocess.run(["herdr", "pane", "process-info", "--pane", pane_id], capture_output=True, text=True, timeout=2)
            if p_res.returncode == 0:
                p_data = json.loads(p_res.stdout).get("result", {}).get("process_info", {})
                procs = [p.get("name") for p in p_data.get("foreground_processes", [])]
                target_proc = "agy" if is_agy else ("opencode" if stored_provider == "opencode" or "opencode" in stored_harness else ("cline" if stored_provider == "cline" or "cline" in stored_harness else "pi"))
                if any(target_proc in p for p in procs):
                    proc_running = True
        except Exception:
            pass

        doorbell = f"Firstmate instruction waiting: list {FM_STATE_DIR}/{fm_task_id}.inbox/*.msg and, in numeric order, read and act on each, then mv each handled file to {FM_STATE_DIR}/{fm_task_id}.inbox/handled/."

        if is_swapped and proc_running:
            try:
                subprocess.run(["herdr", "pane", "send-keys", pane_id, "C-c"], capture_output=True, text=True, timeout=2)
                time.sleep(0.3)
                proc_running = False
            except Exception:
                pass

        if proc_running and not is_swapped:
            time.sleep(0.2)
            subprocess.run(["herdr", "pane", "send-text", pane_id, f"{doorbell}\n"], capture_output=True, text=True, timeout=3)
            emit("text", text="• **Crew Alerted**: Doorbell rung in active Herdr pane\n")
        else:
            if is_swapped and swapped_harness:
                if stored_provider == "opencode":
                    relaunch_cmd = f"opencode run -m {shlex.quote(stored_model)} {shlex.quote(doorbell)}\n"
                elif stored_provider == "cline":
                    thinking_flag = "--thinking medium " if "muse-spark" in stored_model else ""
                    relaunch_cmd = f"cline --auto-approve true {thinking_flag}-m {shlex.quote(stored_model)} {shlex.quote(doorbell)}\n"
                else:
                    relaunch_cmd = f"agy --model {shlex.quote(stored_model)} --dangerously-skip-permissions -i {shlex.quote(doorbell)}\n"
            else:
                if is_agy:
                    relaunch_cmd = f"agy --continue --model {shlex.quote(stored_model)} --dangerously-skip-permissions -i {shlex.quote(doorbell)}\n"
                elif stored_provider == "opencode" or "opencode" in stored_harness:
                    relaunch_cmd = f"opencode run -m {shlex.quote(stored_model)} -c {shlex.quote(doorbell)}\n"
                elif stored_provider == "cline" or "cline" in stored_harness:
                    thinking_flag = "--thinking medium " if "muse-spark" in stored_model else ""
                    relaunch_cmd = f"cline --auto-approve true {thinking_flag}-m {shlex.quote(stored_model)} {shlex.quote(doorbell)}\n"
                else:
                    relaunch_cmd = f"agy --continue --dangerously-skip-permissions -i {shlex.quote(doorbell)}\n"

            subprocess.run(["herdr", "pane", "send-text", pane_id, relaunch_cmd], capture_output=True, text=True, timeout=3)
            emit("text", text=f"• **Session Resumed**: Re-engaged crewmate ({target_meta['display_name']}) in Herdr pane\n")

        dispatch_status = (
            f"DIRECTIVE DISPATCHED: The Captain's order ('{clean_req}') was transmitted to the lead crewmate "
            f"({fm_task_id}) running on {target_meta['display_name']} ({stored_model}) in Herdr pane {pane_id}. "
            f"The crew has received the order and is executing it in the background."
        )

    # 4. Assemble Firstmate supervisor instruction & context
    history = load_session_history(session_id)
    contents = build_conversation_contents(history, clean_req)

    fleet_status_label = "ACTIVELY WORKING" if telemetry["any_working"] else ("ALL CREW IDLE / READY" if telemetry["all_idle"] else "READY")

    ui_engine_block = ""
    if active_ui_set and active_ui_set in UI_SKILL_SETS:
        meta = UI_SKILL_SETS[active_ui_set]
        ui_engine_block = (
            f"- Active UI Guiding Engine: Set {active_ui_set} — {meta['name']} ({meta['archetype']})\n"
            f"  Source Path: {meta['path']}\n"
            f"  Core Focus: {meta['description']}\n"
            f"  Strict Protocol: Crew must build and style all UI components exclusively using Set {active_ui_set}!\n"
        )

    firstmate_system = (
        "You are Firstmate, the fleet supervisor and bridge officer of an autonomous AI engineering fleet.\n"
        "You are stationed on the bridge speaking directly to the Captain (the user).\n"
        "Your engineering crew and specialized subagents are stationed inside the Herdr workspace.\n\n"
        "FLEET TELEMETRY & SUBAGENTS IN HERDR:\n"
        f"- Herdr Workspace: {ws_label} (ID: {ws_id}, Primary Pane: {pane_id})\n"
        f"- Active Subagents ({len(telemetry['agents'])}):\n{telemetry['crew_table']}\n"
        f"- Active Lead Engine: {target_meta['display_name']} ({stored_model}) [Harness: {stored_provider}]\n"
        f"{ui_engine_block}"
        f"- Fleet Lifecycle Status: {fleet_status_label}\n"
        f"- Project Root: {cwd}\n"
        f"- Project Files:\n{files_summary}\n\n"
        "RECENT TERMINAL ACTIVITY ACROSS SUBAGENTS:\n"
        "```\n"
        f"{telemetry['terminal_snippets']}\n"
        "```\n\n"
        "CURRENT DISPATCH STATE:\n"
        f"{dispatch_status}\n\n"
        "BRIDGE OFFICER RULES OF ENGAGEMENT:\n"
        "1. Immediate Bridge Response: Always respond immediately to the Captain. You are their direct connection to the fleet.\n"
        "2. Order Confirmation: If the Captain issued an order, change, or new requirement, confirm that the directive was dispatched to the crew. Explain specifically which subagents will execute it, what files will be touched, and what the plan of attack is.\n"
        "3. Live Status & Telemetry: If the Captain asks about progress, status, or what the agents are doing, give an accurate breakdown from the telemetry above.\n"
        "4. Previews & Running: If the Captain asks how to view, test, open, or run the project, provide exact terminal commands (e.g. `xdg-open <path>`, `python3 -m http.server 3000 --directory <dir>`) and clickable markdown links (`file:///...`).\n"
        "5. Anti-One-Shot Quality: Ensure the Captain knows the fleet adheres to Compound Engineering rigor (anti-one-shot, visual screenshots, adversarial review).\n"
        "6. Tone & Persona: Decisive, disciplined, professional naval-engineering bridge officer. Direct, clear, high-craft, and reassuring. Always let the Captain know their fleet is on station."
    )

    ok, err, full_text = stream_gemini_api(
        prompt=contents,
        api_key=api_key,
        model=config.get("fast_model", "gemini-3.5-flash"),
        system_instruction=firstmate_system,
    )

    if not ok:
        emit("error", text=err)
        emit("done", ok=False, code=1, stopped=False)
        return 1

    save_session_history(session_id, contents, full_text)
    emit("done", ok=True, code=0, stopped=False)
    return 0


