    brain_dir = Path.home() / ".gemini/antigravity-cli/brain"
    if not brain_dir.is_dir():
        return None
    files = sorted(brain_dir.glob("*/.system_generated/logs/transcript.jsonl"), key=lambda p: p.stat().st_mtime)
    return files[-1] if files else None


def resolve_agy_session_file(pane_id: str | None, launch_time: float) -> Path | None:
    """Finds the transcript file strictly belonging to the session launched in pane_id after launch_time."""
    # 1. Try Herdr pane native agent_session
    if pane_id:
        try:
            p_get = subprocess.run(["herdr", "pane", "get", pane_id], capture_output=True, text=True, timeout=2)
            if p_get.returncode == 0:
                p_info = json.loads(p_get.stdout).get("result", {}).get("pane", {})
                sess_val = p_info.get("agent_session", {}).get("value")
                if sess_val:
                    cand = Path.home() / f".gemini/antigravity-cli/brain/{sess_val}/.system_generated/logs/transcript.jsonl"
                    if cand.is_file():
                        return cand
        except Exception:
            pass

    # 2. Search brain directories created or modified strictly after launch_time - 3.0
    brain_dir = Path.home() / ".gemini/antigravity-cli/brain"
    if not brain_dir.is_dir():
        return None
    candidates = []
    try:
        for d in brain_dir.iterdir():
            if not d.is_dir() or d.name.startswith("."):
                continue
            try:
                st = d.stat()
                if st.st_ctime >= launch_time - 3.0 or st.st_mtime >= launch_time - 3.0:
                    t_file = d / ".system_generated/logs/transcript.jsonl"
                    if t_file.is_file():
                        candidates.append((t_file.stat().st_mtime, t_file))
            except Exception:
                continue
    except Exception:
        pass

    if candidates:
        candidates.sort(key=lambda x: x[0], reverse=True)
        return candidates[0][1]

    return None


def is_harness_process_running(proc_info: dict, target_harness: str) -> bool:
    """Checks if the target harness process is running in foreground_processes.

    Robustly checks:
    1. 'name' field (e.g. 'agy', 'opencode', 'node', 'cline')
    2. 'cmdline' string (e.g. 'node /.../cline', 'opencode run ...')
    3. 'argv' list elements
    """
    if not proc_info or not target_harness:
        return False
    fg = proc_info.get("foreground_processes", [])
    if not fg:
        return False
    target = target_harness.lower()
    for p in fg:
        name = (p.get("name") or "").lower()
        if target in name:
            return True
        cmdline = (p.get("cmdline") or "").lower()
        if target in cmdline:
            return True
        argv = p.get("argv") or []
        for arg in argv:
            if target in (arg or "").lower():
                return True
    return False


def resolve_cline_session_file(launch_time: float) -> Path | None:
    """Finds the latest Cline session messages JSON file started or modified around launch_time."""
    sessions_dir = Path.home() / ".cline/data/sessions"
    if not sessions_dir.is_dir():
        return None
    try:
        latest = None
        latest_mtime = 0.0
        for d in sessions_dir.iterdir():
            if d.is_dir():
                mtime = d.stat().st_mtime
                if mtime >= (launch_time - 15.0) and mtime > latest_mtime:
                    cand = d / f"{d.name}.messages.json"
                    if cand.is_file():
                        latest = cand
                        latest_mtime = mtime
        return latest
    except Exception:
        return None


def read_opencode_recent_parts(since_time_ms: int) -> list[dict]:
    """Reads recent message/tool execution parts from OpenCode SQLite database."""
    db_path = Path.home() / ".local/share/opencode/opencode.db"
    if not db_path.is_file():
        return []
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=2.0)
        cur = conn.cursor()
        cur.execute(
            "SELECT id, time_created, data FROM part WHERE time_created > ? ORDER BY time_created ASC",
            (since_time_ms,)
        )
        rows = cur.fetchall()
        conn.close()
        parts = []
        for rid, t_created, d_str in rows:
            try:
                p_data = json.loads(d_str)
                p_data["_part_id"] = rid
                p_data["_time_created"] = t_created
                parts.append(p_data)
            except Exception:
                pass
        return parts
    except Exception:
        return []


def slugify_task(task_prompt: str) -> str:
    """Derives a clean, readable folder slug from a task prompt."""
    p = clean_prefix(task_prompt).lower()
    m = re.search(r'(?:called|named|project|app|folder)\s+["\']?([a-zA-Z0-9_-]{3,24})["\']?', p)
    if m:
        return m.group(1).lower()
    stop = {
        "make", "the", "a", "an", "for", "my", "in", "state", "of", "and", "we", "got",
        "as", "well", "ui", "create", "build", "design", "page", "website", "webpage",
        "site", "app", "dashboard", "want", "you", "to", "with", "from", "using", "like", "our"
    }
    words = [w for w in re.findall(r'[a-zA-Z0-9]+', p) if w not in stop and len(w) > 1]
    if words:
        slug = "-".join(words[:4])
        return slug[:32].strip("-")
    return f"project-{int(time.time()) % 10000}"


def resolve_project_cwd(task_prompt: str, config: dict) -> Path:
    """Ensures each project is isolated in its own dedicated subfolder under ~/Projects with git and treehouse tracking."""
    base_dir = work_dir()
    slug = slugify_task(task_prompt)
    target = base_dir / slug
    if target.is_dir() and any(target.iterdir()):
        suffix = 1
        cand = base_dir / f"{slug}-{suffix}"
        while cand.is_dir() and any(cand.iterdir()):
            suffix += 1
            cand = base_dir / f"{slug}-{suffix}"
        target = cand
    target.mkdir(parents=True, exist_ok=True)
    try:
        if not (target / ".git").exists():
            subprocess.run(["git", "init", "-b", f"ui/{slug}"], cwd=str(target), capture_output=True, timeout=5)
        if config.get("use_treehouse", True) and shutil.which("treehouse"):
            subprocess.run(["treehouse", "init"], cwd=str(target), capture_output=True, timeout=5)
    except Exception:
        pass
    return target


def resolve_coding_worktree(task_prompt: str, config: dict) -> Path:
    """Provisions a dedicated, isolated custom worktree for normal coding tasks (Python, Java, C#, scripts, backend),
    strictly separated from UI and app development complex worktrees."""
    slug = slugify_task(task_prompt) or "coding-task"

    # 1. If currently inside a git repository (and not home directory): create isolated git worktree branch
    try:
        cur = Path.cwd().resolve()
        if cur != Path.home() and (cur / ".git").exists():
            worktrees_dir = cur / ".worktrees"
            worktrees_dir.mkdir(parents=True, exist_ok=True)
            target = worktrees_dir / f"coding-{slug}"
            branch_name = f"coding/{slug}"

            gitignore = cur / ".gitignore"
            if gitignore.is_file():
                content = gitignore.read_text("utf-8", errors="ignore")
                if ".worktrees" not in content:
                    gitignore.write_text(content.rstrip() + "\n.worktrees/\n", "utf-8")
            else:
                gitignore.write_text(".worktrees/\n", "utf-8")

            res = subprocess.run(["git", "worktree", "add", "-b", branch_name, str(target)], cwd=str(cur), capture_output=True, text=True, timeout=8)
            if res.returncode == 0 and target.is_dir():
                return target
    except Exception as e:
        if DEBUG:
            print(f"Git worktree creation error in {cur}: {e}", file=sys.stderr)

    # 2. Dedicated root for all normal coding tasks under ~/Projects/coding-tasks/
    coding_root = Path.home() / "Projects" / "coding-tasks"
    coding_root.mkdir(parents=True, exist_ok=True)

    target = coding_root / slug
    if target.is_dir() and any(target.iterdir()):
        suffix = 1
        cand = coding_root / f"{slug}-{suffix}"
        while cand.is_dir() and any(cand.iterdir()):
            suffix += 1
            cand = coding_root / f"{slug}-{suffix}"
        target = cand

    target.mkdir(parents=True, exist_ok=True)
    branch_name = f"coding/{slug}"

    git_dir = target / ".git"
    if not git_dir.exists():
        try:
            subprocess.run(["git", "init", "-b", branch_name], cwd=str(target), capture_output=True, text=True, timeout=5)
            gitignore = target / ".gitignore"
            if not gitignore.exists():
                gitignore.write_text(
                    "__pycache__/\n*.pyc\n.pytest_cache/\n.venv/\nnode_modules/\nbin/\nobj/\n*.class\n.worktrees/\n*.log\n",
                    encoding="utf-8"
                )
                subprocess.run(["git", "add", ".gitignore"], cwd=str(target), capture_output=True, text=True, timeout=5)
                subprocess.run(["git", "commit", "-m", f"chore: initialize isolated coding worktree on {branch_name}"], cwd=str(target), capture_output=True, text=True, timeout=5)
        except Exception as e:
            if DEBUG:
                print(f"Error initializing git worktree in {target}: {e}", file=sys.stderr)

    # 3. If treehouse is available, initialize treehouse config
    if config.get("use_treehouse", True) and shutil.which("treehouse"):
        try:
            subprocess.run(["treehouse", "init"], cwd=str(target), capture_output=True, text=True, timeout=3)
        except Exception:
            pass

    return target


def prune_stale_herdr_workspaces(keep_ws_id: str | None = None) -> list[str]:
    """Closes prior AI agent workspaces in Herdr to prevent zombie processes and cross-talk."""
    closed = []
    try:
        res = subprocess.run(["herdr", "workspace", "list"], capture_output=True, text=True, timeout=3)
        if res.returncode == 0:
            data = json.loads(res.stdout)
            workspaces = data.get("result", {}).get("workspaces", [])
            for ws in workspaces:
                ws_id = ws.get("workspace_id")
                label = ws.get("label", "")
                num = ws.get("number", 0)
                if ws_id in ("w1", keep_ws_id) or num == 1:
                    continue
                if any(label.startswith(pfx) for pfx in ("AGY:", "Pi:", "Firstmate:", "FAIL:", "omagent:")) or ws.get("agent_status") in ("idle", "done", "unknown"):
                    subprocess.run(["herdr", "workspace", "close", ws_id], capture_output=True, text=True, timeout=3)
                    closed.append(ws_id)
    except Exception as e:
        if DEBUG:
            print(f"Error pruning stale Herdr workspaces: {e}", file=sys.stderr)
    return closed


def prune_stale_firstmate_tasks() -> list[str]:
    """Prunes dead Firstmate .meta and .inbox directories whose Herdr panes no longer exist."""
    pruned = []
    if not FM_STATE_DIR.is_dir():
        return pruned
    for meta_file in list(FM_STATE_DIR.glob("*.meta")):
        try:
            lines = meta_file.read_text("utf-8", errors="ignore").splitlines()
            pane = ""
            for l in lines:
                if l.startswith("herdr_pane_id="):
                    pane = l.split("=", 1)[1].strip()
                    break
            is_dead = False
            if pane:
                chk = subprocess.run(["herdr", "pane", "get", pane], capture_output=True, text=True, timeout=2)
                if chk.returncode != 0:
                    is_dead = True
            else:
                is_dead = True

            if is_dead:
                meta_file.unlink(missing_ok=True)
                task_name = meta_file.stem
                inbox = FM_STATE_DIR / f"{task_name}.inbox"
                if inbox.is_dir():
                    shutil.rmtree(inbox, ignore_errors=True)
                pruned.append(task_name)
        except Exception:
            pass
    return pruned


def is_new_project_directive(request: str) -> bool:
    """Checks if request is explicitly launching a new project rather than a minor steer to an existing fleet."""
    req_lower = request.lower().strip()
    if any(req_lower.startswith(pfx) for pfx in ("/new", "/code", "new:", "create project", "new project")):
        return True
    if is_normal_coding_request(request):
        return True
    if is_ui_creation_request(request):
        creation_starters = (
            "make the ui", "build the ui", "create the ui", "design the ui",
            "make a website", "build a website", "create a website",
            "make a landing page", "build a landing page", "create a landing page",
            "make a web page", "build a web page", "create a web page",
            "make an app", "build an app", "create an app"
        )
        if any(req_lower.startswith(s) or f" {s}" in req_lower for s in creation_starters):
            return True
    return False


def get_fleet_telemetry(ws_id: str | None, primary_pane_id: str | None) -> dict:
    meta_map = {}
    if FM_STATE_DIR.is_dir():
        for p in FM_STATE_DIR.glob("*.meta"):
            try:
                lines = p.read_text("utf-8", errors="ignore").splitlines()
                d = {}
                for l in lines:
                    if "=" in l:
                        k, v = l.split("=", 1)
                        d[k.strip()] = v.strip()
                pane = d.get("herdr_pane_id")
                if pane:
                    meta_map[pane] = d
            except Exception:
                pass

    agents = []
    try:
        p_ag = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True, timeout=2)
        if p_ag.returncode == 0:
            all_ag = json.loads(p_ag.stdout).get("result", {}).get("agents", [])
            agents = [a for a in all_ag if not ws_id or a.get("workspace_id") == ws_id]
    except Exception:
        pass

    if not agents and primary_pane_id:
        try:
            p_get = subprocess.run(["herdr", "pane", "get", primary_pane_id], capture_output=True, text=True, timeout=2)
            if p_get.returncode == 0:
                p_info = json.loads(p_get.stdout).get("result", {}).get("pane", {})
                agents = [p_info]
        except Exception:
            pass

    crew_list = []
    terminal_snippets = []
    any_working = False
    all_idle = True if agents else False

    for a in agents:
        name = a.get("name") or a.get("agent") or "crewmate"
        status = a.get("agent_status") or "unknown"
        pane = a.get("pane_id") or primary_pane_id or "unknown"
        meta = meta_map.get(pane, {})
        role = meta.get("role", "lead-engineer" if pane == primary_pane_id else "subagent")
        skill = meta.get("skill", "ce-work")

        if status == "working":
            any_working = True
            all_idle = False
        elif status not in ("idle", "done"):
            all_idle = False

        crew_list.append({
            "name": name,
            "role": role,
            "skill": skill,
            "status": status,
            "pane_id": pane,
        })

        out = ""
        try:
            r = subprocess.run(["herdr", "agent", "read", name, "--source", "recent-unwrapped", "--lines", "25"], capture_output=True, text=True, timeout=2)
            if r.returncode == 0 and r.stdout.strip():
                out = r.stdout.strip()
        except Exception:
            pass
        if not out and pane:
            try:
                r2 = subprocess.run(["herdr", "pane", "read", pane, "--lines", "25"], capture_output=True, text=True, timeout=2)
                if r2.returncode == 0 and r2.stdout.strip():
                    out = r2.stdout.strip()
            except Exception:
                pass
        if out:
            terminal_snippets.append(f"[{name} (Role: {role}, Skill: {skill}, Status: {status}) in Pane {pane}]:\n{out[-1200:]}")

    crew_rows = []
    for c in crew_list:
        crew_rows.append(f"- {c['name']} (Role: {c['role']}, Skill: {c['skill']}, Status: {c['status'].upper()}, Pane: {c['pane_id']})")
    crew_table = "\n".join(crew_rows) if crew_rows else "- No active crewmates currently found."

    return {
        "agents": crew_list,
        "crew_table": crew_table,
        "any_working": any_working,
        "all_idle": all_idle,
        "terminal_snippets": "\n\n".join(terminal_snippets) if terminal_snippets else "No recent terminal activity captured.",
    }


