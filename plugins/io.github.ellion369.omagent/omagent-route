    msg = (
        f"### ⚠️ Model Error Persisting on `{current_harness} / {current_model}`\n\n"
        f"The model encountered an error that could not be automatically resolved with `continue`:\n"
        f"> ```text\n> {clean_err}\n> ```\n\n"
