# INTENT CLASSIFICATION
# =====================================================================

LANE_GENERAL = "general"
LANE_WEB = "web"
LANE_CODE = "code"

CODE_INDICATORS = [
    r"```",
    r"\bdef\s+\w+",
    r"\bclass\s+\w+",
    r"\bfn\s+\w+",
    r"\bfunction\s+\w+",
    r"\bimport\s+[\w\.]+",
    r"\bconst\s+\w+\s*=",
    r"\b(git|worktree|commit|pull request|pr|branch|merge|rebase|repo|repository)\b",
    r"\b(fix bug|refactor|unit test|write code|implement|build|compile|deploy)\b",
    r"\b(write|create|build|implement|debug|fix|refactor|test|run)\b.*\b(script|program|code|function|class|app|module|api|tests?)\b",
    r"\b(python|javascript|typescript|rust|golang|bash|c\+\+|html|css|sql)\b.*\b(script|code|program|file|function)\b",
    r"\b(cargo|npm|pnpm|pip|pytest|docker|herdr|firstmate|treehouse|harness|axi|compound)\b",
    r"\b(ce-[a-z0-9\-]+|lfg)\b",
    r"\.(py|rs|ts|js|lua|go|c|cpp|sh|json|toml|ya?ml|html|css)\b",
]

WEB_INDICATORS = [
    r"\b(today|yesterday|this week|current weather|forecast|breaking news)\b",
    r"\b(latest version|who won|stock price|crypto price|score of)\b",
    r"\b(search for|google|search web|lookup online|check online|browse)\b",
    r"https?://\S+",
]


def classify_intent(request: str, prior_agent: str = "") -> str:
    req_lower = request.strip().lower()

    # Explicit prefix overrides
    if req_lower.startswith(("/code ", "code: ")):
        return LANE_CODE
    if req_lower.startswith(("/web ", "web: ", "/search ", "search: ")):
        return LANE_WEB
    if req_lower.startswith(("/ask ", "ask: ")):
        return LANE_GENERAL

    # Regex heuristic check
    for pattern in CODE_INDICATORS:
        if re.search(pattern, req_lower, re.IGNORECASE):
            return LANE_CODE

    for pattern in WEB_INDICATORS:
        if re.search(pattern, req_lower, re.IGNORECASE):
            return LANE_WEB

    # Sticky lane: If continuing a coding session and user didn't explicitly override
    if prior_agent in ("firstmate-pi", "antigravity-agy") and not req_lower.startswith(("/ask", "ask:", "/web", "web:")):
        return LANE_CODE

    return LANE_GENERAL


def clean_prefix(request: str) -> str:
    for prefix in ["/code ", "code: ", "/web ", "web: ", "/search ", "search: ", "/ask ", "ask: "]:
        if request.lower().startswith(prefix):
            return request[len(prefix):].strip()
    return request.strip()


# =====================================================================
# GOOGLE GEMINI STREAMING CLIENT
# =====================================================================

def stream_gemini_api(
    prompt: str | list[dict],
    api_key: str,
    model: str = "gemini-3.8-flash",
    fallback_models: list[str] | None = None,
    system_instruction: str = "",
) -> tuple[bool, str, str]:
    """Streams tokens directly from Google Gemini API via SSE."""
    if fallback_models is None:
        fallback_models = ["gemini-3.8-flash", "gemini-3.7-flash", "gemini-3.6-flash", "gemini-3.5-flash", "gemini-3-flash-preview"]

    candidate_models = [model] + [m for m in fallback_models if m != model]

    if isinstance(prompt, str):
        contents = [{"parts": [{"text": prompt}]}]
    else:
        contents = prompt

    for current_model in candidate_models:
        url = (
            f"https://generativelanguage.googleapis.com/v1beta/models/"
            f"{current_model}:streamGenerateContent?alt=sse&key={api_key}"
        )
        body: dict = {
            "contents": contents,
            "generationConfig": {
                "temperature": 0.7,
                "maxOutputTokens": 2048,
            },
        }
        if system_instruction:
            body["systemInstruction"] = {"parts": [{"text": system_instruction}]}

        data = json.dumps(body).encode("utf-8")
        req = urllib.request.Request(
            url, data=data, headers={"Content-Type": "application/json"}
        )

        accumulated_text = ""
        try:
            with urllib.request.urlopen(req, timeout=25) as resp:
                for raw_line in resp:
                    line = raw_line.decode("utf-8", errors="ignore").strip()
                    if not line.startswith("data: "):
                        continue
                    payload_str = line[6:]
                    try:
                        chunk = json.loads(payload_str)
                    except ValueError:
                        continue

                    candidates = chunk.get("candidates", [])
                    if candidates:
                        parts = candidates[0].get("content", {}).get("parts", [])
                        for p in parts:
                            text = p.get("text", "")
                            if text:
                                accumulated_text += text
                                emit("text", text=text)
                return True, "", accumulated_text
        except urllib.error.HTTPError as e:
            err_body = e.read().decode("utf-8", errors="ignore")
            # 503 (high demand) or 404 or 429: try next candidate model
            if e.code in (503, 404, 429) and current_model != candidate_models[-1]:
                if DEBUG:
                    print(f"Model {current_model} returned {e.code}, falling back...", file=sys.stderr)
                time.sleep(0.5)
                continue
            return False, f"Google Gemini API error ({e.code}): {err_body[:200]}", ""
        except Exception as e:
            if current_model != candidate_models[-1]:
                continue
            return False, f"Network error connecting to Gemini API: {e}", ""

    return False, "All Gemini candidate models were unavailable.", ""


