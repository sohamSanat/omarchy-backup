                data["version"] = 1
            if "agentName" not in data:
                data["agentName"] = "jarvis"
            if "agentLabel" not in data:
                data["agentLabel"] = "Jarvis"
            if "sessionId" not in data:
                data["sessionId"] = session_id
        elif isinstance(data, list):
            entries = []
            for turn in data:
                role = turn.get("role")
                parts = turn.get("parts", [{}])
                txt = parts[0].get("text", "") if parts else ""
                if role == "user":
                    entries.append({"rowKind": "you", "rowText": txt, "rowCount": 1, "rowLines": txt, "rowExpanded": False, "rowAuto": False})
                elif role == "model":
                    entries.append({"rowKind": "text", "rowText": txt, "rowCount": 1, "rowLines": txt, "rowExpanded": False, "rowAuto": False})
            data = {
