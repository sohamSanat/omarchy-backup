                    if not line_str:
                        continue
                    try:
                        evt = json.loads(line_str)
                    except Exception:
                        continue

                    if is_agy:
                        # Parse Antigravity transcript format
                        tool_calls = evt.get("tool_calls", [])
                        for tc in tool_calls:
                            name = tc.get("name")
                            args = tc.get("args") or {}
                            if name in ("view_file", "read_url_content", "grep_search", "find_by_name", "list_dir"):
