    emit(
        "agent",
        name="firstmate",
        label="Firstmate · UI Design Director",
        session=session_id,
        cwd=str(cwd),
        resume=["omarchy-launch-terminal", "herdr"],
        resumeLabel="Expand in Herdr",
        pid=0,
    )

    if image_path:
        img_p = Path(image_path).expanduser().resolve()
        if img_p.is_file():
            img_file = img_p
            cache_file = SESSION_DIR / f"{session_id}.ref_analysis.json"
            # Wait up to 2 seconds if the background deconstruction is still finalizing
            waited = 0.0
            while not cache_file.is_file() and waited < 2.0:
                time.sleep(0.1)
                waited += 0.1

            if cache_file.is_file():
                try:
                    raw_analysis = json.loads(cache_file.read_text("utf-8"))
                    ref_analysis = specialize_ref_analysis_for_ui_set(raw_analysis, ui_set, domain)
                    emit("tool", text=f"Subagent 1 (Visual Reference Analyst) completed background deconstruction of {img_p.name}!")
                    if ref_analysis and ref_analysis.get("markdown_card"):
                        emit("text", text=ref_analysis["markdown_card"])
                        emit("status", text="Subagent 1 design language deconstruction conveyed to Firstmate. Proceeding to strategic alignment...")
                except Exception:
                    ref_analysis = None

            if not ref_analysis:
                emit("tool", text=f"Assigning Subagent 1 (Visual Reference Analyst) to deconstruct design language from {img_p.name}...")
                emit("status", text="Deconstructing design language (strict anti-copying directive enforced)...")
                ref_analysis = deconstruct_reference_image(str(img_p), original_request, domain, ui_set, config)
                if ref_analysis and ref_analysis.get("markdown_card"):
                    emit("text", text=ref_analysis["markdown_card"])
                    emit("status", text="Subagent 1 design language deconstruction conveyed to Firstmate. Proceeding to strategic alignment...")

    round_num = 1
    round_data = generate_grill_me_round(original_request, ui_set, round_num, [], config, ref_analysis=ref_analysis)

    state = {
        "session_id": session_id,
        "original_request": original_request,
        "ui_set": ui_set,
        "harness": harness,
        "model": model,
        "domain": domain,
        "image_path": str(img_file) if img_file else "",
        "ref_analysis": ref_analysis,
        "round": round_num,
        "status": "awaiting_answers",
        "round_title": round_data.get("theme_title", "Visual Identity & Thematic Centerpiece"),
        "questions": round_data["questions"],
        "decisions": [],
    }
    save_pending_grill_me(session_id, state)

    card_md = render_grill_me_questions_card(state)

    hist = load_session_history(session_id)
    hist_to_save = list(hist)
    user_turn_text = f"{original_request}\n[Attached Reference Image: {img_file.name}]" if img_file else original_request
    hist_to_save.append({"role": "user", "parts": [{"text": user_turn_text}]})
    combined_response = (ref_analysis.get("markdown_card") + "\n\n" + card_md) if (ref_analysis and ref_analysis.get("markdown_card")) else card_md
    save_session_history(session_id, hist_to_save, combined_response)

    emit("text", text=card_md)
    emit("done", ok=True, code=0, stopped=False)
    return 0


def handle_pending_grill_me(session_id: str, user_reply: str, state: dict, config: dict, harness: str = "", model: str = "") -> int:
    req_clean = user_reply.strip().lower()

    if req_clean in ("cancel", "abort", "exit", "quit"):
        clear_pending_grill_me(session_id)
        emit(
            "agent",
            name="firstmate",
            label="Firstmate · UI Design Director",
            session=session_id,
            cwd=str(work_dir()),
            resume=["omarchy-launch-terminal", "herdr"],
            resumeLabel="Expand in Herdr",
            pid=0,
        )
        emit("text", text="Grill-Me design session cancelled. Let me know what you'd like to work on instead!")
        emit("done", ok=True, code=0, stopped=False)
        return 0

    effective_harness = harness or state.get("harness", "")
    effective_model = model or state.get("model", "")
    if effective_harness:
        state["harness"] = effective_harness
    if effective_model:
        state["model"] = effective_model

    status = state.get("status", "awaiting_answers")

    # Universal Skip / Refusal / Creative Freedom Check:
    # If the user skips, refuses, or grants creative freedom, cease questioning immediately.
    # No further questions will be asked. Agents have full creative freedom to build on their own accord.
    if is_skip_or_refusal(user_reply):
        clear_pending_grill_me(session_id)
        state["creative_freedom"] = True

        # If user partially answered something alongside skip (e.g. "1, skip" or "Q1: 2, skip the rest"), lock answered questions
        parsed = parse_grill_answers(user_reply, state.get("questions", []))
        for q in state.get("questions", []):
            qid = q["id"]
            if qid in parsed:
                opt_id = parsed[qid]
                opt = next((o for o in q.get("options", []) if o["id"] == opt_id), None)
                state.setdefault("decisions", []).append({
                    "round": state.get("round", 1),
                    "question_id": qid,
                    "question_title": q.get("title", f"Question {qid}"),
                    "chosen_option_id": opt_id,
                    "option_title": opt.get("title", f"Option {opt_id}") if opt else f"Option {opt_id}",
                    "desc": opt.get("desc", "") if opt else "",
                })

        brief = build_grill_me_design_brief(state)
        orig_req = state.get("original_request", user_reply)
        enhanced_request = f"{orig_req}\n\n{brief}"
        ui_set = state.get("ui_set", 1)

        freedom_md = (
            "### 🎨 Creative Freedom Granted — Commencing Autonomous Build\n\n"
            "You've chosen to skip further questioning and granted **full creative freedom**! From this point on, I will not question or grill you any further.\n\n"
            f"Our team of specialized UI subagents now has the green light to take creative leadership and construct an exceptional interface on our own accord—crafted to the highest standards of **Set {ui_set}**.\n\n"
        )
        if state.get("decisions"):
            freedom_md += "**Locked Prior Decisions**:\n"
            for d in state.get("decisions", []):
                freedom_md += f"- **Round {d.get('round')} · {d.get('question_title', 'Directive')}**: Option {d.get('chosen_option_id')} — *{d.get('option_title')}*\n"
            freedom_md += "- **Remaining Dimensions**: Full creative freedom exercised by Firstmate subagents.\n\n"
        else:
            freedom_md += f"**Creative Scope**: Full creative freedom across all visual, motion, and architectural dimensions.\n\n"

        freedom_md += "Firstmate and our specialized UI subagents are now taking over in Herdr to construct, animate, and visually verify your interface."

        hist = load_session_history(session_id)
        hist_to_save = list(hist)
        hist_to_save.append({"role": "user", "parts": [{"text": user_reply}]})
        save_session_history(session_id, hist_to_save, freedom_md)

        emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
        emit("text", text=freedom_md)

        return run_lane_coding(
            enhanced_request,
            config,
            session_id,
            ui_set=ui_set,
            harness=effective_harness,
            model=effective_model,
        )

    # Checkpoint loop: user decides to proceed to build or continue grilling
    if status == "awaiting_checkpoint":
        is_proceed = (
            req_clean in ("1", "1.", "(1)", "[1]", "#1", "proceed", "build", "stop", "stop grilling", "design", "make design", "start", "done", "ready", "go", "launch")
            or "proceed" in req_clean
            or "stop grilling" in req_clean
            or "build" in req_clean
            or "make the design" in req_clean
        )
        is_continue = (
            req_clean in ("2", "2.", "(2)", "[2]", "#2", "continue", "grill", "grilling", "refine", "more", "keep grilling", "next", "continue grilling", "more questions", "ask more", "drill deeper")
            or "continue" in req_clean
            or "keep grilling" in req_clean
            or "more grilling" in req_clean
            or "more questions" in req_clean
            or "ask me more" in req_clean
            or "drill deeper" in req_clean
            or "dig deeper" in req_clean
            or "drill down" in req_clean
            or req_clean == "more"
        )

        if is_proceed and not is_continue:
            clear_pending_grill_me(session_id)
            brief = build_grill_me_design_brief(state)
            orig_req = state.get("original_request", user_reply)
            enhanced_request = f"{orig_req}\n\n{brief}"
            ui_set = state.get("ui_set", 1)

            confirm_md = (
                "### 🚀 Grilling Complete — Commencing Autonomous Build\n\n"
                f"All strategic design choices across {len(state.get('decisions', []))} key criteria have been locked and integrated into the master engineering directive.\n\n"
                f"**Selected Archetype**: Set {ui_set} — {UI_SKILL_SETS.get(ui_set, {}).get('name', 'UI Set')}\n"
                "**Active Design Directives**:\n"
            )
            for d in state.get("decisions", []):
                confirm_md += f"- **Round {d.get('round')} · {d.get('question_title', 'Directive')}**: Option {d.get('chosen_option_id')} — *{d.get('option_title')}*\n"
            confirm_md += "\nFirstmate and our specialized UI subagents are now taking over to construct, animate, and visually verify your interface."

            hist = load_session_history(session_id)
            hist_to_save = list(hist)
            hist_to_save.append({"role": "user", "parts": [{"text": user_reply}]})
            save_session_history(session_id, hist_to_save, confirm_md)

            emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
            emit("text", text=confirm_md)

            return run_lane_coding(
                enhanced_request,
                config,
                session_id,
                ui_set=ui_set,
                harness=effective_harness,
                model=effective_model,
            )

        elif is_continue:
            state["round"] = state.get("round", 1) + 1
            round_data = generate_grill_me_round(
                state.get("original_request", ""),
                state.get("ui_set", 1),
                state["round"],
                state.get("decisions", []),
                config,
                ref_analysis=state.get("ref_analysis"),
            )
            state["status"] = "awaiting_answers"
            state["questions"] = round_data["questions"]
            state["round_title"] = round_data.get("theme_title", f"Round {state['round']}")
            save_pending_grill_me(session_id, state)

            card_md = render_grill_me_questions_card(state)

            hist = load_session_history(session_id)
            hist_to_save = list(hist)
            hist_to_save.append({"role": "user", "parts": [{"text": user_reply}]})
            save_session_history(session_id, hist_to_save, card_md)

            emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
            emit("text", text=card_md)
            emit("done", ok=True, code=0, stopped=False)
            return 0

        else:
            reprompt = (
                "Please let me know how you'd like to proceed:\n\n"
                "1. **Proceed to Design & Build** (Stop grilling — let agents build this vision)\n"
                "2. **Continue Grilling** (Refine deeper into the next craft dimension)\n\n"
                "👉 Reply with **1** (or `proceed`) to build, or **2** (or `continue`) to keep grilling."
            )
            emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
            emit("text", text=reprompt)
            emit("done", ok=True, code=0, stopped=False)
            return 0

    # User is in "awaiting_answers" status (answering the question round)
    is_direct_proceed = (
        req_clean in ("proceed", "build", "stop", "stop grilling", "design", "make design", "start", "done", "ready", "go", "launch")
        or "proceed" in req_clean
        or "stop grilling" in req_clean
        or "build" in req_clean
    )

    parsed = parse_grill_answers(user_reply, state.get("questions", []))

    if not parsed and is_direct_proceed:
        # Proceed with whatever choices or creative freedom
        clear_pending_grill_me(session_id)
        brief = build_grill_me_design_brief(state)
        orig_req = state.get("original_request", user_reply)
        enhanced_request = f"{orig_req}\n\n{brief}"
        ui_set = state.get("ui_set", 1)

        confirm_md = (
            "### 🚀 Commencing Autonomous Build\n\n"
            f"Proceeding immediately to construction. All locked choices integrated into master engineering directive.\n\n"
            f"**Selected Archetype**: Set {ui_set} — {UI_SKILL_SETS.get(ui_set, {}).get('name', 'UI Set')}\n"
        )
        if state.get("decisions"):
            confirm_md += "**Active Design Directives**:\n"
            for d in state.get("decisions", []):
                confirm_md += f"- **Round {d.get('round')} · {d.get('question_title', 'Directive')}**: Option {d.get('chosen_option_id')} — *{d.get('option_title')}*\n"
        confirm_md += "\nFirstmate and our specialized UI subagents are now taking over in Herdr to construct, animate, and visually verify your interface."

        hist = load_session_history(session_id)
        hist_to_save = list(hist)
        hist_to_save.append({"role": "user", "parts": [{"text": user_reply}]})
        save_session_history(session_id, hist_to_save, confirm_md)

        emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
        emit("text", text=confirm_md)

        return run_lane_coding(
            enhanced_request,
            config,
            session_id,
            ui_set=ui_set,
            harness=effective_harness,
            model=effective_model,
        )

    if not parsed:
        reprompt = (
            "I didn't catch your selection. Please reply with the option numbers for each question "
            "(e.g. `question 1: 2, question 2: 3, question 3: 2` or `2, 3, 2` or `q1: 2, q2: 3`), "
            "type `skip` for full creative freedom, or type `proceed` to start building immediately."
        )
        emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
        emit("text", text=reprompt)
        emit("done", ok=True, code=0, stopped=False)
        return 0

    # Lock in user's choices
    remaining_questions = []
    for q in state.get("questions", []):
        qid = q["id"]
        if qid in parsed:
            opt_id = parsed[qid]
            opt = next((o for o in q.get("options", []) if o["id"] == opt_id), None)
            state.setdefault("decisions", []).append({
                "round": state.get("round", 1),
                "question_id": qid,
                "question_title": q.get("title", f"Question {qid}"),
                "chosen_option_id": opt_id,
                "option_title": opt.get("title", f"Option {opt_id}") if opt else f"Option {opt_id}",
                "desc": opt.get("desc", "") if opt else "",
            })
        else:
            remaining_questions.append(q)

    # Check if user explicitly asked for more questions / next round
    is_asking_more = any(kw in req_clean for kw in ("continue", "more questions", "next round", "keep grilling", "drill deeper", "dig deeper", "more grilling"))

    if not remaining_questions:
        if is_asking_more:
            # Advance to the next round of questions
            state["round"] = state.get("round", 1) + 1
            round_data = generate_grill_me_round(
                state.get("original_request", ""),
                state.get("ui_set", 1),
                state["round"],
                state.get("decisions", []),
                config,
                ref_analysis=state.get("ref_analysis"),
            )
            state["status"] = "awaiting_answers"
            state["questions"] = round_data["questions"]
            state["round_title"] = round_data.get("theme_title", f"Round {state['round']}")
            save_pending_grill_me(session_id, state)

            card_md = render_grill_me_questions_card(state)

            hist = load_session_history(session_id)
            hist_to_save = list(hist)
            hist_to_save.append({"role": "user", "parts": [{"text": user_reply}]})
            save_session_history(session_id, hist_to_save, card_md)

            emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
            emit("text", text=card_md)
            emit("done", ok=True, code=0, stopped=False)
            return 0

        # All questions in this round answered -> Commencing Autonomous Build immediately!
        clear_pending_grill_me(session_id)
        brief = build_grill_me_design_brief(state)
        orig_req = state.get("original_request", user_reply)
        enhanced_request = f"{orig_req}\n\n{brief}"
        ui_set = state.get("ui_set", 1)

        confirm_md = (
            "### 🚀 Grilling Complete — Commencing Autonomous Build\n\n"
            f"All strategic design choices across {len(state.get('decisions', []))} key criteria have been locked and integrated into the master engineering directive.\n\n"
            f"**Selected Archetype**: Set {ui_set} — {UI_SKILL_SETS.get(ui_set, {}).get('name', 'UI Set')}\n"
            "**Active Design Directives**:\n"
        )
        for d in state.get("decisions", []):
            confirm_md += f"- **Round {d.get('round')} · {d.get('question_title', 'Directive')}**: Option {d.get('chosen_option_id')} — *{d.get('option_title')}*\n"
        confirm_md += "\nFirstmate and our specialized UI subagents are now taking over in Herdr to construct, animate, and visually verify your interface."

        hist = load_session_history(session_id)
        hist_to_save = list(hist)
        hist_to_save.append({"role": "user", "parts": [{"text": user_reply}]})
        save_session_history(session_id, hist_to_save, confirm_md)

        emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
        emit("text", text=confirm_md)

        return run_lane_coding(
            enhanced_request,
            config,
            session_id,
            ui_set=ui_set,
            harness=effective_harness,
            model=effective_model,
        )

    else:
        # Some questions remain in this round
        state["questions"] = remaining_questions
        save_pending_grill_me(session_id, state)
        rem_q = remaining_questions[0]

        followup_md = (
            f"✅ **Locked Choice for {state['decisions'][-1]['question_title']}**: Option {state['decisions'][-1]['chosen_option_id']} (*{state['decisions'][-1]['option_title']}*)\n\n"
            f"Now please select **1**, **2**, or **3** for **{rem_q.get('title', 'Next Question')}**:\n\n"
            f"**{rem_q.get('question', '')}**\n\n"
