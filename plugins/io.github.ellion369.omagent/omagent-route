        for opt in rem_q.get("options", []):
            followup_md += f"{opt['id']}. **{opt['title']}**: {opt['desc']}\n"
        followup_md += "\n👉 **Reply with `1`, `2`, or `3` (or type `proceed` to build now).**"

        hist = load_session_history(session_id)
        hist_to_save = list(hist)
        hist_to_save.append({"role": "user", "parts": [{"text": user_reply}]})
        save_session_history(session_id, hist_to_save, followup_md)

        emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
        emit("text", text=followup_md)
        emit("done", ok=True, code=0, stopped=False)
        return 0


def register_firstmate_task(
    task_id: str, pane_id: str, workspace_id: str, cwd: Path, harness: str = "agy", model: str = "", role: str = "crewmate", skill: str = "ce-work"
) -> bool:
    """Registers task metadata with Firstmate so Firstmate supervisor tracks it under 'firstmate status' and steers it via 'firstmate send'."""
    try:
        FM_STATE_DIR.mkdir(parents=True, exist_ok=True)
        meta_path = FM_STATE_DIR / f"{task_id}.meta"
        content = (
            f"backend=herdr\n"
            f"endpoint_task_id={task_id}\n"
            f"herdr_session=default\n"
            f"herdr_workspace_id={workspace_id}\n"
            f"herdr_tab_id={workspace_id}:t1\n"
            f"herdr_pane_id={pane_id}\n"
            f"window=default:{pane_id}\n"
            f"project={cwd}\n"
            f"worktree={cwd}\n"
            f"harness={harness}\n"
            f"model={model}\n"
            f"role={role}\n"
            f"skill={skill}\n"
            f"kind=crewmate\n"
            f"mode=local-only\n"
            f"yolo=on\n"
        )
        meta_path.write_text(content, "utf-8")
        return True
    except Exception as e:
        if DEBUG:
            print(f"Error registering Firstmate task {task_id}: {e}", file=sys.stderr)
        return False


def unregister_firstmate_task(task_id: str) -> None:
    """Removes Firstmate task metadata and steering inbox on session cleanup."""
    if not FM_STATE_DIR.is_dir() or not task_id:
        return
    try:
        meta_path = FM_STATE_DIR / f"{task_id}.meta"
        status_file = FM_STATE_DIR / f"{task_id}.status"
        inbox_dir = FM_STATE_DIR / f"{task_id}.inbox"
        if meta_path.exists():
            meta_path.unlink()
        if status_file.exists():
            status_file.unlink()
        if inbox_dir.is_dir():
            shutil.rmtree(inbox_dir, ignore_errors=True)
    except Exception as e:
        if DEBUG:
            print(f"Error unregistering Firstmate task {task_id}: {e}", file=sys.stderr)


def cmd_list_sessions() -> int:
    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    sessions = []

    # Also check if last.json has an unsaved session with entries
    last_file = STATE_DIR / "last.json"
    if last_file.is_file():
        try:
            last_data = json.loads(last_file.read_text("utf-8"))
            last_id = last_data.get("sessionId")
            if last_id and not (SESSION_DIR / f"{last_id}.json").exists() and last_data.get("entries"):
                cmd_save_session(last_id)
        except Exception:
            pass

    for p in SESSION_DIR.glob("*.json"):
        if p.name.endswith((".history.json", ".fleet.json", ".ui_pending.json", ".uiset.json")):
            continue
        try:
            raw = p.read_text("utf-8")
            data = json.loads(raw)
            sid = p.stem
            title = ""
            agent_label = "Jarvis"
            agent_name = "jarvis"
            preview = ""
            updated_at = int(p.stat().st_mtime * 1000)
            msg_count = 0

            if isinstance(data, dict):
                sid = data.get("sessionId") or sid
                title = data.get("title", "")
                agent_label = data.get("agentLabel", "Jarvis")
                agent_name = data.get("agentName", "jarvis")
                updated_at = data.get("updatedAt") or updated_at
                entries = data.get("entries", [])
                msg_count = len(entries) if entries else len(data.get("history", []))

                # Check if dedicated history file has turns
                hf = SESSION_DIR / f"{sid}.history.json"
                if hf.is_file():
                    try:
                        h_data = json.loads(hf.read_text("utf-8"))
                        if isinstance(h_data, list):
                            msg_count = max(msg_count, len(h_data))
                    except Exception:
                        pass

                if not title:
                    for e in entries:
                        if e.get("rowKind") == "you":
                            title = e.get("rowText", "")
                            break
                    if not title and data.get("history"):
                        for h in data["history"]:
                            if h.get("role") == "user" and h.get("parts"):
                                title = h["parts"][0].get("text", "")
                                break
                for e in reversed(entries):
                    if e.get("rowKind") in ("text", "error"):
                        preview = clean_preview_text(e.get("rowText", ""))
                        break
                if not preview and data.get("history"):
                    for h in reversed(data["history"]):
                        if h.get("role") == "model" and h.get("parts"):
                            preview = clean_preview_text(h["parts"][0].get("text", ""))
                            break

            elif isinstance(data, list):
                msg_count = len(data)
                for item in data:
                    if item.get("role") == "user" and item.get("parts"):
                        title = item["parts"][0].get("text", "")
                        break
                for item in reversed(data):
                    if item.get("role") == "model" and item.get("parts"):
                        preview = clean_preview_text(item["parts"][0].get("text", ""))
                        break

            if not title:
                continue

            sessions.append({
                "id": sid,
                "title": clip(title, 75, collapse=True),
                "agentLabel": agent_label or "Jarvis",
                "agentName": agent_name or "jarvis",
                "timeAgo": format_time_ago(updated_at),
                "updatedAt": updated_at,
                "preview": preview,
                "messageCount": msg_count,
            })
        except Exception as e:
            if DEBUG:
                print(f"Error parsing session file {p}: {e}", file=sys.stderr)

    sessions.sort(key=lambda s: s["updatedAt"], reverse=True)
    print(json.dumps(sessions[:100]))
    return 0


