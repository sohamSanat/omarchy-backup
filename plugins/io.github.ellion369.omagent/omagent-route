def is_skip_or_refusal(text: str) -> bool:
    """Detects whether the user wants to skip questioning, refused to answer, or granted full creative freedom."""
    t = text.strip().lower()

    # Negative gate: if user specifically asks for continuation, it's not a skip/refusal
    if any(k in t for k in ("continue", "more question", "drill deeper", "keep grilling", "dig deeper", "refine")):
        return False

    exact_terms = {
        "skip", "pass", "refuse", "i refuse", "no", "nah", "nope",
        "neither", "none", "none of these", "no thanks",
        "you decide", "up to you", "your call", "your choice", "decide for me", "you pick",
        "creative freedom", "free hand", "full freedom", "take the wheel", "take over",
        "do whatever", "do what you want", "do what you think is best", "do anything",
        "do whatever you want", "on your own accord", "own accord", "surprise me",
        "stop asking", "stop grilling", "no more questions", "don't grill me", "dont grill me",
        "just build", "just make it", "build it", "start building", "proceed", "build"
    }
    if t in exact_terms:
        return True

    patterns = [
        r"\bskip\b",
        r"\bpass\b",
        r"\brefus\w*",
        r"\byou decide\b",
        r"\bup to you\b",
        r"\byour (call|choice)\b",
        r"\bcreative freedom\b",
        r"\bfree hand\b",
        r"\bdo (what you want|whatever|anything)\b",
        r"\b(own accord|accord)\b",
        r"\bstop (asking|grilling|questions)\b",
        r"\bno more (questions|grilling)\b",
        r"\b(don't|dont|do not) (ask|grill)\b",
        r"\bsurprise me\b",
        r"\bjust (build|make|code)\b",
    ]
    for p in patterns:
        if re.search(p, t):
            return True

    return False


