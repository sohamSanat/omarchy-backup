            f"export GEMINI_API_KEY={shlex.quote(config.get('gemini_api_key', ''))}; "
            f"pi --provider google --model {shlex.quote(coding_model)} --thinking {shlex.quote(thinking_level)} {skill_flag} {prompt_flag} "
            f"{shlex.quote(effective_task_prompt)}\n"
