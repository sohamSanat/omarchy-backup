def classify_intent(request: str, prior_agent: str = "") -> str:
    req_lower = request.strip().lower()

    # Explicit prefix overrides
    if req_lower.startswith(("/code ", "code: ", "@code ", "@dev ")):
        return LANE_CODE
    if req_lower.startswith(("/web ", "web: ", "/search ", "search: ", "@web ")):
        return LANE_WEB
    if req_lower.startswith(("/ask ", "ask: ", "@ask ")):
        return LANE_GENERAL

    if is_normal_coding_request(request):
        return LANE_CODE

    # Distinguish informational / conceptual queries from active coding tasks
    is_info = any(re.search(p, req_lower, re.IGNORECASE) for p in INFO_QUESTION_PATTERNS)
    has_code_action = any(re.search(p, req_lower, re.IGNORECASE) for p in CODE_ACTION_PATTERNS)

    if is_info and not has_code_action:
        # Check if the informational query needs live web search
        for pattern in WEB_INDICATORS:
            if re.search(pattern, req_lower, re.IGNORECASE):
                return LANE_WEB
        # Sticky lane: If continuing a web search session and query is a follow-up question
        if prior_agent == "jarvis-web" and not req_lower.startswith(("/ask", "ask:", "@ask", "/code", "code:", "@code")):
            return LANE_WEB
        return LANE_GENERAL

    # Regex heuristic check for code tasks
    for pattern in CODE_INDICATORS:
        if re.search(pattern, req_lower, re.IGNORECASE):
            return LANE_CODE

    for pattern in WEB_INDICATORS:
        if re.search(pattern, req_lower, re.IGNORECASE):
            return LANE_WEB

    # Sticky lane: If continuing a web session and user didn't explicitly override
    if prior_agent == "jarvis-web" and not req_lower.startswith(("/ask", "ask:", "@ask", "/code", "code:", "@code")):
        return LANE_WEB

    # Sticky lane: If continuing a coding session and user didn't explicitly override
    if (
        prior_agent in ("firstmate-pi", "antigravity-agy", "firstmate")
        or prior_agent.startswith(("firstmate", "antigravity", "omagent-failover"))
    ) and not req_lower.startswith(("/ask", "ask:", "@ask", "/web", "web:", "@web")):
        return LANE_CODE

    return LANE_GENERAL


def clean_prefix(request: str) -> str:
    for prefix in ["/code ", "code: ", "@code ", "@dev ", "/web ", "web: ", "@web ", "/search ", "search: ", "/ask ", "ask: ", "@ask "]:
        if request.lower().startswith(prefix):
            return request[len(prefix):].strip()
    return request.strip()


