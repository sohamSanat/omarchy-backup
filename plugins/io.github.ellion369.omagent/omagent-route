def register_firstmate_task(
    task_id: str, pane_id: str, workspace_id: str, cwd: Path, harness: str = "agy", model: str = "", role: str = "crewmate", skill: str = "ce-work"
) -> bool:
    """Registers task metadata with Firstmate so Firstmate supervisor tracks it under 'firstmate status' and steers it via 'firstmate send'."""
    try:
        FM_STATE_DIR.mkdir(parents=True, exist_ok=True)
        meta_path = FM_STATE_DIR / f"{task_id}.meta"
        content = (
            f"backend=herdr\n"
            f"endpoint_task_id={task_id}\n"
            f"herdr_session=default\n"
            f"herdr_workspace_id={workspace_id}\n"
            f"herdr_tab_id={workspace_id}:t1\n"
            f"herdr_pane_id={pane_id}\n"
            f"window=default:{pane_id}\n"
            f"project={cwd}\n"
            f"worktree={cwd}\n"
            f"harness={harness}\n"
            f"model={model}\n"
            f"role={role}\n"
            f"skill={skill}\n"
            f"kind=crewmate\n"
            f"mode=local-only\n"
            f"yolo=on\n"
        )
        meta_path.write_text(content, "utf-8")
        return True
    except Exception as e:
        if DEBUG:
            print(f"Error registering Firstmate task {task_id}: {e}", file=sys.stderr)
        return False


def unregister_firstmate_task(task_id: str) -> None:
    """Removes Firstmate task metadata and steering inbox on session cleanup."""
    if not FM_STATE_DIR.is_dir() or not task_id:
        return
    try:
        meta_path = FM_STATE_DIR / f"{task_id}.meta"
        status_file = FM_STATE_DIR / f"{task_id}.status"
        inbox_dir = FM_STATE_DIR / f"{task_id}.inbox"
        if meta_path.exists():
            meta_path.unlink()
        if status_file.exists():
            status_file.unlink()
        if inbox_dir.is_dir():
            shutil.rmtree(inbox_dir, ignore_errors=True)
    except Exception as e:
        if DEBUG:
            print(f"Error unregistering Firstmate task {task_id}: {e}", file=sys.stderr)


def cmd_list_sessions() -> int:
    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    sessions = []

    # Also check if last.json has an unsaved session with entries
    last_file = STATE_DIR / "last.json"
    if last_file.is_file():
        try:
            last_data = json.loads(last_file.read_text("utf-8"))
            last_id = last_data.get("sessionId")
            if last_id and not (SESSION_DIR / f"{last_id}.json").exists() and last_data.get("entries"):
                cmd_save_session(last_id)
        except Exception:
            pass

    for p in SESSION_DIR.glob("*.json"):
        if p.name.endswith((".history.json", ".fleet.json", ".ui_pending.json", ".uiset.json")):
            continue
        try:
            raw = p.read_text("utf-8")
            data = json.loads(raw)
            sid = p.stem
            title = ""
            agent_label = "Jarvis"
            agent_name = "jarvis"
            preview = ""
            updated_at = int(p.stat().st_mtime * 1000)
            msg_count = 0

            if isinstance(data, dict):
                sid = data.get("sessionId") or sid
                title = data.get("title", "")
                agent_label = data.get("agentLabel", "Jarvis")
                agent_name = data.get("agentName", "jarvis")
                updated_at = data.get("updatedAt") or updated_at
                entries = data.get("entries", [])
                msg_count = len(entries) if entries else len(data.get("history", []))

                # Check if dedicated history file has turns
                hf = SESSION_DIR / f"{sid}.history.json"
                if hf.is_file():
                    try:
                        h_data = json.loads(hf.read_text("utf-8"))
                        if isinstance(h_data, list):
                            msg_count = max(msg_count, len(h_data))
                    except Exception:
                        pass

                if not title:
                    for e in entries:
                        if e.get("rowKind") == "you":
                            title = e.get("rowText", "")
                            break
                    if not title and data.get("history"):
                        for h in data["history"]:
                            if h.get("role") == "user" and h.get("parts"):
                                title = h["parts"][0].get("text", "")
                                break
                for e in reversed(entries):
                    if e.get("rowKind") in ("text", "error"):
                        preview = clean_preview_text(e.get("rowText", ""))
                        break
                if not preview and data.get("history"):
                    for h in reversed(data["history"]):
                        if h.get("role") == "model" and h.get("parts"):
                            preview = clean_preview_text(h["parts"][0].get("text", ""))
                            break

            elif isinstance(data, list):
                msg_count = len(data)
                for item in data:
                    if item.get("role") == "user" and item.get("parts"):
                        title = item["parts"][0].get("text", "")
                        break
                for item in reversed(data):
                    if item.get("role") == "model" and item.get("parts"):
                        preview = clean_preview_text(item["parts"][0].get("text", ""))
                        break

            if not title:
                continue

            sessions.append({
                "id": sid,
                "title": clip(title, 75, collapse=True),
                "agentLabel": agent_label or "Jarvis",
                "agentName": agent_name or "jarvis",
                "timeAgo": format_time_ago(updated_at),
                "updatedAt": updated_at,
                "preview": preview,
                "messageCount": msg_count,
            })
        except Exception as e:
            if DEBUG:
                print(f"Error parsing session file {p}: {e}", file=sys.stderr)

    sessions.sort(key=lambda s: s["updatedAt"], reverse=True)
    print(json.dumps(sessions[:100]))
    return 0


def cmd_get_session(session_id: str) -> int:
    session_file = SESSION_DIR / f"{session_id}.json"
    history_file = SESSION_DIR / f"{session_id}.history.json"
    if not session_file.is_file():
        last_file = STATE_DIR / "last.json"
        if last_file.is_file():
            try:
                state = json.loads(last_file.read_text("utf-8"))
                if state.get("sessionId") == session_id:
                    print(json.dumps(state))
                    return 0
            except Exception:
                pass
        print(json.dumps({}))
        return 1

    try:
        data = json.loads(session_file.read_text("utf-8"))
        if isinstance(data, dict):
            if history_file.is_file() and (not data.get("history") or len(data.get("history", [])) == 0):
                try:
                    data["history"] = json.loads(history_file.read_text("utf-8"))
                except Exception:
                    pass
            if not data.get("entries") and data.get("history"):
                entries = []
                for turn in data["history"]:
                    role = turn.get("role")
                    parts = turn.get("parts", [{}])
                    txt = parts[0].get("text", "") if parts else ""
                    if role == "user":
                        entries.append({"rowKind": "you", "rowText": txt, "rowCount": 1, "rowLines": txt, "rowExpanded": False, "rowAuto": False})
                    elif role == "model":
                        entries.append({"rowKind": "text", "rowText": txt, "rowCount": 1, "rowLines": txt, "rowExpanded": False, "rowAuto": False})
                data["entries"] = entries
            if "version" not in data:
                data["version"] = 1
            if "agentName" not in data:
                data["agentName"] = "jarvis"
            if "agentLabel" not in data:
                data["agentLabel"] = "Jarvis"
            if "sessionId" not in data:
                data["sessionId"] = session_id
        elif isinstance(data, list):
            entries = []
            for turn in data:
                role = turn.get("role")
                parts = turn.get("parts", [{}])
                txt = parts[0].get("text", "") if parts else ""
                if role == "user":
                    entries.append({"rowKind": "you", "rowText": txt, "rowCount": 1, "rowLines": txt, "rowExpanded": False, "rowAuto": False})
                elif role == "model":
                    entries.append({"rowKind": "text", "rowText": txt, "rowCount": 1, "rowLines": txt, "rowExpanded": False, "rowAuto": False})
            data = {
                "version": 1,
                "sessionId": session_id,
                "agentName": "jarvis",
                "agentLabel": "Jarvis",
                "entries": entries,
                "history": data,
                "updatedAt": int(session_file.stat().st_mtime * 1000)
            }
        print(json.dumps(data))
        return 0
    except Exception as e:
        if DEBUG:
            print(f"Error loading session {session_id}: {e}", file=sys.stderr)
        print(json.dumps({}))
        return 1


def cmd_save_session(session_id: str) -> int:
    if not session_id:
        print(json.dumps({"ok": False, "error": "Missing session ID"}))
        return 1

    SESSION_DIR.mkdir(parents=True, exist_ok=True)
    session_file = SESSION_DIR / f"{session_id}.json"
    history_file = SESSION_DIR / f"{session_id}.history.json"
    last_file = STATE_DIR / "last.json"

    data: dict = {}
    if session_file.is_file():
        try:
            existing = json.loads(session_file.read_text("utf-8"))
            if isinstance(existing, dict):
                data = existing
        except Exception:
            pass

    if last_file.is_file():
        try:
            last_state = json.loads(last_file.read_text("utf-8"))
            if isinstance(last_state, dict) and last_state.get("sessionId") == session_id:
                for key in ("entries", "agentName", "agentLabel", "agentCwd", "resumeLabel",
                            "resumeArgv", "priorTokens", "priorCost", "sawCost", "elapsedMs", "title"):
                    if key in last_state:
                        data[key] = last_state[key]
        except Exception as e:
            if DEBUG:
                print(f"Error merging last.json for session {session_id}: {e}", file=sys.stderr)

    data["sessionId"] = session_id
    data["updatedAt"] = int(time.time() * 1000)

    if history_file.is_file() and not data.get("history"):
        try:
            data["history"] = json.loads(history_file.read_text("utf-8"))
        except Exception:
            pass

    if "title" not in data or not data["title"]:
        entries = data.get("entries", [])
        for e in entries:
            if e.get("rowKind") == "you":
                data["title"] = clip(e.get("rowText", ""), 80, collapse=True)
                break

    try:
        session_file.write_text(json.dumps(data, indent=2), "utf-8")
        print(json.dumps({"ok": True}))
        return 0
    except Exception as e:
        print(json.dumps({"ok": False, "error": str(e)}))
        return 1


def cmd_delete_session(session_id: str) -> int:
    if not session_id:
        print(json.dumps({"ok": False, "error": "Missing session ID"}))
        return 1

    fleet_file = SESSION_DIR / f"{session_id}.fleet.json"
    if fleet_file.is_file():
        try:
            fleet_data = json.loads(fleet_file.read_text("utf-8"))
            fm_task = fleet_data.get("fmTaskId")
            if fm_task:
                unregister_firstmate_task(fm_task)
            fm_rev = fleet_data.get("fmRevTaskId")
            if fm_rev:
                unregister_firstmate_task(fm_rev)
            rev_pane = fleet_data.get("herdrRevPaneId")
            if rev_pane:
                try:
                    subprocess.run(["herdr", "pane", "close", rev_pane], capture_output=True, timeout=2)
                except Exception:
                    pass
            fleet_file.unlink()
        except Exception as e:
            if DEBUG:
                print(f"Error deleting fleet file: {e}", file=sys.stderr)

    session_file = SESSION_DIR / f"{session_id}.json"
    if session_file.is_file():
        try:
            session_file.unlink()
        except Exception as e:
            if DEBUG:
                print(f"Error deleting session file: {e}", file=sys.stderr)

    history_file = SESSION_DIR / f"{session_id}.history.json"
    if history_file.is_file():
        try:
            history_file.unlink()
        except Exception as e:
            if DEBUG:
                print(f"Error deleting history file: {e}", file=sys.stderr)

    clear_pending_ui_question(session_id)
    ui_set_file = SESSION_DIR / f"{session_id}.uiset.json"
    if ui_set_file.is_file():
        try:
            ui_set_file.unlink()
        except Exception as e:
            if DEBUG:
                print(f"Error deleting uiset file: {e}", file=sys.stderr)

    last_file = STATE_DIR / "last.json"
    if last_file.is_file():
        try:
            data = json.loads(last_file.read_text("utf-8"))
            if data.get("sessionId") == session_id:
                data["entries"] = []
                data["sessionId"] = ""
                data["agentName"] = ""
                data["agentLabel"] = ""
                data["title"] = ""
