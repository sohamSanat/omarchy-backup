        if proc_running and not is_swapped:
            time.sleep(0.3)
            subprocess.run(["herdr", "pane", "send-text", pane_id, f"{doorbell}\n"], capture_output=True, text=True, timeout=3)
            emit("text", text="• **Crew Alerted**: Doorbell rung in active Herdr pane\n")
        else:
            if is_swapped and swapped_harness:
                if stored_provider == "opencode":
                    relaunch_cmd = f"opencode run -m {shlex.quote(chosen_model)} {shlex.quote(doorbell)}\n"
                elif stored_provider == "cline":
                    thinking_flag = "--thinking medium " if "muse-spark" in chosen_model else ""
                    relaunch_cmd = f"cline --auto-approve true {thinking_flag}-m {shlex.quote(chosen_model)} {shlex.quote(doorbell)}\n"
                else:
                    relaunch_cmd = f"agy --model {shlex.quote(chosen_model)} --dangerously-skip-permissions -i {shlex.quote(doorbell)}\n"
            else:
                if is_agy:
                    relaunch_cmd = f"agy --continue --model {shlex.quote(chosen_model)} --dangerously-skip-permissions -i {shlex.quote(doorbell)}\n"
                elif stored_provider == "opencode":
                    relaunch_cmd = f"opencode run -m {shlex.quote(chosen_model)} -c {shlex.quote(doorbell)}\n"
                elif stored_provider == "cline":
                    thinking_flag = "--thinking medium " if "muse-spark" in chosen_model else ""
                    relaunch_cmd = f"cline --auto-approve true {thinking_flag}-m {shlex.quote(chosen_model)} {shlex.quote(doorbell)}\n"
                else:
                    relaunch_cmd = f"agy --continue --dangerously-skip-permissions -i {shlex.quote(doorbell)}\n"

            subprocess.run(["herdr", "pane", "send-text", pane_id, relaunch_cmd], capture_output=True, text=True, timeout=3)
            emit("text", text=f"• **Session Resumed**: Re-engaged crewmate ({target_meta['display_name']}) in Herdr pane\n")

    # Monitor execution in Herdr and emit clean live highlights
    start_monitor = time.time()
    seen_actions: set[str] = set()

    # Runtime watchdog state for failover panes (kilo/opencode/cline):
    # transient errors get a 'continue' nudge; persistent/daily-quota errors
    # switch to the best verified model on the same provider mid-run.
    wd_state: dict = {"nudges": 0, "last_nudge_at": 0, "model": fb_model} if is_failover else {}
    wd_announced: set[str] = set()
    wd_relaunch_at = 0.0

    tracked_files_created: list[str] = []
    tracked_files_edited: list[str] = []
    tracked_commands: list[str] = []
    tracked_summaries: list[str] = []

    time.sleep(0.8)

    # Set a generous 10-minute monitoring budget so complex tasks aren't prematurely abandoned
    monitor_budget = 600.0 if is_agy else (900.0 if (is_failover and pane_id) else 300.0)
    agent_active_observed = False
    consecutive_idle_ticks = 0
    lead_renamed = False
    last_agent_check = 0.0

    while time.time() - start_monitor < monitor_budget:
        if not active_session_file:
            if is_failover:
                # Failover harnesses (kilo/opencode/cline) run non-interactive one
                # shots; no agy/Pi transcript to tail. Watchdog watches the pane
                # for rate-limit / daily-quota errors and recovers mid-run.
                if pane_id and _harness_pool is not None:
                    try:
                        wd_action = _harness_pool.runtime_watchdog_tick(fb_provider, pane_id, config, wd_state)
                        if wd_action.get("action") == "nudged" and "nudge" not in wd_announced:
                            wd_announced.add("nudge")
                            emit("text", text=f"• **Recovering** from rate limit: sending resume signal\n")
                        elif wd_action.get("action") == "switch":
                            new_model = wd_action.get("new_model")
                            if new_model:
                                wd_state["model"] = new_model
                                fb_model = new_model
                                seen_actions.add("wd_switched")
                                emit("text", text=f"• **Error persistent on failover model** — switching to `{new_model}`\n")
                    except Exception as e:
                        if DEBUG:
                            print(f"watchdog tick error: {e}", file=sys.stderr)
            elif is_agy:
                cand = resolve_agy_session_file(pane_id, launch_time)
                if cand and cand.is_file():
                    active_session_file = cand
            else:
                cand = get_latest_pi_session_file(cwd)
                if cand and cand.is_file():
                    active_session_file = cand

        # Poll Herdr native agent status across ALL workspace crewmates for authoritative completion signal
        now = time.time()
        if (ws_id or pane_id) and (now - last_agent_check >= 1.5):
            last_agent_check = now
            try:
                p_ag = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True, timeout=2)
                agents_in_ws = []
                if p_ag.returncode == 0:
                    all_ag = json.loads(p_ag.stdout).get("result", {}).get("agents", [])
                    agents_in_ws = [a for a in all_ag if a.get("workspace_id") == ws_id] if ws_id else all_ag

                if not agents_in_ws and pane_id:
                    p_get = subprocess.run(["herdr", "pane", "get", pane_id], capture_output=True, text=True, timeout=2)
                    if p_get.returncode == 0:
                        agents_in_ws = [json.loads(p_get.stdout).get("result", {}).get("pane", {})]

                any_working = any(a.get("agent_status") == "working" for a in agents_in_ws)
                all_idle = bool(agents_in_ws) and all(a.get("agent_status") in ("idle", "done") for a in agents_in_ws)

                # Check if foreground process is actively running in primary pane
                primary_proc_running = False
                if pane_id:
                    p_proc = subprocess.run(["herdr", "pane", "process-info", "--pane", pane_id], capture_output=True, text=True, timeout=2)
                    if p_proc.returncode == 0:
                        p_info = json.loads(p_proc.stdout).get("result", {}).get("process_info", {})
                        fg_procs = [p.get("name") for p in p_info.get("foreground_processes", [])]
                        target_proc = "agy" if is_agy else (fb_provider if is_failover else "pi")
                        if any(target_proc in p for p in fg_procs):
                            primary_proc_running = True

                if any_working or primary_proc_running:
                    agent_active_observed = True
                    consecutive_idle_ticks = 0
                elif all_idle and agent_active_observed:
                    consecutive_idle_ticks += 1
                    # Require 3 consecutive cycles (~4.5s) of steady idle across all workspace crewmates
                    if consecutive_idle_ticks >= 3:
                        time.sleep(1.0)
                        if active_session_file and active_session_file.is_file():
                            try:
                                with open(active_session_file, "r", encoding="utf-8", errors="ignore") as f:
                                    f.seek(read_offset)
                                    rem_lines = f.readlines()
                                    read_offset = f.tell()
                                for line in rem_lines:
                                    line_str = line.strip()
                                    if not line_str:
                                        continue
                                    try:
                                        evt = json.loads(line_str)
                                        if evt.get("type") == "PLANNER_RESPONSE":
                                            cnt = evt.get("content")
                                            if isinstance(cnt, str) and cnt.strip() and cnt.strip() not in tracked_summaries:
                                                tracked_summaries.append(cnt.strip())
                                    except Exception:
                                        pass
                            except Exception:
                                pass

                        # Send enter to primary pane to dismiss any interactive feedback survey
                        if pane_id and is_agy:
                            try:
                                subprocess.run(["herdr", "pane", "send-text", pane_id, "\n"], capture_output=True, timeout=2)
                            except Exception:
                                pass

                        seen_actions.add("done")
                        break
                else:
                    consecutive_idle_ticks = 0
            except Exception:
                pass

        if not lead_renamed and pane_id and lead_agent_name and agent_active_observed:
            try:
                subprocess.run(["herdr", "agent", "rename", pane_id, lead_agent_name], capture_output=True, timeout=2)
                lead_renamed = True
            except Exception:
                pass

        if active_session_file and active_session_file.is_file():
            try:
                with open(active_session_file, "r", encoding="utf-8", errors="ignore") as f:
                    f.seek(read_offset)
                    new_lines = f.readlines()
                    read_offset = f.tell()

                for line in new_lines:
                    line_str = line.strip()
                    if not line_str:
                        continue
                    try:
                        evt = json.loads(line_str)
                    except Exception:
                        continue

                    if is_agy:
                        agent_active_observed = True
                        # Parse Antigravity transcript format
                        tool_calls = evt.get("tool_calls", [])
                        for tc in tool_calls:
                            name = tc.get("name") or "tool"
                            args = tc.get("args") or {}
                            if name == "write_to_file":
                                target = short_path(str(args.get("TargetFile") or "").strip('"\'' ))
                                emit("tool", text=f"Wrote {target}")
                                raw_p = str(args.get("TargetFile") or "").strip('"\'' )
                                if raw_p and raw_p not in tracked_files_created:
                                    tracked_files_created.append(raw_p)
                                if ".lavish" in target and target.endswith(".html"):
                                    clean_p = Path(str(args.get("TargetFile"))).resolve()
                                    if f"lavish_{clean_p.name}" not in seen_actions:
                                        seen_actions.add(f"lavish_{clean_p.name}")
                                        emit("text", text=f"• **Visual Artifact**: [Open Review Surface](file://{clean_p})\n")
                            elif name == "replace_file_content":
                                target = short_path(str(args.get("TargetFile") or "").strip('"\'' ))
                                emit("tool", text=f"Edited {target}")
                                raw_p = str(args.get("TargetFile") or "").strip('"\'' )
                                if raw_p and raw_p not in tracked_files_edited:
                                    tracked_files_edited.append(raw_p)
                            elif name == "run_command":
                                raw_cmd = str(args.get("CommandLine") or "").strip('"\'' )
                                cmd = clip(raw_cmd, 60)
                                emit("tool", text=f"Ran {cmd}")
                                if "firstmate" in raw_cmd and ("subagent" in raw_cmd or "spawn" in raw_cmd or "prompt" in raw_cmd):
                                    emit("text", text=f"• **Fleet Subagent Dispatched**: `{clip(raw_cmd, 90)}`\n")
                                if raw_cmd and raw_cmd not in tracked_commands:
                                    tracked_commands.append(clip(raw_cmd, 120))
                            elif name in ("view_file", "read_url_content"):
                                raw_p = str(args.get("AbsolutePath") or args.get("Url") or "").strip('"\'' )
                                target = short_path(raw_p)
                                emit("tool", text=f"Read {target}")
                            elif name in ("grep_search", "find_by_name"):
                                q = clip(str(args.get("Query") or args.get("Pattern") or "").strip('"\'' ), 40)
                                emit("tool", text=f"Searched {q}")
                            elif name == "invoke_subagent":
                                emit("tool", text="Invoked subagent review")
                            else:
                                emit("tool", text=f"Executed {name}")

                        # Stream planner response text to card if present
                        if evt.get("type") == "PLANNER_RESPONSE":
                            content = evt.get("content")
                            if isinstance(content, str) and content.strip():
                                clean_content = content.strip()
                                if clean_content not in tracked_summaries:
                                    tracked_summaries.append(clean_content)
                                    emit("text", text=clip(clean_content, 1000) + "\n")
                    else:
                        # Parse Pi session JSONL format
                        msg = evt.get("message", {})
                        content = msg.get("content", [])
                        if isinstance(content, list):
                            for part in content:
                                if part.get("type") == "text":
                                    p_txt = str(part.get("text") or "").strip()
                                    if p_txt and p_txt not in tracked_summaries:
                                        tracked_summaries.append(p_txt)
                                elif part.get("type") == "toolCall":
                                    agent_active_observed = True
                                    name = part.get("name")
                                    args = part.get("args") or {}
                                    if name == "read":
                                        p = str(args.get("path") or args.get("file") or "")
                                        if "skills" in p or "SKILL.md" in p:
                                            s_name = Path(p).parent.name if "SKILL.md" in p else Path(p).name
                                            if f"skill_{s_name}" not in seen_actions:
                                                seen_actions.add(f"skill_{s_name}")
                                                emit("text", text=f"• **Applying** Compound Engineering methodology ({s_name})\n")
                                        elif ("solutions" in p or "learnings" in p) and "learnings_read" not in seen_actions:
                                            seen_actions.add("learnings_read")
                                            emit("text", text="• **Recalling** prior repository learnings & conventions\n")
                                        elif "inspect" not in seen_actions:
                                            seen_actions.add("inspect")
                                            emit("text", text="• **Now doing** codebase & file inspection\n")
                                    elif name in ("find", "ls", "grep") and "inspect" not in seen_actions:
                                        seen_actions.add("inspect")
                                        emit("text", text="• **Now doing** codebase & file inspection\n")
                                    elif name in ("write", "edit"):
                                        p = str(args.get("path") or args.get("file") or args.get("target") or "").strip('"\'' )
                                        if p:
                                            if name == "write" and p not in tracked_files_created:
                                                tracked_files_created.append(p)
                                            elif name == "edit" and p not in tracked_files_edited:
                                                tracked_files_edited.append(p)
                                        if ".lavish" in p and p.endswith(".html"):
                                            clean_p = Path(p).resolve()
                                            if f"lavish_{clean_p.name}" not in seen_actions:
                                                seen_actions.add(f"lavish_{clean_p.name}")
                                                emit("text", text=f"• **Visual Artifact**: [Open Review Surface](file://{clean_p})\n")
                                        elif "impl" not in seen_actions:
                                            seen_actions.add("impl")
                                            emit("text", text="• **Doing** code changes & implementation\n")
                                    elif name == "bash":
                                        cmd_str = str(args.get("command") or args.get("cmd") or "").strip('"\'' )
                                        if cmd_str and cmd_str not in tracked_commands:
                                            tracked_commands.append(clip(cmd_str, 120))
                                        if any(k in cmd_str for k in ("git diff", "code-review", "review")) and "review_pass" not in seen_actions:
                                            seen_actions.add("review_pass")
                                            emit("text", text="• **Now doing** dual-agent code review & verification\n")
                                        elif any(k in cmd_str for k in ("ce-compound", "solutions/")) and "compound_pass" not in seen_actions:
                                            seen_actions.add("compound_pass")
                                            emit("text", text="• **Compounding** durable repository learning for future runs\n")
                                        elif "lavish-axi" in cmd_str:
                                            m_html = re.search(r"(\S+\.html)", cmd_str)
                                            if m_html and "lavish_cmd" not in seen_actions:
                                                seen_actions.add("lavish_cmd")
                                                clean_p = Path(m_html.group(1)).resolve()
                                                emit("text", text=f"• **Visual Artifact**: [Open Review Surface](file://{clean_p})\n")
                                        elif "exec" not in seen_actions:
                                            seen_actions.add("exec")
                                            emit("text", text="• **Now doing** test & command execution\n")
                        if msg.get("stopReason") in ("stop", "endTurn"):
                            seen_actions.add("done")
                            break
            except Exception:
                pass

        if "done" in seen_actions:
            break

        if "wd_switched" in seen_actions and fb_model and _harness_pool is not None:
            # Mid-run model switch: relaunch the SAME task with the new model
            # in the same pane, then stop watchdogging (one switch per run).
            try:
                relaunch = _harness_pool.build_launch_cmd(fb_provider, fb_model, effective_task_prompt)
                subprocess.run(["herdr", "pane", "send-text", pane_id, relaunch],
                               capture_output=True, text=True, timeout=5)
                wd_relaunch_at = time.time()
                emit("text", text=f"• **Redoing** task dispatch on `{fb_model}`\n")
            except Exception as e:
                if DEBUG:
                    print(f"watchdog relaunch failed: {e}", file=sys.stderr)
            seen_actions.discard("wd_switched")
            seen_actions.add("wd_relaunched")

        if pane_id:
            try:
                if is_failover:
                    p_res = subprocess.run(
                        ["herdr", "pane", "process-info", "--pane", pane_id],
                        capture_output=True, text=True, timeout=2,
                    )
                    if p_res.returncode == 0:
                        p_data = json.loads(p_res.stdout).get("result", {}).get("process_info", {})
                        procs = [p.get("name") for p in p_data.get("foreground_processes", [])]
                        if fb_provider and fb_provider not in procs and (time.time() - start_monitor > 3.0):
                            _now = time.time()
                            _last_nudge = float(wd_state.get("last_nudge_at") or 0)
                            _recovering = (
                                "wd_switched" in seen_actions
                                or (_now - wd_relaunch_at < 20.0 if wd_relaunch_at else False)
                                or (_last_nudge and (_now - _last_nudge) < 30.0)
                            )
                            if not _recovering:
                                break
                else:
                    p_chk = subprocess.run(["herdr", "pane", "get", pane_id], capture_output=True, text=True, timeout=2)
                    if p_chk.returncode != 0 and (time.time() - start_monitor > 5.0):
                        seen_actions.add("done")
                        break
            except Exception:
                pass

        time.sleep(0.7)

    # Post-monitor reconciliation safety net: ensure completion isn't missed on timeout or buffer delay
    if "done" not in seen_actions and active_session_file and active_session_file.is_file():
        try:
            with open(active_session_file, "r", encoding="utf-8", errors="ignore") as f:
                f.seek(read_offset)
                rem_lines = f.readlines()
            for line in rem_lines:
                line_str = line.strip()
                if not line_str:
                    continue
                try:
                    evt = json.loads(line_str)
                    if evt.get("type") == "PLANNER_RESPONSE":
                        cnt = evt.get("content")
                        if isinstance(cnt, str) and cnt.strip() and cnt.strip() not in tracked_summaries:
                            tracked_summaries.append(cnt.strip())
                        if evt.get("status") == "DONE":
                            seen_actions.add("done")
                except Exception:
                    pass
        except Exception:
            pass

    if "done" not in seen_actions and pane_id:
        try:
            p_res = subprocess.run(["herdr", "pane", "get", pane_id], capture_output=True, text=True, timeout=2)
            if p_res.returncode == 0:
                p_info = json.loads(p_res.stdout).get("result", {}).get("pane", {})
                st = p_info.get("agent_status")
                if st in ("idle", "done"):
                    seen_actions.add("done")
        except Exception:
            pass

    # Safety check: inspect cwd for files created or modified since start of monitoring
    if cwd.is_dir():
        try:
            for f in cwd.rglob("*"):
                if f.is_file() and not any(part.startswith((".", "node_modules", ".git", "venv", "__pycache__")) for part in f.parts):
                    try:
                        if f.stat().st_mtime >= start_monitor - 5.0:
                            s = str(f)
                            if s not in tracked_files_created and s not in tracked_files_edited:
                                tracked_files_created.append(s)
                    except Exception:
                        pass
        except Exception:
            pass

    if tracked_files_created or tracked_files_edited:
        seen_actions.add("done")

    # Emit prominent completion banner & full summary to Omagent card
    if "done" in seen_actions:
        if is_subsequent_turn:
            emit("text", text=f"• **Task Complete** — Completed modification via Firstmate ({primary_skill})\n\n")
        else:
            emit("text", text=f"• **Task Complete** — Completed {primary_skill} execution via Firstmate\n\n")

        if tracked_summaries:
            emit("text", text=f"{tracked_summaries[-1]}\n\n")
        else:
            if tracked_files_created:
                emit("text", text="**Files Created:**\n" + "\n".join(f"- `{short_path(f)}`" for f in list(dict.fromkeys(tracked_files_created))[:10]) + "\n\n")
            if tracked_files_edited:
                emit("text", text="**Files Modified:**\n" + "\n".join(f"- `{short_path(f)}`" for f in list(dict.fromkeys(tracked_files_edited))[:10]) + "\n\n")

        # Direct links to open HTML previews
        all_created_or_edited = tracked_files_created + tracked_files_edited
        html_files = [f for f in all_created_or_edited if f.endswith(".html")]
        if not html_files and cwd.is_dir():
            for cand_h in cwd.glob("*.html"):
                html_files.append(str(cand_h))
        if html_files:
            for hf in list(dict.fromkeys(html_files))[:3]:
                clean_hf = Path(hf).resolve()
                emit("text", text=f"• **Preview Webpage**: [Open {clean_hf.name}]({clean_hf.as_uri()})\n")
    else:
        emit("text", text=f"• **Task continuing in background** in Herdr under Firstmate ({primary_skill})\n")
        emit("text", text="• Firstmate is active on the bridge: you can ask questions or queue next tasks anytime.\n")

    # Update fleet_info cwd if project created inside a subfolder
    if tracked_files_created:
        try:
            first_p = Path(tracked_files_created[0]).resolve()
            if first_p.is_file():
                parent_d = first_p.parent
                stored_fleet = get_session_fleet(session_id)
                if stored_fleet and parent_d != cwd and parent_d.is_dir():
                    stored_fleet["cwd"] = str(parent_d)
                    save_session_fleet(session_id, stored_fleet)
        except Exception:
            pass

    # Construct comprehensive agent response for conversation memory
    summary_parts = []
    if tracked_summaries:
        summary_parts.append(tracked_summaries[-1])
    else:
        summary_parts.append(f"Completed coding task ({primary_skill}) in Herdr workspace '{ws_label}'.")

    if tracked_files_created:
        summary_parts.append("**Files Created:**\n" + "\n".join(f"- `{f}`" for f in list(dict.fromkeys(tracked_files_created))[:10]))
    if tracked_files_edited:
        summary_parts.append("**Files Modified:**\n" + "\n".join(f"- `{f}`" for f in list(dict.fromkeys(tracked_files_edited))[:10]))
    if tracked_commands:
        summary_parts.append("**Key Commands Executed:**\n" + "\n".join(f"- `{c}`" for c in tracked_commands[:5]))

    final_coding_msg = "\n\n".join(summary_parts)

    # Save the coding task turn so subsequent follow-ups in any lane retain context
    history_to_save = list(history)
    history_to_save.append({"role": "user", "parts": [{"text": task_prompt}]})
    save_session_history(
        session_id,
        history_to_save,
        final_coding_msg
    )

    emit("text", text="\n*Press Ctrl+E or click 'Expand in Herdr' to view terminal.*")
    emit("done", ok=True, code=0, stopped=False)
    return 0


# =====================================================================
# MAIN ROUTER ENTRYPOINT
# =====================================================================

def route_request(raw_request: str, *, session: str = "", agent: str = "", mode: str = "", harness: str = "", model: str = "") -> int:
    extend_path()
    config = load_config()

    if len(raw_request) > MAX_REQUEST_CHARS:
        emit("error", text=f"Requests are limited to {MAX_REQUEST_CHARS} characters")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    request = raw_request.strip()
    if not request:
        emit("error", text="Request is empty")
        emit("done", ok=False, code=1, stopped=False)
        return 1

    session_id = session or str(uuid.uuid4())
    pending_ui = get_pending_ui_question(session_id)
    fleet_info = get_session_fleet(session_id)

    # 1. Check if user is replying to a pending UI Archetype selection
    if pending_ui:
        choice = parse_ui_set_choice(request)
        if choice in (1, 2, 3):
            clear_pending_ui_question(session_id)
            save_session_ui_set(session_id, choice)
            orig_req = pending_ui.get("original_request", request)
            saved_harness = harness or pending_ui.get("harness", "")
            saved_model = model or pending_ui.get("model", "")

            # Record choice turn into conversation history so chat displays the selection
            hist = load_session_history(session_id)
            hist_to_save = list(hist)
            hist_to_save.append({"role": "user", "parts": [{"text": request}]})
            set_meta = UI_SKILL_SETS[choice]
            save_session_history(session_id, hist_to_save, f"Selected UI Archetype: Set {choice} — {set_meta['name']}")

            return run_lane_coding(orig_req, config, session_id, ui_set=choice, harness=saved_harness, model=saved_model)
        elif request.lower().strip() in ("cancel", "exit", "abort", "quit", "stop"):
            clear_pending_ui_question(session_id)
            emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
            emit("text", text="UI design selection cancelled. Let me know what you'd like to work on instead!")
            emit("done", ok=True, code=0, stopped=False)
            return 0
        else:
            # Re-prompt user cleanly to pick 1, 2, or 3
            emit("agent", name="firstmate", label="Firstmate · UI Design Director", session=session_id, cwd=str(work_dir()), resume=["omarchy-launch-terminal", "herdr"], resumeLabel="Expand in Herdr", pid=0)
            emit(
                "text",
                text=(
                    f"Please choose which design archetype to guide your UI:\n\n"
                    f"- **1**: Full Aesthetic (`Set 1`) — Linear / Stripe Press craft\n"
                    f"- **2**: SaaS / Product App (`Set 2`) — High-density dashboards & design systems\n"
                    f"- **3**: Jaw-Dropping / 3D Showcase (`Set 3`) — Awwwards 3D WebGL & kinetic motion\n\n"
                    f"👉 Reply with **1**, **2**, or **3** in this chat box, or type **cancel** to abort."
                ),
            )
            emit("done", ok=True, code=0, stopped=False)
            return 0

    mode_clean = (mode or "").lower().strip()

    # Manual mode overrides:
    # 1. Mode: 'regular' -> Direct internal knowledge (Lane 1)
    if mode_clean == "regular":
        if request.lower().startswith(("/web ", "web: ", "/search ", "search: ", "@web ")):
            return run_lane_web(request, config, session_id)
        if request.lower().startswith(("/code ", "code: ", "@code ", "@dev ")):
            return run_lane_coding(request, config, session_id, harness=harness, model=model)
        return run_lane_general(request, config, session_id)

    # 2. Mode: 'internet' -> Live web search (Lane 2)
    elif mode_clean == "internet":
        if request.lower().startswith(("/ask ", "ask: ", "@ask ")):
            return run_lane_general(request, config, session_id)
        if request.lower().startswith(("/code ", "code: ", "@code ", "@dev ")):
            return run_lane_coding(request, config, session_id, harness=harness, model=model)
        return run_lane_web(request, config, session_id)

    # 3. Mode: 'agentic' -> Trigger Lane 3 robust coding mechanism
    elif mode_clean == "agentic":
        if request.lower().startswith(("/ask ", "ask: ", "@ask ")):
            return run_lane_general(request, config, session_id)
        if request.lower().startswith(("/web ", "web: ", "/search ", "search: ", "@web ")):
            return run_lane_web(request, config, session_id)

        if fleet_info and is_new_project_directive(request):
            clear_session_fleet(session_id)
            clear_session_ui_set(session_id)
            fleet_info = None

        if fleet_info:
            return run_firstmate_bridge(request, config, session_id, fleet_info, harness=harness, model=model)

        if is_ui_creation_request(request):
            direct_archetype = detect_ui_archetype(request)
            if direct_archetype in (1, 2, 3):
                save_session_ui_set(session_id, direct_archetype)
                return run_lane_coding(request, config, session_id, ui_set=direct_archetype, harness=harness, model=model)
            else:
                return emit_ui_archetype_question(session_id, request, harness=harness, model=model)
        return run_lane_coding(request, config, session_id, harness=harness, model=model)

    # Default: Automatic intent classification fallback
    if fleet_info and is_new_project_directive(request):
        clear_session_fleet(session_id)
        clear_session_ui_set(session_id)
        fleet_info = None

    if fleet_info:
        # Check if user explicitly requested web search
        if request.lower().startswith(("/web ", "web: ", "/search ", "search: ", "@web ")):
            return run_lane_web(request, config, session_id)
        # Check if user explicitly asked general question with /ask
        if request.lower().startswith(("/ask ", "ask: ", "@ask ")):
            return run_lane_general(request, config, session_id)

        # In a coding session with an existing fleet, ALL follow-ups, changes, steers,
        # and questions go through Firstmate as the bridge supervisor!
        return run_firstmate_bridge(request, config, session_id, fleet_info, harness=harness, model=model)

    lane = classify_intent(request, prior_agent=agent)

    if lane == LANE_CODE:
        if is_ui_creation_request(request):
            direct_archetype = detect_ui_archetype(request)
            if direct_archetype in (1, 2, 3):
                save_session_ui_set(session_id, direct_archetype)
                return run_lane_coding(request, config, session_id, ui_set=direct_archetype, harness=harness, model=model)
            else:
                return emit_ui_archetype_question(session_id, request, harness=harness, model=model)
        return run_lane_coding(request, config, session_id, harness=harness, model=model)
    elif lane == LANE_WEB:
        return run_lane_web(request, config, session_id)
    else:
        if is_ui_creation_request(request):
            direct_archetype = detect_ui_archetype(request)
            if direct_archetype in (1, 2, 3):
                save_session_ui_set(session_id, direct_archetype)
                return run_lane_coding(request, config, session_id, ui_set=direct_archetype, harness=harness, model=model)
            else:
                return emit_ui_archetype_question(session_id, request, harness=harness, model=model)
        return run_lane_general(request, config, session_id)


def main() -> int:
    arguments = sys.argv[1:]
    if not arguments:
        print("Usage: omagent-route [--list-harnesses | --list-sessions | --get-session ID | --save-session ID | --delete-session ID | --clear-history | [--auto] [--mode regular|internet|agentic] [--harness agy|opencode|cline] [--model MODEL] [--agent SLUG --session ID] <request>]", file=sys.stderr)
        return 2

    if arguments[0] == "--list-harnesses":
        return cmd_list_harnesses()

    # CLI actions for session history
    if arguments[0] == "--list-sessions":
        return cmd_list_sessions()
    if arguments[0] == "--get-session" and len(arguments) > 1:
        return cmd_get_session(arguments[1])
    if arguments[0] == "--save-session" and len(arguments) > 1:
        return cmd_save_session(arguments[1])
    if arguments[0] == "--delete-session" and len(arguments) > 1:
        return cmd_delete_session(arguments[1])
    if arguments[0] == "--clear-history":
        return cmd_clear_history()

    session = ""
    agent = ""
    auto = False
    mode = ""
    harness = ""
    model = ""

    while arguments and arguments[0].startswith("--"):
        option = arguments.pop(0)
        if option == "--":
            break
        elif option == "--agent" and arguments:
            agent = arguments.pop(0)
        elif option == "--session" and arguments:
            session = arguments.pop(0)
        elif option == "--mode" and arguments:
            mode = arguments.pop(0)
        elif option == "--harness" and arguments:
            harness = arguments.pop(0)
        elif option == "--model" and arguments:
            model = arguments.pop(0)
        elif option == "--auto":
            auto = True
        else:
            print(f"Unknown option: {option}", file=sys.stderr)
            return 2

    if len(arguments) != 1 or not arguments[0].strip():
        print("Usage: omagent-route [--auto] [--mode regular|internet|agentic] [--harness agy|opencode|cline] [--model MODEL] [--agent SLUG --session ID] <request>", file=sys.stderr)
        return 2

    return route_request(arguments[0], session=session, agent=agent, mode=mode, harness=harness, model=model)


if __name__ == "__main__":
    raise SystemExit(main())
