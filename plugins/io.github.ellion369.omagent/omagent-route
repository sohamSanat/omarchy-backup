VALID_REST_MODELS = (
    "gemini-3.5-flash",
    "gemini-3-flash-preview",
    "gemini-3.5-flash-lite",
    "gemini-3.1-flash-lite-preview",
)

def sanitize_rest_model(model: str | None) -> str:
    """Sanitizes model name for Google generativelanguage REST API endpoints.
    Models like gemini-3.8-flash, 3.7, 3.6, 2.5, 1.5 do not exist on REST v1beta and cause 25s hangs or 404s.
    """
    m = str(model or "").strip()
    if not m:
        return "gemini-3.5-flash"
    if m in VALID_REST_MODELS:
        return m
    for bad in ("3.8", "3.7", "3.6", "2.5", "1.5", "gemini-pro", "gemini-flash"):
        if bad in m:
            return "gemini-3.5-flash"
    return "gemini-3.5-flash"


def stream_gemini_api(
    prompt: str | list[dict],
    api_key: str,
    model: str = "gemini-3.5-flash",
    fallback_models: list[str] | None = None,
    system_instruction: str = "",
) -> tuple[bool, str, str]:
    """Streams tokens directly from Google Gemini API via SSE."""
    clean_primary = sanitize_rest_model(model)
    if fallback_models is None:
        fallback_models = ["gemini-3.5-flash", "gemini-3-flash-preview", "gemini-3.5-flash-lite", "gemini-3.1-flash-lite-preview"]

    candidate_models: list[str] = []
    for m in [clean_primary] + fallback_models:
        sm = sanitize_rest_model(m)
        if sm not in candidate_models:
            candidate_models.append(sm)

    if isinstance(prompt, str):
        contents = [{"parts": [{"text": prompt}]}]
    else:
        contents = prompt

    for current_model in candidate_models:
        url = (
            f"https://generativelanguage.googleapis.com/v1beta/models/"
            f"{current_model}:streamGenerateContent?alt=sse&key={api_key}"
        )
        body: dict = {
            "contents": contents,
            "generationConfig": {
                "temperature": 0.7,
                "maxOutputTokens": 2048,
            },
        }
        if system_instruction:
            body["systemInstruction"] = {"parts": [{"text": system_instruction}]}

        data = json.dumps(body).encode("utf-8")
        req = urllib.request.Request(
            url, data=data, headers={"Content-Type": "application/json"}
        )

        accumulated_text = ""
        try:
            with urllib.request.urlopen(req, timeout=6.0) as resp:
                for raw_line in resp:
                    line = raw_line.decode("utf-8", errors="ignore").strip()
                    if not line.startswith("data: "):
                        continue
                    payload_str = line[6:]
                    try:
                        chunk = json.loads(payload_str)
                    except ValueError:
                        continue

                    candidates = chunk.get("candidates", [])
                    if candidates:
                        parts = candidates[0].get("content", {}).get("parts", [])
                        for p in parts:
                            text = p.get("text", "")
                            if text:
                                accumulated_text += text
                                emit("text", text=text)
                return True, "", accumulated_text
        except urllib.error.HTTPError as e:
            err_body = e.read().decode("utf-8", errors="ignore")
            # 503, 500, 404, 400, or 429: try next candidate model immediately
            if e.code in (400, 404, 429, 500, 503) and current_model != candidate_models[-1]:
                if DEBUG:
                    print(f"Model {current_model} returned {e.code}, falling back...", file=sys.stderr)
                continue
            return False, f"Google Gemini API error ({e.code}): {err_body[:200]}", ""
        except Exception as e:
            if current_model != candidate_models[-1]:
                if DEBUG:
                    print(f"Model {current_model} failed ({e}), falling back...", file=sys.stderr)
                continue
            return False, f"Network error connecting to Gemini API: {e}", ""

    return False, "All Gemini candidate models were unavailable.", ""


