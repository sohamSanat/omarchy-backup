            f"Provide an up-to-date, accurate answer for this query considering our ongoing conversation context."
        )

    contents = build_conversation_contents(history, prompt_text)

    system_instruction = get_system_instruction(lane="web")

    ok, err, full_text = stream_gemini_api(
        prompt=contents,
        api_key=api_key,
        model=config.get("web_model", "gemini-3.5-flash"),
        system_instruction=system_instruction,
    )

    if not ok:
        emit("error", text=err)
        emit("done", ok=False, code=1, stopped=False)
        return 1

    # Save clean user prompt and assistant response
    history_to_save = list(history)
    history_to_save.append({"role": "user", "parts": [{"text": search_query}]})
    save_session_history(session_id, history_to_save, full_text)

    emit("done", ok=True, code=0, stopped=False)
    return 0


