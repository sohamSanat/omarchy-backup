#!/usr/bin/env python3
"""
Omarchy Video & Media Idle Inhibitor and Lock-on-Screensaver Guard.
1. Prevents screensaver and idle lock while watching videos or listening to media,
   using Wayland idle-inhibit protocol without modifying persistent Omarchy settings.
2. Ensures that whenever the animated screensaver is dismissed or closed by any means,
   the system immediately locks and prompts for password / fingerprint authentication.
"""

import os
import sys
import time
import signal
import json
import socket
import subprocess
import threading
import select

HOME = os.path.expanduser("~")
INHIBIT_BIN = os.path.join(HOME, ".local/bin/omarchy-wayland-inhibit")

# Ensure required environment variables exist for child processes and sockets
def ensure_env():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    os.environ["XDG_RUNTIME_DIR"] = runtime_dir

    if not os.environ.get("WAYLAND_DISPLAY"):
        if os.path.exists(runtime_dir):
            for entry in sorted(os.listdir(runtime_dir)):
                if entry.startswith("wayland-") and not entry.endswith(".lock"):
                    os.environ["WAYLAND_DISPLAY"] = entry
                    break

    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        hypr_dir = os.path.join(runtime_dir, "hypr")
        if os.path.exists(hypr_dir):
            for entry in sorted(os.listdir(hypr_dir)):
                candidate = os.path.join(hypr_dir, entry, ".socket2.sock")
                if os.path.exists(candidate):
                    os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = entry
                    break

ensure_env()

IGNORED_APPS = {
    "speech-dispatcher-dummy",
    "system-sounds",
}

def log(msg: str):
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{ts}] [omarchy-idle-inhibit] {msg}", flush=True)

class MediaIdleInhibitor:
    def __init__(self):
        self.running = True
        self.inhibit_proc = None
        self.lock = threading.Lock()
        self.grace_timer = None
        self.grace_seconds = 6.0
        self.screensaver_windows = set()

        # Clean up any stale files from previous broken versions
        for path in [
            os.path.join(HOME, ".local/state/omarchy/indicators/stay-awake"),
            os.path.join(HOME, ".local/state/omarchy/toggles/screensaver-off"),
        ]:
            if os.path.exists(path):
                try:
                    os.remove(path)
                    log(f"Cleaned up stale state file: {path}")
                except Exception:
                    pass

        # Ensure omarchy idle is enabled in shell
        try:
            subprocess.run(["omarchy-shell", "-q", "idle", "enable"], timeout=2)
        except Exception:
            pass

        signal.signal(signal.SIGINT, self.shutdown)
        signal.signal(signal.SIGTERM, self.shutdown)

    # ------------------ Hyprland Socket2 Watcher ------------------
    def hyprland_socket_thread(self):
        """Watches Hyprland socket2 to ensure any screensaver window close triggers a system lock."""
        runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")

        while self.running:
            try:
                sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
                sock_path = os.path.join(runtime_dir, "hypr", sig, ".socket2.sock") if sig else ""

                if not (sock_path and os.path.exists(sock_path)):
                    hypr_dir = os.path.join(runtime_dir, "hypr")
                    sock_path = None
                    if os.path.exists(hypr_dir):
                        for entry in os.listdir(hypr_dir):
                            candidate = os.path.join(hypr_dir, entry, ".socket2.sock")
                            if os.path.exists(candidate):
                                sock_path = candidate
                                break

                if not sock_path or not os.path.exists(sock_path):
                    time.sleep(2)
                    continue

                # Scan for any already running screensaver windows
                try:
                    res = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=2)
                    if res.returncode == 0:
                        clients = json.loads(res.stdout)
                        for c in clients:
                            if c.get("class") == "org.omarchy.screensaver":
                                with self.lock:
                                    self.screensaver_windows.add(c.get("address", ""))
                except Exception:
                    pass

                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(sock_path)
                f = s.makefile("r")
                for line in f:
                    if not self.running:
                        break
                    line = line.strip()
                    if line.startswith("openwindow>>"):
                        # format: address,workspace,class,title
                        parts = line[12:].split(",", 3)
                        if len(parts) >= 3 and parts[2] == "org.omarchy.screensaver":
                            addr = parts[0].strip()
                            with self.lock:
                                self.screensaver_windows.add(addr)
                            log(f"Screensaver window active: {addr}")
                    elif line.startswith("closewindow>>"):
                        addr = line[13:].strip()
                        was_screensaver = False
                        with self.lock:
                            if addr in self.screensaver_windows:
                                self.screensaver_windows.remove(addr)
                                was_screensaver = True
                        if was_screensaver:
                            log(f"Screensaver window closed: {addr}. Ensuring system lock engaged...")
                            try:
                                is_locked = subprocess.check_output(
                                    ["omarchy-shell", "lock", "isLocked"],
                                    text=True, stderr=subprocess.DEVNULL, timeout=1
                                ).strip()
                                if is_locked != "true":
                                    subprocess.run(["omarchy-system-lock"], timeout=2)
                                subprocess.run(["omarchy-shell", "lock", "wake"], timeout=1)
                            except Exception:
                                subprocess.run(["omarchy-system-lock"], timeout=2)
                s.close()
            except Exception as e:
                time.sleep(2)

    # ------------------ Media / Video Audio Checks ------------------
    def is_audio_playing(self) -> bool:
        """Checks PipeWire for any active uncorked audio stream from user media apps."""
        try:
            res = subprocess.run(
                ["pactl", "-f", "json", "list", "sink-inputs"],
                capture_output=True, text=True, timeout=2
            )
            if res.returncode != 0 or not res.stdout.strip():
                return False
            inputs = json.loads(res.stdout)
            for item in inputs:
                if item.get("corked", True):
                    continue
                props = item.get("properties", {})
                app_name = props.get("application.name", "")
                if not app_name:
                    continue
                if app_name in IGNORED_APPS or "voxtype" in app_name.lower():
                    continue
                return True
        except Exception:
            pass
        return False

    def is_mpris_playing(self) -> bool:
        """Checks MPRIS for any player with PlaybackStatus == 'Playing'."""
        try:
            res = subprocess.run(
                ["busctl", "--user", "list"],
                capture_output=True, text=True, timeout=2
            )
            if res.returncode != 0:
                return False
            for line in res.stdout.splitlines():
                parts = line.split()
                if not parts:
                    continue
                name = parts[0]
                if name.startswith("org.mpris.MediaPlayer2."):
                    status_res = subprocess.run(
                        ["busctl", "--user", "get-property", name, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlaybackStatus"],
                        capture_output=True, text=True, timeout=1
                    )
                    if status_res.returncode == 0 and "Playing" in status_res.stdout:
                        return True
        except Exception:
            pass
        return False

    def is_media_active(self) -> bool:
        return self.is_audio_playing() or self.is_mpris_playing()

    def enable_inhibit(self):
        with self.lock:
            if self.grace_timer:
                self.grace_timer.cancel()
                self.grace_timer = None

            if self.inhibit_proc and self.inhibit_proc.poll() is None:
                return

            if os.path.isfile(INHIBIT_BIN) and os.access(INHIBIT_BIN, os.X_OK):
                try:
                    self.inhibit_proc = subprocess.Popen(
                        [INHIBIT_BIN],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL
                    )
                    log(">>> INHIBIT ACTIVE: Media playback detected (Wayland idle inhibited)")
                except Exception as e:
                    log(f"Failed to spawn {INHIBIT_BIN}: {e}")

    def disable_inhibit(self):
        with self.lock:
            if not self.inhibit_proc or self.inhibit_proc.poll() is not None:
                return

            if not self.grace_timer:
                self.grace_timer = threading.Timer(self.grace_seconds, self._apply_release)
                self.grace_timer.daemon = True
                self.grace_timer.start()

    def _apply_release(self):
        with self.lock:
            self.grace_timer = None
            if self.is_media_active():
                return

            if self.inhibit_proc and self.inhibit_proc.poll() is None:
                self.inhibit_proc.terminate()
                try:
                    self.inhibit_proc.wait(timeout=1.0)
                except subprocess.TimeoutExpired:
                    self.inhibit_proc.kill()
                self.inhibit_proc = None
                log("<<< INHIBIT RELEASED: Media playback stopped (normal idle timers restored)")

    def check_and_update(self):
        if self.is_media_active():
            self.enable_inhibit()
        else:
            self.disable_inhibit()

    def run(self):
        log("Omarchy Video & Media Idle Inhibitor and Lock Guard running.")
        self.check_and_update()

        # Start background Hyprland socket thread for screensaver window monitoring
        hypr_t = threading.Thread(target=self.hyprland_socket_thread, daemon=True)
        hypr_t.start()

        pactl_proc = None
        try:
            pactl_proc = subprocess.Popen(
                ["pactl", "subscribe"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1
            )
        except Exception as e:
            log(f"Warning: pactl subscribe failed: {e}")

        while self.running:
            if pactl_proc and pactl_proc.poll() is None:
                r, _, _ = select.select([pactl_proc.stdout], [], [], 2.0)
                if r:
                    line = pactl_proc.stdout.readline()
                    if "sink-input" in line or "server" in line:
                        self.check_and_update()
                else:
                    self.check_and_update()
            else:
                time.sleep(2.0)
                self.check_and_update()

        if pactl_proc and pactl_proc.poll() is None:
            pactl_proc.terminate()
        self.cleanup()

    def shutdown(self, signum, frame):
        log("Shutting down inhibitor daemon...")
        self.running = False

    def cleanup(self):
        with self.lock:
            if self.grace_timer:
                self.grace_timer.cancel()
                self.grace_timer = None
            if self.inhibit_proc and self.inhibit_proc.poll() is None:
                self.inhibit_proc.terminate()
                try:
                    self.inhibit_proc.wait(timeout=1.0)
                except Exception:
                    self.inhibit_proc.kill()
                self.inhibit_proc = None

if __name__ == "__main__":
    daemon = MediaIdleInhibitor()
    try:
        daemon.run()
    except Exception as e:
        log(f"Fatal error: {e}")
        daemon.cleanup()
