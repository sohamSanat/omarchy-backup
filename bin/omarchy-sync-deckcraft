#!/usr/bin/env bash
# ==============================================================================
# omarchy-sync-deckcraft: Dynamic Theme Synchronization Engine for DeckCraft
# ------------------------------------------------------------------------------
# Generates per-theme color tokens directly from Omarchy's active theme palette
# and updates ~/.config/deckcraft/theme.json for instant live hot-reloading.
# ==============================================================================
set -euo pipefail

PREFS_DIR="$HOME/.config/deckcraft"
THEME_JSON="$PREFS_DIR/theme.json"
CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"
COLORS_TOML="$CURRENT_THEME_DIR/colors.toml"
CONTROL_PORT="${DECKCRAFT_CONTROL_PORT:-48295}"

mkdir -p "$PREFS_DIR"

# 1. Determine colors.toml source
SPECIFIED_THEME="${1:-}"
if [[ -n "$SPECIFIED_THEME" && -f "$HOME/.config/omarchy/themes/$SPECIFIED_THEME/colors.toml" ]]; then
  COLORS_TOML="$HOME/.config/omarchy/themes/$SPECIFIED_THEME/colors.toml"
elif [[ -n "$SPECIFIED_THEME" && -f "/usr/share/omarchy/themes/$SPECIFIED_THEME/colors.toml" ]]; then
  COLORS_TOML="/usr/share/omarchy/themes/$SPECIFIED_THEME/colors.toml"
fi

# Fallback check
if [[ ! -f "$COLORS_TOML" ]]; then
  if [[ -f "$HOME/.local/state/omarchy/current/theme/colors.toml" ]]; then
    COLORS_TOML="$HOME/.local/state/omarchy/current/theme/colors.toml"
  fi
fi

# 2. Run Python palette synthesis
python3 - <<PY
import tomllib, json, os

def hex_to_rgb(h):
    h = h.strip().lstrip('#')
    if len(h) == 3:
        h = ''.join(c * 2 for c in h)
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def rgb_to_hex(r, g, b):
    return f"#{int(max(0, min(255, round(r)))):02x}{int(max(0, min(255, round(g)))):02x}{int(max(0, min(255, round(b)))):02x}"

def blend(c1, c2, factor):
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    return rgb_to_hex(
        r1 * (1.0 - factor) + r2 * factor,
        g1 * (1.0 - factor) + g2 * factor,
        b1 * (1.0 - factor) + b2 * factor
    )

colors_path = "$COLORS_TOML"
colors = {}
if os.path.exists(colors_path):
    try:
        with open(colors_path, "rb") as f:
            colors = tomllib.load(f)
    except Exception:
        pass

bg = colors.get("background", "#1B1B1B")
fg = colors.get("foreground", "#efebdc")
# DeckCraft default signature accent is warm presentation orange/rust (#D95A1A) unless theme supplies accent
theme_accent = colors.get("accent", colors.get("color4", "#D95A1A"))
accent = colors.get("color16", colors.get("color9", theme_accent))
if not accent or accent == bg:
    accent = "#D95A1A"

r, g, b = hex_to_rgb(bg)
lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
is_light = lum > 128

if is_light:
    # High-contrast light mode adhering to Omarchy theming rules
    chrome = blend(bg, "#000000", 0.03)
    card = "#ffffff" if bg != "#ffffff" else blend(bg, "#000000", 0.02)
    card_border = blend(bg, "#000000", 0.14)
    canvas = blend(bg, "#000000", 0.06)
    text = blend(fg, "#000000", 0.75) if fg == bg else fg
    text_dim = blend(text, bg, 0.40)
    text_faint = blend(text, bg, 0.60)
    border = blend(bg, "#000000", 0.16)
    separator = blend(bg, "#000000", 0.10)
    hover = blend(bg, "#000000", 0.07)
    pressed = blend(bg, "#000000", 0.14)
    selected = blend(accent, bg, 0.75)
    accent_text = "#ffffff"
    contextual = blend(accent, "#000000", 0.15)
    selection = blend(accent, bg, 0.40)
    handle_fill = "#ffffff"
    handle_stroke = blend(text, bg, 0.30)
    guide = accent
    caret = text
    text_selection = "#5a8fe05a"
    field_bg = "#ffffff" if bg != "#ffffff" else blend(bg, "#000000", 0.02)
    shadow = "#0000001c"
else:
    # Deep, saturated dark mode matching Omarchy themes
    chrome = blend(bg, "#ffffff", 0.04)
    card = blend(bg, "#ffffff", 0.08)
    card_border = blend(bg, "#ffffff", 0.14)
    canvas = blend(bg, "#000000", 0.18)
    text = fg
    text_dim = blend(fg, bg, 0.35)
    text_faint = blend(fg, bg, 0.55)
    border = blend(bg, "#ffffff", 0.14)
    separator = blend(bg, "#ffffff", 0.10)
    hover = blend(bg, "#ffffff", 0.10)
    pressed = blend(bg, "#ffffff", 0.18)
    selected = blend(accent, bg, 0.60)
    accent_text = "#ffffff"
    contextual = blend(accent, "#ffffff", 0.15)
    selection = blend(accent, bg, 0.40)
    handle_fill = "#ffffff"
    handle_stroke = blend(fg, bg, 0.30)
    guide = accent
    caret = "#ffffff"
    text_selection = "#5a8fe05a"
    field_bg = blend(bg, "#000000", 0.15)
    shadow = "#0000005a"

tokens = {
    "dark": not is_light,
    "kind": "light" if is_light else "dark",
    "chrome": chrome,
    "card": card,
    "card_border": card_border,
    "canvas": canvas,
    "text": text,
    "text_dim": text_dim,
    "text_faint": text_faint,
    "border": border,
    "separator": separator,
    "hover": hover,
    "pressed": pressed,
    "selected": selected,
    "accent": accent,
    "accent_text": accent_text,
    "contextual": contextual,
    "selection": selection,
    "handle_fill": handle_fill,
    "handle_stroke": handle_stroke,
    "guide": guide,
    "caret": caret,
    "text_selection": text_selection,
    "field_bg": field_bg,
    "shadow": shadow
}

with open("$THEME_JSON", "w") as out:
    json.dump(tokens, out, indent=2)
PY

# 3. If DeckCraft is running on loopback, wake up and apply immediately
if command -v python3 >/dev/null 2>&1; then
  python3 - <<PY 2>/dev/null || true
import socket, json

try:
    s = socket.create_connection(("127.0.0.1", int("$CONTROL_PORT")), timeout=0.3)
    f = s.makefile("rw")
    # Trigger inspect to immediately flush live token poll
    f.write(json.dumps({"id": 1, "method": "ui.inspect", "params": {}}) + "\n")
    f.flush()
    f.readline()
    s.close()
except Exception:
    pass
PY
fi
