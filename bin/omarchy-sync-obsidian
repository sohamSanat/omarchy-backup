#!/bin/bash
set -euo pipefail

# ==============================================================================
# Omarchy -> Obsidian Color Palette Sync Script
# Ensures all Obsidian vaults are synced with the current Omarchy system theme.
# ==============================================================================

CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"

# If theme directory or obsidian.css is missing, trigger omarchy template generation
if [[ ! -f "$CURRENT_THEME_DIR/obsidian.css" ]]; then
  if command -v omarchy-theme-set-templates >/dev/null 2>&1; then
    omarchy-theme-set-templates 2>/dev/null || true
  fi
fi

if [[ ! -f "$CURRENT_THEME_DIR/obsidian.css" ]]; then
  exit 0
fi

# Collect all Obsidian vaults
VAULT_PATHS=()

# 1. Read from obsidian.json
if [[ -f "$HOME/.config/obsidian/obsidian.json" ]]; then
  while IFS= read -r path; do
    [[ -n "$path" && -d "$path/.obsidian" ]] && VAULT_PATHS+=("$path")
  done < <(jq -r '.vaults | values[].path' "$HOME/.config/obsidian/obsidian.json" 2>/dev/null || true)
fi

# 2. Check standard vault directories if not already added
for candidate in "$HOME/Obsidian"/*; do
  if [[ -d "$candidate/.obsidian" ]]; then
    already_found=0
    for v in "${VAULT_PATHS[@]}"; do
      if [[ "$v" == "$candidate" ]]; then
        already_found=1
        break
      fi
    done
    if [[ $already_found -eq 0 ]]; then
      VAULT_PATHS+=("$candidate")
    fi
  fi
done

# Sync theme to all discovered vaults
for vault_path in "${VAULT_PATHS[@]}"; do
  [[ -d "$vault_path/.obsidian" ]] || continue

  theme_dir="$vault_path/.obsidian/themes/Omarchy"
  snippets_dir="$vault_path/.obsidian/snippets"
  mkdir -p "$theme_dir" "$snippets_dir"

  # Write Omarchy theme manifest if not present
  if [[ ! -f "$theme_dir/manifest.json" ]]; then
    cat >"$theme_dir/manifest.json" <<'EOF'
{
  "name": "Omarchy",
  "version": "1.0.0",
  "minAppVersion": "0.16.0",
  "description": "Automatically syncs with your current Omarchy system theme colors and fonts",
  "author": "Omarchy",
  "authorUrl": "https://omarchy.org"
}
EOF
  fi

  # Copy current Omarchy theme CSS to the Omarchy community theme
  cp "$CURRENT_THEME_DIR/obsidian.css" "$theme_dir/theme.css"

  # Ensure calendar and rainbow tokens are present even for legacy themes
  if ! grep -q -- "--wp-rose" "$theme_dir/theme.css" 2>/dev/null; then
    if [[ -f "$CURRENT_THEME_DIR/colors.toml" ]] && command -v omarchy-theme-color >/dev/null 2>&1; then
      declare -A C_COLORS=()
      while IFS=$'\t' read -r k v; do
        C_COLORS["$k"]="$v"
      done < <(omarchy-theme-color --file "$CURRENT_THEME_DIR/colors.toml" --all 2>/dev/null || true)

      c_bg="${C_COLORS[background]:-#0e091d}"
      c_fg="${C_COLORS[foreground]:-#ffffff}"
      c_magenta="${C_COLORS[magenta]:-${C_COLORS[pink]:-#f472b6}}"
      c_orange="${C_COLORS[orange]:-#fbbf24}"
      c_purple="${C_COLORS[purple]:-#c084fc}"
      c_cyan="${C_COLORS[cyan]:-#38bdf8}"
      c_green="${C_COLORS[green]:-#2dd4bf}"
      c_blue="${C_COLORS[blue]:-#818cf8}"

      cat >> "$theme_dir/theme.css" <<EOF

/* Injected Omarchy Calendar / Journals HUD Palette */
.theme-dark, .theme-light {
  --color-red: ${C_COLORS[red]:-#f43f5e};
  --color-orange: ${c_orange};
  --color-yellow: ${C_COLORS[yellow]:-#eab308};
  --color-green: ${c_green};
  --color-cyan: ${c_cyan};
  --color-blue: ${c_blue};
  --color-purple: ${c_purple};
  --color-pink: ${c_magenta};

  --wp-rose: ${c_magenta};
  --wp-amber: ${c_orange};
  --wp-purple: ${c_purple};
  --wp-cyan: ${c_cyan};
  --wp-teal: ${c_green};
  --wp-indigo: ${c_blue};
  --wp-hud-bg: color-mix(in srgb, ${c_bg} 85%, transparent);
  --wp-border: color-mix(in srgb, ${c_fg} 12%, transparent);
}
EOF
    fi
  fi

  # Also write to snippets as omarchy-theme.css for flexibility
  cp "$theme_dir/theme.css" "$snippets_dir/omarchy-theme.css"

  # Update appearance.json to activate the Omarchy theme
  appearance_file="$vault_path/.obsidian/appearance.json"
  if [[ -f "$appearance_file" ]]; then
    # Use jq to update cssTheme to "Omarchy" while preserving all user snippets and settings
    tmp_json=$(mktemp)
    if jq '.cssTheme = "Omarchy"' "$appearance_file" > "$tmp_json" 2>/dev/null; then
      mv "$tmp_json" "$appearance_file"
    else
      rm -f "$tmp_json"
    fi
  fi
done
