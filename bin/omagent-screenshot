#!/usr/bin/env python3
"""
omagent-screenshot: Fast, zero-config headless screenshot tool for Omagent & AI coding agents.
Captures screenshots of local HTML files or remote URLs using the fastest available engine:
Playwright Chromium Headless Shell -> Zen Browser Headless -> System Chromium/Chrome.
"""

import sys
import os
import glob
import shutil
import argparse
import subprocess
import tempfile
from pathlib import Path
from urllib.parse import unquote, urlparse

def find_browser():
    # 1. Check Playwright Chromium Headless Shell (Fastest, ~1s, no profile needed)
    shells = sorted(glob.glob(os.path.expanduser("~/.cache/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell")))
    if shells and os.path.isfile(shells[-1]) and os.access(shells[-1], os.X_OK):
        return ("chrome-headless-shell", shells[-1])

    # 2. Check Playwright Chromium
    chromes = sorted(glob.glob(os.path.expanduser("~/.cache/ms-playwright/chromium-*/chrome-linux64/chrome")))
    if chromes and os.path.isfile(chromes[-1]) and os.access(chromes[-1], os.X_OK):
        return ("chrome", chromes[-1])

    # 3. Check Zen Browser
    zen = shutil.which("zen") or os.path.expanduser("~/.local/bin/zen")
    if os.path.isfile(zen) and os.access(zen, os.X_OK):
        return ("zen", zen)

    # 4. Check system chromium / google-chrome / firefox
    for bin_name in ["chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "firefox"]:
        p = shutil.which(bin_name)
        if p:
            engine = "firefox" if "firefox" in bin_name else "chrome"
            return (engine, p)

    return (None, None)

def main():
    parser = argparse.ArgumentParser(
        description="Fast headless screenshot tool for visual verification of web pages and UIs.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument("target", help="URL or path to local HTML file (e.g. index.html or file:///path)")
    parser.add_argument("output", nargs="?", default="preview.png", help="Path to save output screenshot PNG")
    parser.add_argument("--width", type=int, default=1440, help="Viewport width in pixels")
    parser.add_argument("--height", type=int, default=900, help="Viewport height in pixels")
    parser.add_argument("--mobile", action="store_true", help="Set viewport to mobile (375x812)")
    parser.add_argument("--tablet", action="store_true", help="Set viewport to tablet (1024x768)")
    parser.add_argument("--full", action="store_true", help="Capture extended vertical page (height=3200)")
    parser.add_argument("--workspace", default=".", help="Allowed local workspace for file targets and output")
    parser.add_argument("--allow-host", action="append", default=[], help="Allowed remote hostname; repeat for multiple hosts")

    args = parser.parse_args()

    width = args.width
    height = args.height

    if args.mobile:
        width, height = 375, 812
    elif args.tablet:
        width, height = 1024, 768
    elif args.full:
        height = 3200

    workspace = Path(args.workspace).expanduser().resolve()
    if not workspace.is_dir():
        print(f"Error: Workspace does not exist: {workspace}", file=sys.stderr)
        sys.exit(1)

    def inside_workspace(path: Path, label: str) -> Path:
        try:
            path.resolve().relative_to(workspace)
        except ValueError:
            print(f"Error: {label} must stay inside --workspace", file=sys.stderr)
            sys.exit(1)
        return path.resolve()

    target = args.target
    parsed = urlparse(target)
    if parsed.scheme in {"http", "https"}:
        allowed_hosts = set(args.allow_host)
        if not allowed_hosts:
            print("Error: Remote targets require --allow-host", file=sys.stderr)
            sys.exit(1)
        if parsed.hostname not in allowed_hosts:
            print(f"Error: Remote host is not allowed: {parsed.hostname}", file=sys.stderr)
            sys.exit(1)
    elif parsed.scheme == "file":
        path = inside_workspace(Path(unquote(parsed.path)), "Target file")
        if not path.is_file():
            print(f"Error: Target file does not exist: {path}", file=sys.stderr)
            sys.exit(1)
        target = path.as_uri()
    elif parsed.scheme:
        print(f"Error: Unsupported target scheme: {parsed.scheme}", file=sys.stderr)
        sys.exit(1)
    else:
        path = inside_workspace(Path(target), "Target file")
        if not path.is_file():
            print(f"Error: Target file does not exist: {path}", file=sys.stderr)
            sys.exit(1)
        target = path.as_uri()

    out_path = Path(args.output).expanduser()
    if not out_path.is_absolute():
        out_path = workspace / out_path
    out_path = inside_workspace(out_path, "Screenshot output")
    out_path.parent.mkdir(parents=True, exist_ok=True)

    engine, browser_bin = find_browser()
    if not browser_bin:
        print("Error: No headless browser found (checked Playwright Chromium, Zen, System Chromium/Firefox).", file=sys.stderr)
        sys.exit(1)

    try:
        if engine in ("chrome-headless-shell", "chrome"):
            cmd = [
                browser_bin,
                "--headless",
                "--hide-scrollbars",
                f"--window-size={width},{height}",
                f"--screenshot={out_path}",
                target
            ]
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20)
            if res.returncode != 0 and not out_path.exists():
                print(f"Warning: Chrome returned code {res.returncode}: {res.stderr[:200]}", file=sys.stderr)
        elif engine in ("zen", "firefox"):
            with tempfile.TemporaryDirectory(prefix="zen_shot_") as tmp_prof:
                cmd = [
                    browser_bin,
                    "--headless",
                    "--no-remote",
                    "--profile", tmp_prof,
                    "--screenshot", str(out_path),
                    "--window-size", f"{width},{height}",
                    target
                ]
                res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=25)
                if res.returncode != 0 and not out_path.exists():
                    print(f"Warning: Browser returned code {res.returncode}: {res.stderr[:200]}", file=sys.stderr)

        if out_path.is_file() and out_path.stat().st_size > 0:
            size_kb = round(out_path.stat().st_size / 1024, 1)
            print(f"[omagent-screenshot] Successfully captured {width}x{height} screenshot ({size_kb} KB) -> {out_path}")
            sys.exit(0)
        else:
            print(f"Error: Failed to generate screenshot at {out_path}", file=sys.stderr)
            sys.exit(1)
    except subprocess.TimeoutExpired:
        print(f"Error: Browser timed out while rendering {target}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error executing browser screenshot: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
