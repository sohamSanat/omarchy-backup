#!/usr/bin/env bash
# ==============================================================================
# omarchy-sync-vectorcraft: Dynamic Theme Synchronization Engine for VectorCraft
# ------------------------------------------------------------------------------
# Generates per-theme color tokens directly from Omarchy's active theme palette
# and updates ~/.config/vectorcraft/theme.json for instant live hot-reloading.
# ==============================================================================
set -euo pipefail

PREFS_DIR="$HOME/.config/vectorcraft"
PREFS_FILE="$PREFS_DIR/ui.json"
THEME_JSON="$PREFS_DIR/theme.json"
CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"
COLORS_TOML="$CURRENT_THEME_DIR/colors.toml"

mkdir -p "$PREFS_DIR"

# 1. Determine colors.toml source
SPECIFIED_THEME="${1:-}"
if [[ -n "$SPECIFIED_THEME" && -f "$HOME/.config/omarchy/themes/$SPECIFIED_THEME/colors.toml" ]]; then
  COLORS_TOML="$HOME/.config/omarchy/themes/$SPECIFIED_THEME/colors.toml"
elif [[ -n "$SPECIFIED_THEME" && -f "/usr/share/omarchy/themes/$SPECIFIED_THEME/colors.toml" ]]; then
  COLORS_TOML="/usr/share/omarchy/themes/$SPECIFIED_THEME/colors.toml"
fi

# Fallback check
if [[ ! -f "$COLORS_TOML" ]]; then
  if [[ -f "$HOME/.local/state/omarchy/current/theme/colors.toml" ]]; then
    COLORS_TOML="$HOME/.local/state/omarchy/current/theme/colors.toml"
  fi
fi

# 2. Run Python palette synthesis
python3 - <<PY
import tomllib, json, os

def hex_to_rgb(h):
    h = h.strip().lstrip('#')
    if len(h) == 3:
        h = ''.join(c * 2 for c in h)
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def rgb_to_hex(r, g, b):
    return f"#{int(max(0, min(255, round(r)))):02x}{int(max(0, min(255, round(g)))):02x}{int(max(0, min(255, round(b)))):02x}"

def blend(c1, c2, factor):
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    return rgb_to_hex(
        r1 * (1.0 - factor) + r2 * factor,
        g1 * (1.0 - factor) + g2 * factor,
        b1 * (1.0 - factor) + b2 * factor
    )

colors_path = "$COLORS_TOML"
colors = {}
if os.path.exists(colors_path):
    try:
        with open(colors_path, "rb") as f:
            colors = tomllib.load(f)
    except Exception:
        pass

bg = colors.get("background", "#1B1B1B")
fg = colors.get("foreground", "#efebdc")
accent = colors.get("accent", colors.get("color4", "#e75a50"))
c1 = colors.get("color1", "#ef4444")
c3 = colors.get("color3", "#eab308")

r, g, b = hex_to_rgb(bg)
lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
is_light = lum > 128

if is_light:
    # High-contrast light mode adhering to Omarchy theming rules
    app_bar = blend(bg, "#000000", 0.06)
    panel = bg
    panel_darker = blend(bg, "#000000", 0.04)
    tab_strip = blend(bg, "#000000", 0.06)
    input_bg = "#ffffff" if bg != "#ffffff" else blend(bg, "#000000", 0.03)
    input_border = blend(bg, "#000000", 0.25)
    border = blend(bg, "#000000", 0.20)
    divider = blend(bg, "#000000", 0.12)
    text = blend(fg, "#000000", 0.70) if fg == bg else fg
    text_dim = blend(text, bg, 0.40)
    text_strong = "#111111"
    text_disabled = blend(text, bg, 0.65)
    icon = text
    hover = blend(bg, "#000000", 0.08)
    tool_active = blend(bg, "#000000", 0.16)
    button = blend(bg, "#000000", 0.06)
    button_border = blend(bg, "#000000", 0.22)
    row_selected = blend(accent, bg, 0.75)
    pasteboard = blend(bg, "#000000", 0.10)
    ruler = blend(bg, "#000000", 0.05)
    ruler_tick = blend(text, bg, 0.50)
    accent_strong = blend(accent, "#000000", 0.20)
else:
    # Deep, saturated dark mode
    app_bar = blend(bg, "#000000", 0.18)
    panel = bg
    panel_darker = blend(bg, "#000000", 0.25)
    tab_strip = blend(bg, "#000000", 0.30)
    input_bg = blend(bg, "#000000", 0.22)
    input_border = blend(bg, "#ffffff", 0.18)
    border = blend(bg, "#000000", 0.45)
    divider = blend(bg, "#ffffff", 0.10)
    text = fg
    text_dim = blend(fg, bg, 0.35)
    text_strong = blend(fg, "#ffffff", 0.25)
    text_disabled = blend(fg, bg, 0.60)
    icon = fg
    hover = blend(bg, "#ffffff", 0.12)
    tool_active = blend(bg, "#000000", 0.38)
    button = blend(bg, "#ffffff", 0.07)
    button_border = blend(bg, "#ffffff", 0.18)
    row_selected = blend(accent, bg, 0.60)
    pasteboard = blend(bg, "#000000", 0.25)
    ruler = blend(bg, "#000000", 0.18)
    ruler_tick = blend(fg, bg, 0.45)
    accent_strong = blend(accent, "#ffffff", 0.20)

tokens = {
    "dark": not is_light,
    "app_bar": app_bar,
    "panel": panel,
    "panel_darker": panel_darker,
    "tab_strip": tab_strip,
    "input": input_bg,
    "input_border": input_border,
    "border": border,
    "divider": divider,
    "text": text,
    "text_dim": text_dim,
    "text_strong": text_strong,
    "text_disabled": text_disabled,
    "icon": icon,
    "hover": hover,
    "tool_active": tool_active,
    "button": button,
    "button_border": button_border,
    "accent": accent,
    "accent_strong": accent_strong,
    "row_selected": row_selected,
    "pasteboard": pasteboard,
    "ruler": ruler,
    "ruler_tick": ruler_tick,
    "selection": accent,
    "anchor_selected": accent,
    "flyout_active": accent,
    "error": c1,
    "warning": c3,
    "radius": 4
}

with open("$THEME_JSON", "w") as out:
    json.dump(tokens, out, indent=2)

# Update base brightness enum in ui.json
base_brightness = "Light" if is_light else "MediumDark"
prefs_path = "$PREFS_FILE"
prefs = {}
if os.path.exists(prefs_path):
    try:
        with open(prefs_path, "r") as pf:
            prefs = json.load(pf)
    except Exception:
        pass

prefs["brightness"] = base_brightness

with open(prefs_path, "w") as pf:
    json.dump(prefs, pf, indent=2)
PY

# 3. If VectorCraft is running on loopback, wake up and apply immediately
CONTROL_PORT="${VECTORCRAFT_CONTROL_PORT:-48292}"
if command -v python3 >/dev/null 2>&1; then
  python3 - <<PY 2>/dev/null || true
import socket, json

try:
    s = socket.create_connection(("127.0.0.1", int("$CONTROL_PORT")), timeout=0.3)
    f = s.makefile("rw")
    # Trigger an inspect or empty ping to immediately flush live token poll
    f.write(json.dumps({"id": 1, "method": "ui.inspect", "params": {}}) + "\n")
    f.flush()
    f.readline()
    s.close()
except Exception:
    pass
PY
fi
