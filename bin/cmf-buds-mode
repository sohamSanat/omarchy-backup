#!/usr/bin/env bash
# cmf-buds-mode: Toggle or set CMF Buds between Headset Mode (Mic Enabled) and Music Mode (Hi-Fi AAC)

set -euo pipefail

# Locate Bluetooth card
CARD=$(pactl list cards short | grep -m1 "bluez_card" | awk '{print $2}' || true)
if [[ -z "$CARD" ]]; then
    exit 0
fi

get_current_profile() {
    pactl list cards | grep -A 40 "$CARD" | grep "Active Profile:" | head -n1 | awk '{print $3}'
}

get_bluez_source() {
    pactl list sources short | grep -m1 "bluez_input" | awk '{print $2}' || true
}

get_internal_mic() {
    pactl list sources short | grep -m1 "HiFi__Mic1__source" | awk '{print $2}' || true
}

set_headset_mode() {
    pactl set-card-profile "$CARD" headset-head-unit 2>/dev/null || true
    for _ in {1..15}; do
        local src
        src=$(get_bluez_source)
        if [[ -n "$src" ]]; then
            pactl set-source-mute "$src" 0 2>/dev/null || true
            pactl set-default-source "$src" 2>/dev/null || true
            break
        fi
        sleep 0.05
    done
}

set_music_mode() {
    pactl set-card-profile "$CARD" a2dp-sink 2>/dev/null || true
    local internal_mic
    internal_mic=$(get_internal_mic)
    if [[ -n "$internal_mic" ]]; then
        pactl set-default-source "$internal_mic" 2>/dev/null || true
    fi
}

show_status() {
    local profile
    profile=$(get_current_profile)
    local def_source
    def_source=$(pactl info | grep "Default Source:" | cut -d: -f2- | xargs)
    echo "Card: $CARD"
    echo "Active Profile: $profile"
    echo "Default Input Source: $def_source"
}

cmd="${1:-toggle}"

case "$cmd" in
    headset|mic|voice|dictate)
        set_headset_mode
        ;;
    music|a2dp|hifi)
        set_music_mode
        ;;
    toggle)
        cur=$(get_current_profile)
        if [[ "$cur" =~ headset ]]; then
            set_music_mode
        else
            set_headset_mode
        fi
        ;;
    status)
        show_status
        ;;
    *)
        echo "Usage: $(basename "$0") [headset|music|toggle|status]"
        exit 1
        ;;
esac
