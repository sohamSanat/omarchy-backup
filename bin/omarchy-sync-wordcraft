#!/usr/bin/env bash
# ==============================================================================
# omarchy-sync-wordcraft: Dynamic Theme Synchronization Engine for WordCraft
# ------------------------------------------------------------------------------
# Generates per-theme color tokens directly from Omarchy's active theme palette
# and updates ~/.config/wordcraft/theme.json for instant live hot-reloading.
# ==============================================================================
set -euo pipefail

PREFS_DIR="$HOME/.config/wordcraft"
THEME_JSON="$PREFS_DIR/theme.json"
PREFS_FILE="$PREFS_DIR/ui.json"
CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"
COLORS_TOML="$CURRENT_THEME_DIR/colors.toml"

mkdir -p "$PREFS_DIR"

# 1. Determine colors.toml source
SPECIFIED_THEME="${1:-}"
if [[ -n "$SPECIFIED_THEME" && -f "$HOME/.config/omarchy/themes/$SPECIFIED_THEME/colors.toml" ]]; then
  COLORS_TOML="$HOME/.config/omarchy/themes/$SPECIFIED_THEME/colors.toml"
elif [[ -n "$SPECIFIED_THEME" && -f "/usr/share/omarchy/themes/$SPECIFIED_THEME/colors.toml" ]]; then
  COLORS_TOML="/usr/share/omarchy/themes/$SPECIFIED_THEME/colors.toml"
fi

# Fallback check
if [[ ! -f "$COLORS_TOML" ]]; then
  if [[ -f "$HOME/.local/state/omarchy/current/theme/colors.toml" ]]; then
    COLORS_TOML="$HOME/.local/state/omarchy/current/theme/colors.toml"
  fi
fi

# 2. Run Python palette synthesis
python3 - <<PY
import tomllib, json, os

def hex_to_rgb(h):
    h = h.strip().lstrip('#')
    if len(h) == 3:
        h = ''.join(c * 2 for c in h)
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def rgb_to_hex(r, g, b):
    return f"#{int(max(0, min(255, round(r)))):02x}{int(max(0, min(255, round(g)))):02x}{int(max(0, min(255, round(b)))):02x}"

def blend(c1, c2, factor):
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    return rgb_to_hex(
        r1 * (1.0 - factor) + r2 * factor,
        g1 * (1.0 - factor) + g2 * factor,
        b1 * (1.0 - factor) + b2 * factor
    )

colors_path = "$COLORS_TOML"
colors = {}
if os.path.exists(colors_path):
    try:
        with open(colors_path, "rb") as f:
            colors = tomllib.load(f)
    except Exception:
        pass

bg = colors.get("background", "#1B1B1B")
fg = colors.get("foreground", "#efebdc")
accent = colors.get("accent", colors.get("color4", "#2b47b5"))

# Palette overrides if specified by theme
dark_bg = colors.get("dark_background")
darker_bg = colors.get("darker_background")
lighter_bg = colors.get("lighter_background")
dark_fg = colors.get("dark_foreground")
light_fg = colors.get("light_foreground")
bright_fg = colors.get("bright_foreground")
muted = colors.get("muted")

c0 = colors.get("color0", bg)
c1 = colors.get("color1", colors.get("red", "#ef4444"))
c2 = colors.get("color2", colors.get("green", "#22c55e"))
c3 = colors.get("color3", colors.get("yellow", "#eab308"))
c4 = colors.get("color4", colors.get("blue", "#3b5bdb"))
c7 = colors.get("color7", fg)
c8 = colors.get("color8", blend(bg, fg, 0.3))

mode = colors.get("mode", os.environ.get("OMARCHY_THEME_MODE", ""))
r, g, b = hex_to_rgb(bg)
lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
is_light = mode == "light" or (mode != "dark" and lum > 128)

if is_light:
    # High-contrast light theme adhering to Omarchy guidelines
    title_bar = dark_bg if dark_bg else blend(bg, "#000000", 0.05)
    ribbon = bg if bg != "#ffffff" else "#f9f9f9"
    tab_strip = blend(bg, "#000000", 0.04)
    canvas = blend(bg, "#000000", 0.09)
    panel = blend(bg, "#000000", 0.02)
    border = blend(muted, bg, 0.4) if muted else blend(bg, "#000000", 0.14)
    border_strong = blend(muted, bg, 0.6) if muted else blend(bg, "#000000", 0.25)
    text = bright_fg if bright_fg else (dark_fg if dark_fg else "#242424")
    text_dim = muted if muted else blend(text, bg, 0.45)
    text_disabled = blend(text, bg, 0.65)
    icon = text_dim
    hover = blend(bg, "#000000", 0.08)
    pressed = blend(bg, "#000000", 0.16)
    checked = blend(accent, bg, 0.82)
    accent_color = accent
    accent_text = blend(accent, "#000000", 0.20)
    input_bg = "#ffffff"
    input_border = border
    group_label = blend(text, bg, 0.40)
    ruler = "#ffffff"
    ruler_margin = blend(bg, "#000000", 0.12)
    ruler_tick = text_dim
    status_bar = blend(bg, "#000000", 0.05)
    selection = f"{accent}38"
    caret = "#000000"
    page_shadow = "#00000028"
    menu = "#ffffff"
else:
    # Deep, saturated dark theme matching Omarchy themes
    title_bar = darker_bg if darker_bg else blend(bg, "#000000", 0.20)
    ribbon = lighter_bg if lighter_bg else blend(bg, "#ffffff", 0.05)
    tab_strip = darker_bg if darker_bg else blend(bg, "#000000", 0.15)
    canvas = darker_bg if darker_bg else blend(bg, "#000000", 0.35)
    panel = blend(bg, "#ffffff", 0.03)
    border = blend(muted, bg, 0.4) if muted else blend(bg, "#ffffff", 0.12)
    border_strong = blend(muted, bg, 0.6) if muted else blend(bg, "#ffffff", 0.22)
    text = bright_fg if bright_fg else (light_fg if light_fg else fg)
    text_dim = muted if muted else blend(fg, bg, 0.40)
    text_disabled = blend(fg, bg, 0.65)
    icon = text_dim
    hover = blend(bg, "#ffffff", 0.12)
    pressed = blend(bg, "#ffffff", 0.20)
    checked = blend(accent, bg, 0.65)
    accent_color = accent
    accent_text = blend(accent, "#ffffff", 0.25)
    input_bg = blend(bg, "#000000", 0.20)
    input_border = border
    group_label = blend(fg, bg, 0.40)
    ruler = blend(bg, "#ffffff", 0.06)
    ruler_margin = blend(bg, "#000000", 0.20)
    ruler_tick = text_dim
    status_bar = darker_bg if darker_bg else blend(bg, "#000000", 0.18)
    selection = f"{accent}55"
    caret = "#ffffff"
    page_shadow = "#00000070"
    menu = blend(bg, "#ffffff", 0.08)

tokens = {
    "dark": not is_light,
    "kind": "light" if is_light else "dark",
    "title_bar": title_bar,
    "ribbon": ribbon,
    "tab_strip": tab_strip,
    "canvas": canvas,
    "panel": panel,
    "border": border,
    "border_strong": border_strong,
    "text": text,
    "text_dim": text_dim,
    "text_disabled": text_disabled,
    "icon": icon,
    "hover": hover,
    "pressed": pressed,
    "checked": checked,
    "accent": accent_color,
    "accent_text": accent_text,
    "input": input_bg,
    "input_border": input_border,
    "group_label": group_label,
    "ruler": ruler,
    "ruler_margin": ruler_margin,
    "ruler_tick": ruler_tick,
    "status_bar": status_bar,
    "selection": selection,
    "caret": caret,
    "page_shadow": page_shadow,
    "menu": menu,
    "blue": c4,
    "red": c1,
    "green": c2,
    "orange": c3
}

with open("$THEME_JSON", "w") as out:
    json.dump(tokens, out, indent=2)

# Ensure dark mode preference is updated in ui.json if present
prefs_path = "$PREFS_FILE"
prefs = {}
if os.path.exists(prefs_path):
    try:
        with open(prefs_path, "r") as pf:
            prefs = json.load(pf)
    except Exception:
        pass

prefs["dark"] = not is_light

with open(prefs_path, "w") as pf:
    json.dump(prefs, pf, indent=2)
PY

# 3. If WordCraft is running on loopback, wake up and apply immediately
CONTROL_PORT="${WORDCRAFT_CONTROL_PORT:-7981}"
if command -v python3 >/dev/null 2>&1; then
  python3 - <<PY 2>/dev/null || true
import socket, json

try:
    s = socket.create_connection(("127.0.0.1", int("$CONTROL_PORT")), timeout=0.4)
    f = s.makefile("rw")
    f.write(json.dumps({"id": 1, "method": "ui.inspect", "params": {}}) + "\n")
    f.flush()
    f.readline()
    s.close()
except Exception:
    pass
PY
fi
