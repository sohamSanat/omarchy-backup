#!/usr/bin/env bash
# ==============================================================================
# omarchy-sync-gridcraft: Dynamic Theme Synchronization Engine for GridCraft
# ------------------------------------------------------------------------------
# Generates per-theme color tokens directly from Omarchy's active theme palette
# and updates ~/.config/gridcraft/theme.json for instant live hot-reloading.
# ==============================================================================
set -euo pipefail

PREFS_DIR="$HOME/.config/gridcraft"
UI_FILE="$PREFS_DIR/ui.json"
THEME_JSON="$PREFS_DIR/theme.json"
CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"
COLORS_TOML="$CURRENT_THEME_DIR/colors.toml"

mkdir -p "$PREFS_DIR"

# 1. Determine colors.toml source
SPECIFIED_THEME="${1:-}"
if [[ -n "$SPECIFIED_THEME" && -f "$HOME/.config/omarchy/themes/$SPECIFIED_THEME/colors.toml" ]]; then
  COLORS_TOML="$HOME/.config/omarchy/themes/$SPECIFIED_THEME/colors.toml"
elif [[ -n "$SPECIFIED_THEME" && -f "/usr/share/omarchy/themes/$SPECIFIED_THEME/colors.toml" ]]; then
  COLORS_TOML="/usr/share/omarchy/themes/$SPECIFIED_THEME/colors.toml"
fi

# Fallback check
if [[ ! -f "$COLORS_TOML" ]]; then
  if [[ -f "$HOME/.local/state/omarchy/current/theme/colors.toml" ]]; then
    COLORS_TOML="$HOME/.local/state/omarchy/current/theme/colors.toml"
  fi
fi

# 2. Run Python palette synthesis
python3 - <<PY
import tomllib, json, os

def hex_to_rgb(h):
    h = h.strip().lstrip('#')
    if len(h) == 3:
        h = ''.join(c * 2 for c in h)
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def rgb_to_hex(r, g, b):
    return f"#{int(max(0, min(255, round(r)))):02x}{int(max(0, min(255, round(g)))):02x}{int(max(0, min(255, round(b)))):02x}"

def blend(c1, c2, factor):
    r1, g1, b1 = hex_to_rgb(c1)
    r2, g2, b2 = hex_to_rgb(c2)
    return rgb_to_hex(
        r1 * (1.0 - factor) + r2 * factor,
        g1 * (1.0 - factor) + g2 * factor,
        b1 * (1.0 - factor) + b2 * factor
    )

colors_path = "$COLORS_TOML"
colors = {}
if os.path.exists(colors_path):
    try:
        with open(colors_path, "rb") as f:
            colors = tomllib.load(f)
    except Exception:
        pass

bg = colors.get("background", "#1B1B1B")
fg = colors.get("foreground", "#efebdc")
accent = colors.get("accent", colors.get("color4", "#107c41"))
c0 = colors.get("color0", bg)
c1 = colors.get("color1", "#ef4444")
c2 = colors.get("color2", "#107c41")
c3 = colors.get("color3", "#eab308")
c4 = colors.get("color4", accent)

r, g, b = hex_to_rgb(bg)
lum = 0.2126 * r + 0.7152 * g + 0.0722 * b
is_light = lum > 128

if is_light:
    # High-contrast light mode adhering to Omarchy theming rules
    window = blend(bg, "#000000", 0.04)
    ribbon = bg if bg != "#ffffff" else "#fafafa"
    ribbon_border = blend(bg, "#000000", 0.16)
    
    # Body text: deep contrast dark charcoal
    text = blend(fg, "#000000", 0.75) if lum > 200 else fg
    text_dim = blend(text, bg, 0.40)
    text_disabled = blend(text, bg, 0.65)
    
    accent_color = accent
    accent_dark = blend(accent, "#000000", 0.25)
    accent_soft = blend(accent, bg, 0.82)
    
    hover = blend(bg, "#000000", 0.07)
    pressed = blend(bg, "#000000", 0.15)
    separator = blend(bg, "#000000", 0.14)
    
    grid_bg = blend(bg, "#ffffff", 0.90) if bg != "#ffffff" else "#ffffff"
    gridline = blend(grid_bg, "#000000", 0.13)
    header_bg = blend(bg, "#000000", 0.05)
    header_text = blend(text, "#000000", 0.15)
    header_line = blend(bg, "#000000", 0.20)
    header_sel_bg = blend(accent, bg, 0.75)
    header_sel_text = accent_color
    header_all_bg = blend(accent, bg, 0.85)
    
    sel_fill = blend(accent, grid_bg, 0.82)
    sel_border = accent_color
    
    input_bg = grid_bg
    input_border = blend(bg, "#000000", 0.22)
    tab_bar = blend(bg, "#000000", 0.04)
    tab_active = grid_bg
    status_bar = blend(bg, "#000000", 0.05)
    cell_text = text
    menu_bg = grid_bg
    shadow = "#00000028"
    danger = c1
else:
    # Deep, atmospheric dark mode matching the active Omarchy theme
    window = bg
    ribbon = blend(bg, "#ffffff", 0.05)
    ribbon_border = blend(bg, "#ffffff", 0.13)
    
    text = fg
    text_dim = blend(fg, bg, 0.35)
    text_disabled = blend(fg, bg, 0.60)
    
    accent_color = accent
    accent_dark = blend(accent, "#000000", 0.25)
    accent_soft = blend(accent, bg, 0.65)
    
    hover = blend(bg, "#ffffff", 0.10)
    pressed = blend(bg, "#ffffff", 0.18)
    separator = blend(bg, "#ffffff", 0.12)
    
    # Atmospheric spreadsheet sheet matching theme tone
    grid_bg = blend(bg, "#000000", 0.15)
    gridline = blend(bg, "#ffffff", 0.10)
    header_bg = blend(bg, "#000000", 0.28)
    header_text = blend(fg, bg, 0.20)
    header_line = blend(bg, "#ffffff", 0.14)
    header_sel_bg = blend(accent, bg, 0.60)
    header_sel_text = accent_color
    header_all_bg = blend(accent, bg, 0.70)
    
    sel_fill = blend(accent, grid_bg, 0.75)
    sel_border = accent_color
    
    input_bg = blend(bg, "#000000", 0.35)
    input_border = blend(bg, "#ffffff", 0.18)
    tab_bar = blend(bg, "#000000", 0.25)
    tab_active = blend(bg, "#ffffff", 0.08)
    status_bar = blend(bg, "#000000", 0.30)
    cell_text = fg
    menu_bg = blend(bg, "#000000", 0.30)
    shadow = "#0000005a"
    danger = c1

tokens = {
    "dark": not is_light,
    "window": window,
    "ribbon": ribbon,
    "ribbon_border": ribbon_border,
    "text": text,
    "text_dim": text_dim,
    "text_disabled": text_disabled,
    "accent": accent_color,
    "accent_dark": accent_dark,
    "accent_soft": accent_soft,
    "hover": hover,
    "pressed": pressed,
    "separator": separator,
    "grid_bg": grid_bg,
    "gridline": gridline,
    "header_bg": header_bg,
    "header_text": header_text,
    "header_line": header_line,
    "header_sel_bg": header_sel_bg,
    "header_sel_text": header_sel_text,
    "header_all_bg": header_all_bg,
    "sel_fill": sel_fill,
    "sel_border": sel_border,
    "input_bg": input_bg,
    "input_border": input_border,
    "tab_bar": tab_bar,
    "tab_active": tab_active,
    "status_bar": status_bar,
    "cell_text": cell_text,
    "menu_bg": menu_bg,
    "shadow": shadow,
    "danger": danger
}

with open("$THEME_JSON", "w") as out:
    json.dump(tokens, out, indent=2)

# Update ui.json persistence
ui_path = "$UI_FILE"
ui_data = {}
if os.path.exists(ui_path):
    try:
        with open(ui_path, "r") as uf:
            ui_data = json.load(uf)
    except Exception:
        pass

ui_data["dark"] = not is_light
if "formula_bar" not in ui_data:
    ui_data["formula_bar"] = True
if "ribbon_tab" not in ui_data:
    ui_data["ribbon_tab"] = "Home"

with open(ui_path, "w") as uf:
    json.dump(ui_data, uf, indent=2)
PY

# 3. If GridCraft is running on loopback, wake up and apply immediately
CONTROL_PORT="${GRIDCRAFT_CONTROL_PORT:-7981}"
if command -v python3 >/dev/null 2>&1; then
  python3 - <<PY 2>/dev/null || true
import socket, json

try:
    s = socket.create_connection(("127.0.0.1", int("$CONTROL_PORT")), timeout=0.3)
    f = s.makefile("rw")
    # Trigger an inspect ping to immediately wake up the egui event loop and poll LiveTokens
    f.write(json.dumps({"id": 1, "method": "ui.inspect", "params": {}}) + "\n")
    f.flush()
    f.readline()
    s.close()
except Exception:
    pass
PY
fi
