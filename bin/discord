#!/bin/sh

CHANNEL=stable
DOWNLOAD=https://updates.discord.com/
DIR=discord
EXE=Discord
BOOTSTRAP_SUFFIX=discord/updater_bootstrap

config_home=$XDG_CONFIG_HOME
if [ -z "$config_home" ]; then
    config_home=$HOME/.config
fi

discord_host=$config_home/$DIR/$EXE

# Clean up stale locks if no Discord process is running
if ! pgrep -u $(id -u) -x Discord >/dev/null 2>&1; then
    rm -f "$config_home/$DIR"/Singleton* "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/discord-ipc-* 2>/dev/null
fi

mkdir -p "$config_home/$DIR/logs"
log_file="$config_home/$DIR/logs/discord-stdout.log"
if [ -f "$log_file" ] && [ $(stat -c%s "$log_file" 2>/dev/null || echo 0) -gt 10485760 ]; then
    mv -f "$log_file" "$log_file.old"
fi

if [ ! -x "$discord_host" ]; then
    mkdir -p "$config_home/$DIR"
    if [ ! -d "$config_home/$DIR" ]; then
        echo "Fatal error, failed to create $DIR in $config_home" >&2
        exit 1
    fi
    if [ -t 1 ]; then
        zenity=--no-zenity
    else
        zenity=--zenity
    fi
    bootstrap=/usr/share/$BOOTSTRAP_SUFFIX
    if [ ! -x "$bootstrap" ]; then
        bootstrap="$HOME/.local/share/$BOOTSTRAP_SUFFIX"
        if [ ! -x "$bootstrap" ]; then
            bootstrap=/opt/$BOOTSTRAP_SUFFIX
            if [ ! -x "$bootstrap" ]; then
                bootstrap=`dirname -- "$0"`/updater_bootstrap
            fi
        fi
    fi
    app_dir=`"$bootstrap" $zenity "$config_home/$DIR" $CHANNEL "$DOWNLOAD"`

    if [ $? -eq 0 ] ; then
        echo "Bootstrap complete"
        exec "$config_home/$DIR/$app_dir/$EXE" "$@" >> "$log_file" 2>&1 < /dev/null
    else
        echo "Bootstrap failed or was canceled"
        exit 2
    fi
fi

# Ensure duplicate Discord.desktop symlink is removed
rm -f "$HOME/.local/share/applications/Discord.desktop" 2>/dev/null || true

# Ensure Omarchy Discord theme hook is present
HOOK_SCRIPT="$HOME/.local/share/omarchy/discord/omarchy-discord.js"
for core_idx in "$config_home/$DIR"/app-*/modules/discord_desktop_core-*/discord_desktop_core/index.js; do
    if [ -f "$core_idx" ] && [ -f "$HOOK_SCRIPT" ]; then
        if ! grep -q "omarchy-discord" "$core_idx"; then
            sed -i 's|module.exports = require(..core.asar.);|try { require("'"$HOOK_SCRIPT"'"); } catch(e){} module.exports = require("./core.asar");|' "$core_idx"
        fi
    fi
done

# Ensure theme CSS is generated if missing
if [ ! -f "$HOME/.local/state/omarchy/current/theme/discord-theme.css" ] && [ -x "$HOME/.config/omarchy/hooks/theme-set.d/discord-sync.sh" ]; then
    "$HOME/.config/omarchy/hooks/theme-set.d/discord-sync.sh" >/dev/null 2>&1 || true
fi

exec "$discord_host" "$@" >> "$log_file" 2>&1 < /dev/null
