#!/bin/bash

# omarchy:summary=Run the Omarchy screensaver and lock system when dismissed

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

in_exit=0

exit_screensaver() {
  if (( in_exit )); then
    return
  fi
  in_exit=1

  # Restore cursor visibility
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true

  # Disable terminal mouse tracking
  printf '\033[?1000l\033[?1002l\033[?1006l' 2>/dev/null || true

  # Stop animation process
  pkill -x ttfx 2>/dev/null || true

  # Blank the screen to prevent any desktop flash
  clear 2>/dev/null || true
  printf '\033]11;rgb:00/00/00\007\033[2J\033[H' 2>/dev/null || true

  # Trigger system lock immediately
  omarchy-system-lock >/dev/null 2>&1 &

  # Wait for lock to engage (up to 1.5 seconds)
  for ((i = 0; i < 30; i++)); do
    if [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]]; then
      break
    fi
    sleep 0.05
  done

  # Terminate screensaver window
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null || true
  exit 0
}

# Exit screensaver on any signal
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

# Set background to black and hide cursor
printf '\033]11;rgb:00/00/00\007'
hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

# Enable mouse button tracking so mouse clicks also break free
printf '\033[?1000h\033[?1002h\033[?1006h' 2>/dev/null || true

tty=$(tty 2>/dev/null)

wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

# Record initial cursor position
initial_pos=$(hyprctl cursorpos 2>/dev/null)

while true; do
  ttfx -i ~/.config/omarchy/branding/screensaver.txt \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --no-eol --no-restore-cursor &

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    # 1. Key or mouse click on terminal stdin
    if read -n1 -t 0.5; then
      exit_screensaver
    fi

    # 2. Window focus lost
    if ! screensaver_in_focus; then
      exit_screensaver
    fi

    # 3. Cursor moved significantly (distance > 10 pixels to ignore micro-jitter)
    curr_pos=$(hyprctl cursorpos 2>/dev/null)
    if [[ -z $initial_pos ]]; then
      initial_pos="$curr_pos"
    elif [[ -n $curr_pos ]]; then
      IFS=', ' read -r x1 y1 <<< "$initial_pos"
      IFS=', ' read -r x2 y2 <<< "$curr_pos"
      dx=$(( x2 - x1 ))
      dy=$(( y2 - y1 ))
      if (( dx*dx + dy*dy > 100 )); then
        exit_screensaver
      fi
    fi
  done
done
