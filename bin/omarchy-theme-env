#!/usr/bin/env python3
"""
omarchy-theme-env: Universal theme mode detection and environment synchronization for Omarchy.
Provides fast, zero-dependency theme state inspection (light vs dark mode) and generates
shell environment variables (OMARCHY_THEME_MODE, COLORFGBG, etc.) across all terminal sessions.
"""

import sys
import os
import json


def get_theme_info():
    theme_state_dir = os.path.expanduser("~/.local/state/omarchy/current/theme")
    theme_name_file = os.path.expanduser("~/.local/state/omarchy/current/theme.name")

    theme_name = "unknown"
    if os.path.exists(theme_name_file):
        try:
            with open(theme_name_file, "r") as f:
                theme_name = f.read().strip()
        except Exception:
            pass

    mode = "dark"
    foreground = "#ffffff"
    background = "#000000"
    accent = "#7aa2f7"

    # 1. Check light.mode marker
    if os.path.exists(os.path.join(theme_state_dir, "light.mode")):
        mode = "light"

    # 2. Parse colors.toml
    colors_file = os.path.join(theme_state_dir, "colors.toml")
    if os.path.exists(colors_file):
        try:
            with open(colors_file, "r") as f:
                content = f.read()
            if 'mode = "light"' in content or "mode = 'light'" in content:
                mode = "light"
            elif 'mode = "dark"' in content or "mode = 'dark'" in content:
                mode = "dark"

            for line in content.splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip("\"'")
                    if k == "foreground":
                        foreground = v
                    elif k == "background":
                        background = v
                        if v.startswith("#") and len(v) >= 7 and mode == "dark":
                            r = int(v[1:3], 16)
                            g = int(v[3:5], 16)
                            b = int(v[5:7], 16)
                            # Omarchy threshold for light mode
                            if (r + g + b) > 382:
                                mode = "light"
                    elif k == "accent":
                        accent = v
        except Exception:
            pass

    colorfgbg = "0;15" if mode == "light" else "15;0"

    return {
        "name": theme_name,
        "mode": mode,
        "is_light": mode == "light",
        "is_dark": mode == "dark",
        "foreground": foreground,
        "background": background,
        "accent": accent,
        "colorfgbg": colorfgbg,
    }


def sync_env(info):
    state_dir = os.path.expanduser("~/.local/state/omarchy")
    os.makedirs(state_dir, exist_ok=True)
    env_file = os.path.join(state_dir, "theme-mode.env")

    content = f"""# Automatically generated by omarchy-theme-env - do not hand-edit
export OMARCHY_THEME_NAME="{info['name']}"
export OMARCHY_THEME_MODE="{info['mode']}"
export COLORFGBG="{info['colorfgbg']}"
export OMARCHY_THEME_FG="{info['foreground']}"
export OMARCHY_THEME_BG="{info['background']}"
export OMARCHY_THEME_ACCENT="{info['accent']}"
_OMARCHY_THEME_ENV_LOADED="{env_file}"
"""
    with open(env_file, "w") as f:
        f.write(content)

    mode_file = os.path.join(state_dir, "current", "theme", "mode")
    try:
        with open(mode_file, "w") as f:
            f.write(f"{info['mode']}\n")
    except Exception:
        pass


def main():
    info = get_theme_info()

    if len(sys.argv) > 1:
        cmd = sys.argv[1].lower().strip("-")
        if cmd in ("sync", "update", "write"):
            sync_env(info)
            print(f"Synced Omarchy theme environment: mode={info['mode']} ({info['name']})")
            return
        elif cmd in ("json", "j"):
            print(json.dumps(info, indent=2))
            return
        elif cmd in ("export", "env", "sh", "bash"):
            print(f'export OMARCHY_THEME_NAME="{info["name"]}"')
            print(f'export OMARCHY_THEME_MODE="{info["mode"]}"')
            print(f'export COLORFGBG="{info["colorfgbg"]}"')
            print(f'export OMARCHY_THEME_FG="{info["foreground"]}"')
            print(f'export OMARCHY_THEME_BG="{info["background"]}"')
            print(f'export OMARCHY_THEME_ACCENT="{info["accent"]}"')
            return
        elif cmd in ("is-light", "light?"):
            sys.exit(0 if info["is_light"] else 1)
        elif cmd in ("is-dark", "dark?"):
            sys.exit(0 if info["is_dark"] else 1)
        elif cmd in ("fg", "foreground"):
            print(info["foreground"])
            return
        elif cmd in ("bg", "background"):
            print(info["background"])
            return
        elif cmd in ("name", "theme"):
            print(info["name"])
            return

    # Default: print mode string ("light" or "dark")
    print(info["mode"])


if __name__ == "__main__":
    main()
