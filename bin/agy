#!/usr/bin/env bash
# Antigravity CLI Autonomous Folder-Trust Wrapper
# Automatically pre-registers current working directory and any workspace arguments
# into ~/.gemini/antigravity-cli/settings.json before executing the real binary,
# guaranteeing that interactive "Do you trust this folder" prompts NEVER brick autonomous workflows.

SETTINGS_FILE="$HOME/.gemini/antigravity-cli/settings.json"
REAL_BIN="/home/soham/.local/bin/agy-real"

if [ -f "$SETTINGS_FILE" ]; then
    python3 - "$SETTINGS_FILE" "$PWD" "$@" << 'PYEOF' 2>/dev/null || true
import sys, json, os

settings_file = sys.argv[1]
cwd = sys.argv[2]
args = sys.argv[3:]

candidates = {cwd, os.path.realpath(cwd)}

for idx, arg in enumerate(args):
    if arg in ("--add-dir", "--project", "--workspace") and idx + 1 < len(args):
        cand = args[idx + 1]
        candidates.add(cand)
        if os.path.exists(cand):
            candidates.add(os.path.realpath(cand))
    elif os.path.isdir(arg):
        candidates.add(arg)
        candidates.add(os.path.realpath(arg))

try:
    with open(settings_file, "r", encoding="utf-8") as f:
        data = json.load(f)
    tw = data.setdefault("trustedWorkspaces", [])
    tw_set = set(tw)
    changed = False

    for c in candidates:
        if c and c not in tw_set:
            tw.append(c)
            tw_set.add(c)
            changed = True

    if data.get("allowNonWorkspaceAccess") is not True:
        data["allowNonWorkspaceAccess"] = True
        changed = True

    if data.get("toolPermission") != "always-proceed":
        data["toolPermission"] = "always-proceed"
        changed = True

    if changed:
        tmp_file = settings_file + ".tmp"
        with open(tmp_file, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
        os.replace(tmp_file, settings_file)
except Exception:
    pass

hooks_file = os.path.expanduser("~/.gemini/config/hooks.json")
try:
    hooks_data = {}
    if os.path.exists(hooks_file):
        with open(hooks_file, "r", encoding="utf-8") as f:
            hooks_data = json.load(f)
    if "ask-question-ting" not in hooks_data:
        hooks_data["ask-question-ting"] = {
            "PreToolUse": [
                {
                    "matcher": "*",
                    "hooks": [
                        {
                            "command": "/home/soham/.gemini/config/hooks/ring-ting.sh",
                            "timeout": 5,
                            "type": "command"
                        }
                    ]
                }
            ]
        }
        os.makedirs(os.path.dirname(hooks_file), exist_ok=True)
        tmp_hooks = hooks_file + ".tmp"
        with open(tmp_hooks, "w", encoding="utf-8") as f:
            json.dump(hooks_data, f, indent=2)
        os.replace(tmp_hooks, hooks_file)
except Exception:
    pass
PYEOF
fi

# Ensure option-selection ting watcher daemon is active
if ! systemctl --user is-active --quiet antigravity-ting.service 2>/dev/null; then
    if ! pgrep -f agy-ting-watcher >/dev/null 2>&1; then
        nohup /home/soham/.local/bin/agy-ting-watcher >/dev/null 2>&1 &
    fi
fi

if [ -x "$REAL_BIN" ]; then
    exec "$REAL_BIN" "$@"
else
    echo "Error: Antigravity real binary not found at $REAL_BIN" >&2
    exit 1
fi
