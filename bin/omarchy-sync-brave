#!/bin/bash
set -euo pipefail

# ==============================================================================
# Omarchy -> Brave Dynamic Theme & Polish Sync
# ------------------------------------------------------------------------------
# Script: ~/.local/bin/omarchy-sync-brave
# Purpose: Synchronizes Brave's browser chrome, New Tab Page, and page polish
#          with the active Omarchy system theme - the same treatment Zen gets.
#
# TARGET: Brave Origin Nightly (brave-origin-nightly-bin). The launcher script
# /usr/bin/brave-origin-nightly reads ~/.config/brave-origin-nightly-flags.conf;
# that file is what makes this whole design automatic. Note that Omarchy's own
# `omarchy install browser brave-origin` writes ~/.config/brave-origin-flags.conf,
# which this package does NOT read - hence the separate name here.
#
# ARCHITECTURE OVERVIEW
#
# 1. Templates (auto-compiled by omarchy-theme-set-templates on theme set, and
#    re-compiled here by ensure_theme_compiled):
#    - ~/.config/omarchy/themed/brave-ntp.css.tpl     -> .../current/theme/brave-ntp.css
#    - ~/.config/omarchy/themed/brave-polish.css.tpl  -> .../current/theme/brave-polish.css
#    - ~/.config/omarchy/themed/brave-polish.json.tpl -> .../current/theme/brave-polish.json
#    - ~/.config/omarchy/themed/brave-manifest.json.tpl -> .../current/theme/brave-manifest.json
#    - ~/.config/omarchy/themed/brave-global.css.tpl  -> .../current/theme/brave-global.css
#    - ~/.config/omarchy/themed/brave-theme.json.tpl  -> .../current/theme/brave-theme.json
#
# 2. Extensions, loaded automatically on every launch via --load-extension in
#    ~/.config/brave-origin-nightly-flags.conf (no manual "Load unpacked" step):
#    - ~/.config/omarchy/brave-polish  (MV3): global.css on all sites, ntp.html.
#      global.js/ntp.js re-fetch their CSS from disk on EVERY navigation, so the
#      theme hot-applies with no restart.
#    - ~/.config/omarchy/brave-theme   (MV3 theme): frame/toolbar/tab/omnibox/NTP
#      colors. Chromium reads a theme manifest at extension-load time only, so
#      this one needs a Brave restart - use `--restart` to apply it instantly.
#
# 3. Toolbar color, live: stock Omarchy writes BrowserThemeColor into
#    /etc/brave/policies/managed/color.json on every theme set. Omarchy's own
#    refresh step does not recognise the `brave-origin-nightly` launcher, so this
#    script issues the --refresh-platform-policy call itself (user space only).
#
# 4. IMPORTANT: /etc/brave/policies/managed/extensions.json sets
#    ExtensionInstallAllowlist, which makes Brave treat every extension NOT on
#    that list as "blocked by the administrator" - including --load-extension
#    ones. Any new extension directory added here must have its id appended to
#    that allowlist, or Brave will silently refuse to load it.
#
# 5. Automation: ~/.config/omarchy/hooks/theme-set.d/brave-sync.sh runs
#    `omarchy-sync-brave --sync` after every `omarchy theme set`.
#
# 6. Dark Reader is intentionally untouched (user's choice). The fork at
#    ~/.config/omarchy/brave-darkreader owns full-page recolor.
# ==============================================================================

CURRENT_THEME_DIR="$HOME/.local/state/omarchy/current/theme"
EXT_DIR="$HOME/.config/omarchy/brave-polish"
USER_THEMED_DIR="$HOME/.config/omarchy/themed"
FORK_DIR="$HOME/.config/omarchy/brave-darkreader"
FLAGS_FILE="$HOME/.config/brave-origin-nightly-flags.conf"
STOCK_FLAGS="${OMARCHY_PATH:-/usr/share/omarchy}/config/chromium-flags.conf"
LAUNCHER="/usr/bin/brave-origin-nightly"
BROWSER_BIN="/opt/brave.com/brave-origin-nightly/brave"
ALLOWLIST="/etc/brave/policies/managed/extensions.json"

show_help() {
  cat <<'EOF'
Usage: omarchy-sync-brave [OPTIONS]

Synchronize Brave's chrome, New Tab Page, and page polish with the active
Omarchy theme.

Options:
  --sync       Recompile templates, deploy both extensions, refresh flags (default)
  --restart    Gracefully restart Brave Origin Nightly so theme-extension
               changes (chrome colors) take effect
  --status     Show theme, extension, flags, policy, and process status
  -h, --help   Display this help message

Extensions load automatically via --load-extension in
~/.config/brave-origin-nightly-flags.conf, so there is no manual
"Load unpacked" step. Every `omarchy theme set` hot-applies the NTP and
page polish; the browser chrome follows on the next Brave restart
(`--restart` applies it immediately).
EOF
}

# Compile a template with {{ key }} placeholders from colors.toml.
# Mirrors omarchy-theme-set-templates resolution via omarchy-theme-color --all.
compile_template_if_needed() {
  local tpl_path="$1"
  local out_path="$2"

  if [[ -f "$out_path" && -f "$tpl_path" && "$out_path" -nt "$tpl_path" ]]; then
    return 0
  fi
  if [[ ! -f "$tpl_path" ]]; then
    echo "[omarchy-sync-brave] Warning: template $tpl_path not found. Skipping." >&2
    return 0
  fi

  local colors_file="$CURRENT_THEME_DIR/colors.toml"
  if [[ ! -f "$colors_file" ]]; then
    echo "[omarchy-sync-brave] Warning: $colors_file not found. Cannot compile $(basename "$out_path")." >&2
    return 1
  fi

  local sed_script
  sed_script=$(mktemp)
  omarchy-theme-color --file "$colors_file" --all 2>/dev/null | awk -F'\t' '{print "s|{{ " $1 " }}|" $2 "|g"}' > "$sed_script"
  # Also support {{ key_rgb }} and {{ key_strip }} like omarchy-theme-set-templates
  while IFS=$'\t' read -r key value; do
    if [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]]; then
      local hex="${value#\#}"
      local rgb
      rgb=$(printf "%d,%d,%d" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}")
      printf 's|{{ %s_rgb }}|%s|g\n' "$key" "$rgb" >> "$sed_script"
      printf 's|{{ %s_strip }}|%s|g\n' "$key" "$hex" >> "$sed_script"
    fi
  done < <(omarchy-theme-color --file "$colors_file" --all 2>/dev/null)

  sed -f "$sed_script" "$tpl_path" > "$out_path"
  rm -f "$sed_script"
  echo "[omarchy-sync-brave] Compiled $(basename "$out_path")."
}

ensure_theme_compiled() {
  compile_template_if_needed "$USER_THEMED_DIR/brave-ntp.css.tpl" "$CURRENT_THEME_DIR/brave-ntp.css"
  compile_template_if_needed "$USER_THEMED_DIR/brave-polish.css.tpl" "$CURRENT_THEME_DIR/brave-polish.css"
  compile_template_if_needed "$USER_THEMED_DIR/brave-polish.json.tpl" "$CURRENT_THEME_DIR/brave-polish.json"
  compile_template_if_needed "$USER_THEMED_DIR/brave-manifest.json.tpl" "$CURRENT_THEME_DIR/brave-manifest.json"
  compile_template_if_needed "$USER_THEMED_DIR/brave-global.css.tpl" "$CURRENT_THEME_DIR/brave-global.css"
}

# ------------------------------------------------------------------------------
# The launcher /usr/bin/brave-origin-nightly reads this exact file (brave-origin
# and brave-browser packages read differently named ones). Omarchy's
# `omarchy install browser brave-origin` copies chromium-flags.conf to
# ~/.config/brave-origin-flags.conf, which this package never opens - so without
# this file Brave gets none of Omarchy's Chromium flags and, crucially, no
# --load-extension, which would silently disable the whole theme pipeline.
#
# The file is rebuilt from Omarchy's stock flags every run so it keeps tracking
# upstream, with our extension directories appended exactly once.
# ------------------------------------------------------------------------------
EXTENSION_DIRS=(
  "$EXT_DIR"        # MV3: all-site CSS + New Tab Page
)

write_flags_file() {
  # CRITICAL FORMAT CONSTRAINT
  # /usr/bin/brave-origin-nightly does:
  #     USER_FLAGS="$(cat "$USER_FLAGS_FILE" | sed 's/#.*//')"
  #     exec ".../brave-origin" "$USER_FLAGS" ...
  # The variable is QUOTED, so the whole file arrives as ONE argv element, and
  # the command substitution keeps interior blank lines. Consequences:
  #   * more than one switch on the file puts every switch after the first into
  #     the first switch value, and Brave aborts during startup;
  #   * a leading comment line becomes a leading newline, so the single argument
  #     no longer starts with "--" and Brave treats it as a URL.
  # So this file must be exactly one line, holding exactly one switch. Omarchy's
  # other Chromium flags (ozone, password-store, overscroll) are deliberately not
  # written here: adding them would break everything. Only --load-extension is
  # load-bearing for the theme pipeline.
  local stock_load_ext=""
  local line trimmed

  if [[ -f "$STOCK_FLAGS" ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      trimmed="${line%%#*}"
      trimmed="${trimmed#"${trimmed%%[![:space:]]*}"}"
      trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
      [[ -z "$trimmed" ]] && continue
      if [[ $trimmed == --load-extension=* ]]; then
        stock_load_ext="${trimmed#--load-extension=}"
      fi
    done < "$STOCK_FLAGS"
  fi

  local load_ext="$stock_load_ext"
  local dir
  for dir in "${EXTENSION_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    # Skip anything already present so re-runs cannot duplicate the list.
    [[ ",$load_ext," == *",$dir,"* ]] && continue
    if [[ -n "$load_ext" ]]; then
      load_ext="$load_ext,$dir"
    else
      load_ext="$dir"
    fi
  done

  if [[ -z "$load_ext" ]]; then
    echo "[omarchy-sync-brave] WARNING: no extension directories to load; leaving $FLAGS_FILE untouched." >&2
    return 0
  fi

  local tmp
  tmp=$(mktemp)
  printf '%s\n' "--load-extension=$load_ext" > "$tmp"

  if [[ -f "$FLAGS_FILE" ]] && cmp -s "$tmp" "$FLAGS_FILE"; then
    rm -f "$tmp"
    return 0
  fi

  mkdir -p "$(dirname "$FLAGS_FILE")"
  mv "$tmp" "$FLAGS_FILE"
  echo "[omarchy-sync-brave] Wrote $FLAGS_FILE (single --load-extension switch)."
}

# ------------------------------------------------------------------------------
# Omarchy's omarchy-theme-set-browser tries to refresh a running browser with
#   refresh_running_browser /opt/brave-origin-bin/ brave-origin -f
# and with `omarchy-cmd-present brave`. Neither matches brave-origin-nightly-bin
# (binary /usr/bin/brave-origin-nightly, process /opt/.../brave), so the running
# browser is never told to re-read BrowserThemeColor and the toolbar keeps the
# previous theme's colour until a full restart. This does the refresh itself.
# User space only - no /etc policies, Preferences, or Secure Preferences.
# ------------------------------------------------------------------------------
running_brave_pid() {
  pgrep -f "$BROWSER_BIN" 2>/dev/null | head -1 || true
}

refresh_running_browser() {
  local pid
  pid=$(running_brave_pid)
  if [[ -z "$pid" ]]; then
    return 0
  fi

  if [[ -x "$LAUNCHER" ]]; then
    "$LAUNCHER" --refresh-platform-policy --no-startup-window >/dev/null 2>&1 &
  fi
  if [[ -x "$BROWSER_BIN" ]]; then
    "$BROWSER_BIN" --refresh-platform-policy --no-startup-window >/dev/null 2>&1 &
  fi
  echo "[omarchy-sync-brave] Asked running Brave (PID $pid) to re-read platform policy (live theme colors update)."
}

is_allowlisted() {
  local id=$1
  [[ -r "$ALLOWLIST" ]] || return 0
  grep -q "\"$id\"" "$ALLOWLIST"
}

extension_id_for_dir() {
  python3 - "$1" <<'PY'
import hashlib, sys
path = sys.argv[1]
digest = hashlib.sha256(path.encode()).hexdigest()[:32]
print(''.join(chr(ord('a') + int(c, 16)) for c in digest))
PY
}

sync_brave_profile_state() {
  python3 - "$CURRENT_THEME_DIR/colors.toml" <<'PY'
import json, os, sys

colors_file = sys.argv[1] if len(sys.argv) > 1 else ''
local_state_file = os.path.expanduser('~/.config/BraveSoftware/Brave-Origin-Nightly/Local State')
prefs_file = os.path.expanduser('~/.config/BraveSoftware/Brave-Origin-Nightly/Default/Preferences')

accent_hex = '#BE3F50'
bg_hex = '#0e091d'
if colors_file and os.path.exists(colors_file):
    with open(colors_file) as f:
        for line in f:
            if line.startswith('accent ='):
                accent_hex = line.split('=')[1].strip().strip('"\'')
            elif line.startswith('background ='):
                bg_hex = line.split('=')[1].strip().strip('"\'')

def hex_to_signed_int(h):
    h = h.lstrip('#')
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    val = (0xff << 24) | (r << 16) | (g << 8) | b
    return val if val < 0x80000000 else val - 0x100000000

seed_int = hex_to_signed_int(accent_hex)
bg_int = hex_to_signed_int(bg_hex)

if os.path.exists(local_state_file):
    try:
        with open(local_state_file, 'r') as f:
            ls = json.load(f)
        profile_def = ls.setdefault('profile', {}).setdefault('info_cache', {}).setdefault('Default', {})
        profile_def['profile_color_seed'] = seed_int
        profile_def['profile_highlight_color'] = bg_int
        profile_def['default_avatar_fill_color'] = bg_int
        with open(local_state_file, 'w') as f:
            json.dump(ls, f)
    except Exception:
        pass

if os.path.exists(prefs_file):
    try:
        with open(prefs_file, 'r') as f:
            pref = json.load(f)
        if 'extensions' in pref and 'theme' in pref['extensions']:
            del pref['extensions']['theme']
        pref['homepage'] = 'file://' + os.path.expanduser('~/.config/omarchy/brave-polish/ntp.html')
        pref['homepage_is_newtabpage'] = False
        pref.setdefault('brave', {}).setdefault('new_tab_page', {})['shows_options'] = 1
        with open(prefs_file, 'w') as f:
            json.dump(pref, f)
    except Exception:
        pass
PY
}

do_sync() {
  ensure_theme_compiled || return 1
  mkdir -p "$EXT_DIR"

  local copied=0
  declare -A pairs=(
    ["$CURRENT_THEME_DIR/brave-ntp.css"]="$EXT_DIR/ntp.css"
    ["$CURRENT_THEME_DIR/brave-polish.css"]="$EXT_DIR/polish.css"
    ["$CURRENT_THEME_DIR/brave-polish.json"]="$EXT_DIR/theme.json"
    ["$CURRENT_THEME_DIR/brave-manifest.json"]="$EXT_DIR/manifest.json"
    ["$CURRENT_THEME_DIR/brave-global.css"]="$EXT_DIR/global.css"
  )
  local src dest
  for src in "${!pairs[@]}"; do
    dest="${pairs[$src]}"
    if [[ -f "$src" ]]; then
      cp "$src" "$dest"
      ((copied++)) || true
    else
      echo "[omarchy-sync-brave] Warning: $src missing, skipped." >&2
    fi
  done

  # Fail loudly if a raw {{ placeholder }} survived compilation.
  if grep -q "{{" "$EXT_DIR/ntp.css" "$EXT_DIR/polish.css" "$EXT_DIR/global.css" "$EXT_DIR/theme.json" "$EXT_DIR/manifest.json" 2>/dev/null; then
    echo "[omarchy-sync-brave] ERROR: unresolved {{ placeholder }} in extension outputs." >&2
    grep -H "{{" "$EXT_DIR/ntp.css" "$EXT_DIR/polish.css" "$EXT_DIR/global.css" "$EXT_DIR/theme.json" "$EXT_DIR/manifest.json" 2>/dev/null || true
    return 1
  fi

  # Feed the Dark Reader fork (Zen treatment): popup styling + theme tokens.
  # The fork reads config/omarchy-theme.json from disk on every toggle/refresh
  # and rebuilds its dynamic theme, so this hot-applies on next navigation.
  if [[ -d "$FORK_DIR" ]]; then
    if [[ -f "$CURRENT_THEME_DIR/zen-darkreader.css" ]]; then
      cp "$CURRENT_THEME_DIR/zen-darkreader.css" "$FORK_DIR/ui/popup/omarchy-theme.css"
      ((copied++)) || true
    fi
    if [[ -f "$CURRENT_THEME_DIR/zen-darkreader-theme.json" ]]; then
      cp "$CURRENT_THEME_DIR/zen-darkreader-theme.json" "$FORK_DIR/config/omarchy-theme.json"
      ((copied++)) || true
    fi
    if grep -q "{{" "$FORK_DIR/ui/popup/omarchy-theme.css" "$FORK_DIR/config/omarchy-theme.json" 2>/dev/null; then
      echo "[omarchy-sync-brave] ERROR: unresolved {{ placeholder }} in Dark Reader fork outputs." >&2
      return 1
    fi
  fi

  # Validate generated JSON outputs.
  python3 -c "import json; json.load(open('$EXT_DIR/theme.json')); json.load(open('$EXT_DIR/manifest.json'))" 2>/dev/null || {
    echo "[omarchy-sync-brave] ERROR: generated theme.json / manifest.json is invalid JSON." >&2
    return 1
  }

  write_flags_file
  sync_brave_profile_state

  echo "[omarchy-sync-brave] Synced $copied file(s) (NTP + page polish + profile state hot-apply)."

  refresh_running_browser
}

# ------------------------------------------------------------------------------
# A Chromium theme manifest is only read when the extension loads, so new chrome
# colours need a fresh browser start. Session restore makes this cheap: quit,
# wait for the process to leave, relaunch detached through the Omarchy launcher.
# Mirrors `omarchy-sync-zen --restart`.
# ------------------------------------------------------------------------------
do_restart() {
  local pid
  pid=$(running_brave_pid)

  if [[ -n "$pid" ]]; then
    echo "[omarchy-sync-brave] Closing Brave (PID $pid)..."
    "$LAUNCHER" --refresh-platform-policy >/dev/null 2>&1 || true
    pkill -f "$BROWSER_BIN" 2>/dev/null || true

    local waited=0
    while pgrep -f "$BROWSER_BIN" >/dev/null 2>&1 && (( waited < 40 )); do
      sleep 0.5
      ((waited++)) || true
    done

    if pgrep -f "$BROWSER_BIN" >/dev/null 2>&1; then
      echo "[omarchy-sync-brave] Brave did not exit cleanly; sending SIGKILL." >&2
      pkill -9 -f "$BROWSER_BIN" 2>/dev/null || true
      sleep 1
    fi
  else
    echo "[omarchy-sync-brave] Brave is not running; starting it."
  fi

  if [[ ! -x "$LAUNCHER" ]]; then
    echo "[omarchy-sync-brave] ERROR: $LAUNCHER not found; launch Brave yourself." >&2
    return 1
  fi

  setsid "$LAUNCHER" >/dev/null 2>&1 < /dev/null &
  disown 2>/dev/null || true
  echo "[omarchy-sync-brave] Brave relaunched with the current theme."
}

do_status() {
  echo "=================================================================="
  echo " Omarchy Brave Theme Status"
  echo "=================================================================="
  local current_theme="unknown"
  if [[ -f "$HOME/.local/state/omarchy/current/theme.name" ]]; then
    current_theme=$(cat "$HOME/.local/state/omarchy/current/theme.name")
  fi
  echo "Active Omarchy Theme : $current_theme"
  echo "Current Theme Dir    : $CURRENT_THEME_DIR"
  for f in brave-ntp.css brave-polish.css brave-global.css brave-polish.json brave-manifest.json; do
    if [[ -f "$CURRENT_THEME_DIR/$f" ]]; then
      echo "Compiled $f : Present ($(wc -c < "$CURRENT_THEME_DIR/$f") bytes)"
    else
      echo "Compiled $f : Missing"
    fi
  done

  echo ""
  echo "Launcher flags       : $FLAGS_FILE"
  if [[ -f "$FLAGS_FILE" ]]; then
    echo "  present ($(wc -c < "$FLAGS_FILE") bytes)"
    if grep -q -- '--load-extension=' "$FLAGS_FILE"; then
      echo "  --load-extension : $(sed -n 's/^--load-extension=//p' "$FLAGS_FILE")"
    else
      echo "  --load-extension : MISSING - extensions will not load"
    fi
  else
    echo "  MISSING - Brave gets no Omarchy flags and no extensions"
  fi

  echo ""
  echo "Extensions dirs (loaded via --load-extension):"
  local dir id
  for dir in "${EXTENSION_DIRS[@]}"; do
    if [[ -d "$dir" ]]; then
      id=$(extension_id_for_dir "$dir")
      if is_allowlisted "$id"; then
        echo "  $dir -> $id [allowlisted]"
      else
        echo "  $dir -> $id [NOT allowlisted - Brave will refuse it]"
      fi
    else
      echo "  $dir -> MISSING"
    fi
  done

  echo ""
  echo "Polished extension   : $EXT_DIR"
  for f in manifest.json ntp.html ntp.js global.js background.js ntp.css global.css theme.json; do
    if [[ -f "$EXT_DIR/$f" ]]; then
      echo "  $f : Present ($(wc -c < "$EXT_DIR/$f") bytes)"
    else
      echo "  $f : Missing"
    fi
  done

  echo ""
  echo "Dark Reader fork     : $FORK_DIR"
  for f in background/index.js inject/index.js ui/popup/index.js config/omarchy-theme.json ui/popup/omarchy-theme.css manifest.json; do
    if [[ -f "$FORK_DIR/$f" ]]; then
      echo "  $f : Present ($(wc -c < "$FORK_DIR/$f") bytes)"
    else
      echo "  $f : Missing"
    fi
  done
  if grep -q "OmarchyManager" "$FORK_DIR/background/index.js" 2>/dev/null; then
    echo "  Omarchy patches      : Present"
  else
    echo "  Omarchy patches      : MISSING"
  fi

  echo ""
  echo "Live toolbar policy  : /etc/brave/policies/managed/color.json"
  if [[ -r /etc/brave/policies/managed/color.json ]]; then
    echo "  color.json : $(cat /etc/brave/policies/managed/color.json)"
  else
    echo "  color.json : not readable"
  fi

  echo ""
  local brave_pid
  brave_pid=$(running_brave_pid)
  if [[ -n "$brave_pid" ]]; then
    echo "Brave Process        : Running (PID: $brave_pid)"
    echo "Note: Chrome colors, NTP theme, and page polish update dynamically with no restart needed."
  else
    echo "Brave Process        : Not running (theme applies on next launch)"
  fi
  echo "=================================================================="
}

MODE="sync"
if [[ $# -gt 0 ]]; then
  case "$1" in
    --sync) MODE="sync" ;;
    --restart) MODE="restart" ;;
    --status) MODE="status" ;;
    -h|--help) show_help; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; show_help; exit 1 ;;
  esac
fi

case "$MODE" in
  sync) do_sync ;;
  restart) do_sync && do_restart ;;
  status) do_status ;;
esac
