#!/usr/bin/env python3
"""
Antigravity CLI Option-Selection Ting Daemon
Watches Antigravity CLI logs in real-time and sounds an audible "ting" chime
and terminal bell whenever user manual input is required to select an option
(e.g., interactive ask_question modal or tool confirmation prompt).
"""

import glob
import os
import shutil
import subprocess
import sys
import time

LOG_DIR = os.path.expanduser("~/.gemini/antigravity-cli/log")
ACTIVITY_LOG = os.path.expanduser("~/.gemini/antigravity-cli/ring-ting.log")
PRIMARY_SOUND = os.path.expanduser("~/.gemini/antigravity-cli/sounds/ting.wav")
FALLBACK_SOUND = "/usr/share/sounds/freedesktop/stereo/bell.oga"
SOUND_FILE = PRIMARY_SOUND if os.path.isfile(PRIMARY_SOUND) else FALLBACK_SOUND

DEBOUNCE_SECONDS = 1.5
last_ring_time = 0.0


def ring_ting(reason: str = "option selection"):
    global last_ring_time
    now = time.time()
    if now - last_ring_time < DEBOUNCE_SECONDS:
        return
    last_ring_time = now

    # 1. Play audio chime
    try:
        if shutil.which("pw-play") and os.path.isfile(SOUND_FILE):
            subprocess.Popen(
                ["pw-play", SOUND_FILE],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        elif shutil.which("canberra-gtk-play"):
            subprocess.Popen(
                ["canberra-gtk-play", "-i", "bell", "-d", "antigravity"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        elif shutil.which("paplay") and os.path.isfile(SOUND_FILE):
            subprocess.Popen(
                ["paplay", SOUND_FILE],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        elif shutil.which("mpv") and os.path.isfile(SOUND_FILE):
            subprocess.Popen(
                ["mpv", "--no-video", "--really-quiet", SOUND_FILE],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
    except Exception:
        pass

    # 2. Terminal BEL (\a) to active TTY and PTYs
    try:
        with open("/dev/tty", "wb", buffering=0) as f:
            f.write(b"\a")
    except Exception:
        pass

    try:
        for entry in os.scandir("/dev/pts"):
            if entry.name != "ptmx" and entry.is_character_device():
                try:
                    with open(entry.path, "wb", buffering=0) as f:
                        f.write(b"\a")
                except Exception:
                    pass
    except Exception:
        pass

    # 3. Log event
    try:
        iso_now = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        with open(ACTIVITY_LOG, "a", encoding="utf-8") as f:
            f.write(f"{iso_now} - ting rung for: {reason}\n")
    except Exception:
        pass


def main():
    os.makedirs(LOG_DIR, exist_ok=True)
    file_handles = {}  # filepath -> (file_object, last_inode)
    last_scan_time = 0.0

    def update_file_handles():
        current_time = time.time()
        pattern = os.path.join(LOG_DIR, "cli-*.log")
        files = glob.glob(pattern)

        symlink = os.path.expanduser("~/.gemini/antigravity-cli/cli.log")
        if os.path.exists(symlink):
            files.append(symlink)

        for filepath in set(files):
            try:
                st = os.stat(filepath)
                # Only monitor files modified in the last 15 minutes
                if current_time - st.st_mtime > 900:
                    if filepath in file_handles:
                        file_handles[filepath][0].close()
                        del file_handles[filepath]
                    continue

                if filepath not in file_handles:
                    f = open(filepath, "r", encoding="utf-8", errors="replace")
                    f.seek(0, os.SEEK_END)  # Start at end of file
                    file_handles[filepath] = (f, st.st_ino)
                else:
                    f, old_ino = file_handles[filepath]
                    if st.st_ino != old_ino:
                        f.close()
                        f = open(filepath, "r", encoding="utf-8", errors="replace")
                        f.seek(0, os.SEEK_END)
                        file_handles[filepath] = (f, st.st_ino)
            except Exception:
                if filepath in file_handles:
                    try:
                        file_handles[filepath][0].close()
                    except Exception:
                        pass
                    del file_handles[filepath]

    update_file_handles()

    TRIGGERS = (
        "Surfacing ask_question",
        "Surfacing tool confirmation",
        "The agent has a question for you:",
    )

    while True:
        now = time.time()
        if now - last_scan_time > 2.0:
            update_file_handles()
            last_scan_time = now

        had_data = False
        for filepath, (f, _) in list(file_handles.items()):
            try:
                while True:
                    line = f.readline()
                    if not line:
                        break
                    had_data = True
                    for trigger in TRIGGERS:
                        if trigger in line:
                            ring_ting(trigger)
                            break
            except Exception:
                pass

        if not had_data:
            time.sleep(0.04)


if __name__ == "__main__":
    main()
