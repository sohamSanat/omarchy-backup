{
  "spec": {
    "version": 2,
    "preset": "orbit",
    "engine": "omagen",
    "topology": "floating",
    "position": "top",
    "surface": {
      "treatment": "preset",
      "role": "background",
      "opacity": 1,
      "blur": 0,
      "border_role": "accent",
      "border_opacity": 0.42,
      "border_width": 1,
      "shadow": "raised"
    },
    "geometry": {
      "density": "compact",
      "thickness": 0,
      "edge_offset": 10,
      "outer_margin": 10,
      "inner_padding": 0,
      "section_gap": 8,
      "widget_gap": 0,
      "radius": 18,
      "length_mode": "full",
      "length_value": 0,
      "alignment": "center"
    },
    "attention": {
      "mode": "semantic"
    },
    "behavior": {
      "visibility": "always",
      "exclusive_zone": "reserve",
      "hover_expand": false,
      "hide_delay_ms": 5000,
      "reveal_delay_ms": 50,
      "edge_sensor": 3,
      "keep_visible_while_popup_open": true
    },
    "regions": {
      "left": {
        "mode": "native"
      },
      "center": {
        "mode": "native"
      },
      "right": {
        "mode": "native"
      }
    },
    "workspace": {
      "mode": "native"
    },
    "clock": {
      "style": "neon"
    },
    "dock": {
      "closed": "ellipsis",
      "glyph": "✦"
    },
    "motion": {
      "preset": "smooth",
      "duration_ms": 220,
      "easing": "out_cubic"
    }
  },
  "engine": "omagen",
  "native": false,
  "capabilities": {
    "surface": false,
    "topology": false,
    "behavior": true,
    "regions": true,
    "workspace": true,
    "clock": false
  }
}
