        {
          "name": "Duplicate and Offset 10 pt",
          "steps": [
            [
              "object.move",
              {
                "copy": true,
                "dx": 10,
                "dy": 10
              }
            ]
          ]
        },
        {
          "name": "Unite and Simplify",
          "steps": [
            [
              "object.pathfinder.unite",
              {}
            ],
            [
              "object.path.simplify",
              {
                "tolerance": 0.5
              }
            ]
          ]
        },
        {
          "name": "Center on Artboard",
          "steps": [
            [
              "object.align",
              {
                "horizontal": "center",
                "to": "artboard",
                "vertical": "center"
              }
            ]
          ]
        },
        {
          "name": "Outline Text",
          "steps": [
            [
              "type.createOutlines",
              {}
            ]
