 pub fn c32(c: wordcraft_doc::Rgb) -> Color32 {
     Color32::from_rgb(c.0, c.1, c.2)
 }
+
+#[cfg(not(target_arch = "wasm32"))]
+pub mod live {
+    use super::{Tokens, apply};
+    use egui::Color32;
+    use std::time::SystemTime;
+
+    #[derive(Default)]
+    pub struct LiveTokens {
+        path: Option<std::path::PathBuf>,
+        stamp: Option<SystemTime>,
+        last_check: f64,
+        pub active_tokens: Option<Tokens>,
+    }
+
+    impl LiveTokens {
+        pub fn from_env() -> Self {
+            let path = std::env::var_os("WORDCRAFT_THEME_FILE")
+                .map(std::path::PathBuf::from)
+                .or_else(|| {
+                    std::env::var_os("HOME")
+                        .map(|h| std::path::PathBuf::from(h).join(".config/wordcraft/theme.json"))
+                });
+            Self { path, last_check: -1.0, active_tokens: None, stamp: None }
+        }
+
+        pub fn poll(&mut self, ctx: &egui::Context, applied_dark: &mut Option<bool>) -> bool {
+            let Some(path) = &self.path else { return false };
+            let now = ctx.input(|i| i.time);
+            if self.last_check >= 0.0 && now - self.last_check < 0.4 {
+                ctx.request_repaint_after(std::time::Duration::from_millis(400));
+                return false;
+            }
+            self.last_check = now;
+            ctx.request_repaint_after(std::time::Duration::from_millis(400));
+            let Ok(meta) = std::fs::metadata(path) else { return false };
+            let stamp = meta.modified().ok();
+            if stamp.is_some() && stamp == self.stamp {
+                return false;
+            }
+            self.stamp = stamp;
+            let Ok(text) = std::fs::read_to_string(path) else { return false };
+            match serde_json::from_str::<serde_json::Value>(&text) {
+                Ok(v) => {
+                    let dark = v.get("dark").and_then(|d| d.as_bool())
+                        .or_else(|| v.get("kind").and_then(|k| k.as_str()).map(|k| k == "dark"))
+                        .unwrap_or_else(|| ctx.global_style().visuals.dark_mode);
+                    let mut t = if dark { Tokens::dark() } else { Tokens::light() };
+                    t.dark = dark;
+                    let unknown = apply_overrides(&mut t, &v);
+                    self.active_tokens = Some(t);
+                    *applied_dark = Some(dark);
+                    apply(ctx, &t);
+                    log::info!("LiveTokens applied: dark={}, accent={:?}", t.dark, t.accent);
+                    if !unknown.is_empty() {
+                        log::warn!("unknown token keys: {unknown:?}");
+                    }
+                    ctx.request_repaint();
+                    true
+                }
+                Err(e) => {
+                    log::warn!("theme file: {e}");
+                    false
+                }
+            }
+        }
+    }
+
+    fn color(v: &serde_json::Value) -> Option<Color32> {
+        let s = v.as_str()?.trim_start_matches('#');
+        let b = |i: usize| u8::from_str_radix(s.get(i..i + 2)?, 16).ok();
+        match s.len() {
+            6 => Some(Color32::from_rgb(b(0)?, b(2)?, b(4)?)),
+            8 => Some(Color32::from_rgba_unmultiplied(b(0)?, b(2)?, b(4)?, b(6)?)),
+            _ => None,
+        }
+    }
+
+    pub fn apply_overrides(t: &mut Tokens, v: &serde_json::Value) -> Vec<String> {
+        let mut unknown = Vec::new();
+        let Some(obj) = v.as_object() else { return unknown };
+        for (k, val) in obj {
+            match k.as_str() {
+                "title_bar" | "titlebar" | "titleBar" => if let Some(c) = color(val) { t.title_bar = c; },
+                "ribbon" => if let Some(c) = color(val) { t.ribbon = c; },
+                "tab_strip" | "tabstrip" | "tabStrip" => if let Some(c) = color(val) { t.tab_strip = c; },
+                "canvas" => if let Some(c) = color(val) { t.canvas = c; },
+                "panel" => if let Some(c) = color(val) { t.panel = c; },
+                "border" => if let Some(c) = color(val) { t.border = c; },
+                "border_strong" | "borderStrong" => if let Some(c) = color(val) { t.border_strong = c; },
+                "text" => if let Some(c) = color(val) { t.text = c; },
+                "text_dim" | "textDim" | "text_muted" | "textMuted" => if let Some(c) = color(val) { t.text_dim = c; },
+                "text_disabled" | "textDisabled" => if let Some(c) = color(val) { t.text_disabled = c; },
+                "icon" => if let Some(c) = color(val) { t.icon = c; },
+                "hover" => if let Some(c) = color(val) { t.hover = c; },
+                "pressed" => if let Some(c) = color(val) { t.pressed = c; },
+                "checked" => if let Some(c) = color(val) { t.checked = c; },
+                "accent" => if let Some(c) = color(val) { t.accent = c; },
+                "accent_text" | "accentText" => if let Some(c) = color(val) { t.accent_text = c; },
+                "input" | "field" => if let Some(c) = color(val) { t.input = c; },
+                "input_border" | "inputBorder" | "field_border" => if let Some(c) = color(val) { t.input_border = c; },
+                "group_label" | "groupLabel" => if let Some(c) = color(val) { t.group_label = c; },
+                "ruler" => if let Some(c) = color(val) { t.ruler = c; },
+                "ruler_margin" | "rulerMargin" => if let Some(c) = color(val) { t.ruler_margin = c; },
+                "ruler_tick" | "rulerTick" => if let Some(c) = color(val) { t.ruler_tick = c; },
+                "status_bar" | "statusbar" | "statusBar" => if let Some(c) = color(val) { t.status_bar = c; },
+                "selection" | "selected" => if let Some(c) = color(val) { t.selection = c; },
+                "caret" => if let Some(c) = color(val) { t.caret = c; },
+                "page_shadow" | "pageShadow" => if let Some(c) = color(val) { t.page_shadow = c; },
+                "menu" => if let Some(c) = color(val) { t.menu = c; },
+                "blue" => if let Some(c) = color(val) { t.blue = c; },
+                "red" => if let Some(c) = color(val) { t.red = c; },
+                "green" => if let Some(c) = color(val) { t.green = c; },
+                "orange" => if let Some(c) = color(val) { t.orange = c; },
+                "dark" | "kind" => {}
+                _ => unknown.push(k.clone()),
+            }
+        }
+        unknown
+    }
+}
