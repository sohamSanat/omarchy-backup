+#[cfg(not(target_arch = "wasm32"))]
+pub mod live {
+    use super::{Tokens, apply_tokens, theme_file_path};
+    use egui::Color32;
+    use std::time::SystemTime;
+
+    #[derive(Default)]
+    pub struct LiveTokens {
+        path: Option<std::path::PathBuf>,
+        stamp: Option<SystemTime>,
+        last_check: f64,
+    }
+
+    impl LiveTokens {
+        pub fn from_env() -> Self {
+            Self { path: theme_file_path(), ..Default::default() }
+        }
+
+        /// Check theme file and re-apply overrides on change. Returns true when tokens were updated.
+        pub fn poll(&mut self, ctx: &egui::Context) -> bool {
+            let Some(path) = &self.path else { return false };
+            let now = ctx.input(|i| i.time);
+            if now - self.last_check < 0.25 {
+                ctx.request_repaint_after(std::time::Duration::from_millis(250));
+                return false;
+            }
+            self.last_check = now;
+            ctx.request_repaint_after(std::time::Duration::from_millis(250));
+            let Ok(meta) = std::fs::metadata(path) else { return false };
+            let stamp = meta.modified().ok();
+            if stamp == self.stamp && self.stamp.is_some() {
+                return false;
+            }
+            self.stamp = stamp;
+            let Ok(text) = std::fs::read_to_string(path) else { return false };
+            match serde_json::from_str::<serde_json::Value>(&text) {
+                Ok(v) => {
+                    let mut t = Tokens::default();
+                    let unknown = apply_overrides(&mut t, &v);
+                    apply_tokens(ctx, t);
+                    if !unknown.is_empty() {
+                        log::warn!("unknown token keys in theme file: {unknown:?}");
+                    }
+                    ctx.request_repaint();
+                    true
+                }
+                Err(e) => {
+                    log::warn!("theme file error: {e}");
+                    false
+                }
+            }
+        }
+    }
+
+    fn color(v: &serde_json::Value) -> Option<Color32> {
+        let s = v.as_str()?.trim_start_matches('#');
+        let b = |i: usize| u8::from_str_radix(s.get(i..i + 2)?, 16).ok();
+        match s.len() {
+            6 => Some(Color32::from_rgb(b(0)?, b(2)?, b(4)?)),
+            8 => Some(Color32::from_rgba_unmultiplied(b(0)?, b(2)?, b(4)?, b(6)?)),
+            _ => None,
+        }
+    }
+
+    pub fn apply_overrides(t: &mut Tokens, v: &serde_json::Value) -> Vec<String> {
+        let mut unknown = Vec::new();
+        let Some(obj) = v.as_object() else { return unknown };
+        for (k, val) in obj {
+            macro_rules! c {
+                ($($f:ident),*) => {
+                    match k.as_str() {
+                        $(stringify!($f) => { if let Some(col) = color(val) { t.$f = col; } })*
+                        "top_bar_h" => { if let Some(x) = val.as_f64() { t.top_bar_h = x as f32; } }
+                        "bottom_bar_h" => { if let Some(x) = val.as_f64() { t.bottom_bar_h = x as f32; } }
+                        "panel_w" => { if let Some(x) = val.as_f64() { t.panel_w = x as f32; } }
+                        "strip_w" => { if let Some(x) = val.as_f64() { t.strip_w = x as f32; } }
+                        "slider_row_h" => { if let Some(x) = val.as_f64() { t.slider_row_h = x as f32; } }
+                        "section_h" => { if let Some(x) = val.as_f64() { t.section_h = x as f32; } }
+                        "film_h" => { if let Some(x) = val.as_f64() { t.film_h = x as f32; } }
+                        _ => unknown.push(k.clone()),
+                    }
+                };
+            }
+            c!(
+                chrome,
+                canvas,
+                grid_bg,
+                cell,
+                cell_selected,
+                divider,
+                inset,
+                field,
+                field_border,
+                button,
+                button_border,
+                hover,
+                pressed,
+                tool_active,
+                text,
+                text_label,
+                text_dim,
+                text_disabled,
+                icon,
+                track,
+                thumb,
+                thumb_hover,
+                accent,
+                star,
+                pick,
+                reject,
+                caution,
+                mask_overlay
+            );
+        }
+        unknown
+    }
+}
