diff --git i/crates/ui-egui/src/theme.rs w/crates/ui-egui/src/theme.rs
index 74ab0b7..e0a0d45 100644
--- i/crates/ui-egui/src/theme.rs
+++ w/crates/ui-egui/src/theme.rs
@@ -601,3 +601,154 @@ mod tests {
         install_script_fallbacks(&mut fonts, "system");
     }
 }
+
+#[cfg(not(target_arch = "wasm32"))]
+pub mod live {
+    use super::{ThemeKind, Tokens, apply_visuals};
+    use egui::Color32;
+    use std::time::SystemTime;
+
+    #[derive(Default)]
+    pub struct LiveTokens {
+        path: Option<std::path::PathBuf>,
+        stamp: Option<SystemTime>,
+        last_check: f64,
+        cached: Option<serde_json::Value>,
+    }
+
+    impl LiveTokens {
+        pub fn from_env() -> Self {
+            let path = std::env::var_os("EFFECTCRAFT_THEME_FILE")
+                .map(std::path::PathBuf::from)
+                .or_else(|| {
+                    std::env::var_os("HOME")
+                        .map(|h| std::path::PathBuf::from(h).join(".config/effectcraft/theme.json"))
+                });
+            Self { path, ..Default::default() }
+        }
+
+        /// Apply cached overrides if present.
+        pub fn apply_cached(&self, ctx: &egui::Context, t: &mut Tokens) {
+            if let Some(v) = &self.cached {
+                apply_overrides(t, v);
+                apply_visuals(ctx, t);
+            }
+        }
+
+        /// Poll theme file and re-apply overrides on change.
+        pub fn poll(&mut self, ctx: &egui::Context, t: &mut Tokens) -> bool {
+            let Some(path) = &self.path else { return false };
+            let now = ctx.input(|i| i.time);
+            if now - self.last_check < 0.4 && self.cached.is_some() {
+                ctx.request_repaint_after(std::time::Duration::from_millis(400));
+                return false;
+            }
+            self.last_check = now;
+            ctx.request_repaint_after(std::time::Duration::from_millis(400));
+            let Ok(meta) = std::fs::metadata(path) else { return false };
+            let stamp = meta.modified().ok();
+            if stamp == self.stamp && self.cached.is_some() {
+                return false;
+            }
+            self.stamp = stamp;
+            let Ok(text) = std::fs::read_to_string(path) else { return false };
+            match serde_json::from_str::<serde_json::Value>(&text) {
+                Ok(v) => {
+                    let unknown = apply_overrides(t, &v);
+                    apply_visuals(ctx, t);
+                    self.cached = Some(v);
+                    if !unknown.is_empty() {
+                        log::warn!("unknown token keys in theme file: {unknown:?}");
+                    }
+                    true
+                }
+                Err(e) => {
+                    log::warn!("theme file error: {e}");
+                    false
+                }
+            }
+        }
+    }
+
+    fn color(v: &serde_json::Value) -> Option<Color32> {
+        let s = v.as_str()?.trim_start_matches('#');
+        let b = |i: usize| u8::from_str_radix(s.get(i..i + 2)?, 16).ok();
+        match s.len() {
+            6 => Some(Color32::from_rgb(b(0)?, b(2)?, b(4)?)),
+            8 => Some(Color32::from_rgba_unmultiplied(b(0)?, b(2)?, b(4)?, b(6)?)),
+            _ => None,
+        }
+    }
+
+    /// Apply JSON overrides onto tokens; returns unknown keys.
+    pub fn apply_overrides(t: &mut Tokens, v: &serde_json::Value) -> Vec<String> {
+        let mut unknown = Vec::new();
+        let Some(obj) = v.as_object() else { return unknown };
+        for (k, val) in obj {
+            macro_rules! c {
+                ($($f:ident),*) => {
+                    match k.as_str() {
+                        $(stringify!($f) => { if let Some(c) = color(val) { t.$f = c; } })*
+                        "kind" => {
+                            if let Some(s) = val.as_str() {
+                                if let Some(k) = ThemeKind::from_name(s) {
+                                    t.kind = k;
+                                }
+                            }
+                        }
+                        "dark" => {
+                            if let Some(b) = val.as_bool() {
+                                t.kind = if b { ThemeKind::Dark } else { ThemeKind::Light };
+                            }
+                        }
+                        "radius" => { if let Some(x) = val.as_f64() { t.radius = x as f32; } }
+                        "radius_sm" => { if let Some(x) = val.as_f64() { t.radius_sm = x as f32; } }
+                        "gap" => { if let Some(x) = val.as_f64() { t.gap = x as f32; } }
+                        "tab_h" => { if let Some(x) = val.as_f64() { t.tab_h = x as f32; } }
+                        "row_h" => { if let Some(x) = val.as_f64() { t.row_h = x as f32; } }
+                        _ => unknown.push(k.clone()),
+                    }
+                };
+            }
+            c!(
+                app_bg,
+                header_bg,
+                panel_bg,
+                tab_text,
+                tab_text_active,
+                focus,
+                accent,
+                accent_hover,
+                text,
+                text_dim,
+                text_faint,
+                icon,
+                icon_active,
+                hover,
+                pressed,
+                field_bg,
+                field_border,
+                separator,
+                row,
+                row_alt,
+                row_selected,
+                hot_text,
+                tl_bg,
+                tl_ruler_bg,
+                tl_ruler_tick,
+                tl_ruler_text,
+                cti,
+                work_area,
+                cache_green,
+                cache_blue,
+                keyframe,
+                keyframe_selected,
+                pasteboard,
+                timecode,
+                danger,
+                warning
+            );
+        }
+        unknown
+    }
+}
