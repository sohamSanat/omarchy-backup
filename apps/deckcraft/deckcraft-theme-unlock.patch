+
+#[cfg(not(target_arch = "wasm32"))]
+pub mod live {
+    use super::{apply, Brightness, Tokens};
+    use egui::Color32;
+    use std::time::SystemTime;
+
+    #[derive(Default)]
+    pub struct LiveTokens {
+        path: Option<std::path::PathBuf>,
+        stamp: Option<SystemTime>,
+        last_check: f64,
+        pub active_tokens: Option<Tokens>,
+    }
+
+    impl LiveTokens {
+        pub fn from_env() -> Self {
+            let path = std::env::var_os("DECKCRAFT_THEME_FILE")
+                .map(std::path::PathBuf::from)
+                .or_else(|| {
+                    std::env::var_os("HOME")
+                        .map(|h| std::path::PathBuf::from(h).join(".config/deckcraft/theme.json"))
+                });
+            Self {
+                path,
+                stamp: None,
+                last_check: -1.0,
+                active_tokens: None,
+            }
+        }
+
+        pub fn poll(&mut self, ctx: &egui::Context, brightness: &mut Brightness) -> bool {
+            let Some(path) = &self.path else { return false };
+            let now = ctx.input(|i| i.time);
+            if self.last_check >= 0.0 && now - self.last_check < 0.4 {
+                ctx.request_repaint_after(std::time::Duration::from_millis(400));
+                return false;
+            }
+            self.last_check = now;
+            ctx.request_repaint_after(std::time::Duration::from_millis(400));
+            let Ok(meta) = std::fs::metadata(path) else { return false };
+            let stamp = meta.modified().ok();
+            if stamp.is_some() && stamp == self.stamp {
+                return false;
+            }
+            self.stamp = stamp;
+            let Ok(text) = std::fs::read_to_string(path) else { return false };
+            match serde_json::from_str::<serde_json::Value>(&text) {
+                Ok(v) => {
+                    let base_brightness = if v.get("kind").and_then(|k| k.as_str()) == Some("dark")
+                        || v.get("dark").and_then(|d| d.as_bool()) == Some(true)
+                    {
+                        Brightness::Dark
+                    } else if v.get("kind").and_then(|k| k.as_str()) == Some("light")
+                        || v.get("dark").and_then(|d| d.as_bool()) == Some(false)
+                    {
+                        Brightness::Light
+                    } else {
+                        *brightness
+                    };
+                    let mut t = Tokens::for_brightness(base_brightness);
+                    let unknown = apply_overrides(&mut t, &v);
+                    *brightness = if t.dark { Brightness::Dark } else { Brightness::Light };
+                    self.active_tokens = Some(t);
+                    apply(ctx, &t);
+                    log::info!("DeckCraft LiveTokens applied: dark={}, chrome={:?}", t.dark, t.chrome);
+                    if !unknown.is_empty() {
+                        log::warn!("unknown token keys: {unknown:?}");
+                    }
+                    ctx.request_repaint();
+                    true
+                }
+                Err(e) => {
+                    log::warn!("DeckCraft theme file error: {e}");
+                    false
+                }
+            }
+        }
+    }
+
+    fn color(v: &serde_json::Value) -> Option<Color32> {
+        let s = v.as_str()?.trim_start_matches('#');
+        let b = |i: usize| u8::from_str_radix(s.get(i..i + 2)?, 16).ok();
+        match s.len() {
+            6 => Some(Color32::from_rgb(b(0)?, b(2)?, b(4)?)),
+            8 => Some(Color32::from_rgba_unmultiplied(b(0)?, b(2)?, b(4)?, b(6)?)),
+            _ => None,
+        }
+    }
+
+    pub fn apply_overrides(t: &mut Tokens, v: &serde_json::Value) -> Vec<String> {
+        let mut unknown = Vec::new();
+        let Some(obj) = v.as_object() else { return unknown };
+        for (k, val) in obj {
+            macro_rules! c {
+                ($($f:ident),*) => {
+                    match k.as_str() {
+                        $(stringify!($f) => { if let Some(c) = color(val) { t.$f = c; } })*
+                        "dark" => {
+                            if let Some(b) = val.as_bool() {
+                                t.dark = b;
+                            }
+                        }
+                        "kind" => {
+                            if let Some(s) = val.as_str() {
+                                t.dark = s == "dark";
+                            }
+                        }
+                        _ => unknown.push(k.clone()),
+                    }
+                };
+            }
+            c!(
+                chrome,
+                card,
+                card_border,
+                canvas,
+                text,
+                text_dim,
+                text_faint,
+                border,
+                separator,
+                hover,
+                pressed,
+                selected,
+                accent,
+                accent_text,
+                contextual,
+                selection,
+                handle_fill,
+                handle_stroke,
+                guide,
+                caret,
+                text_selection,
+                field_bg,
+                shadow
+            );
+        }
+        unknown
+    }
+}
