+pub fn apply(ctx: &egui::Context, dark: bool) {
+    let t = if dark { Tokens::dark() } else { Tokens::light() };
+    apply_tokens(ctx, t);
+}
+
 /// Model colour → egui colour.
 pub fn color32(rgb: [u8; 3]) -> Color32 {
     Color32::from_rgb(rgb[0], rgb[1], rgb[2])
 }
+
+#[cfg(not(target_arch = "wasm32"))]
+pub mod live {
+    use super::{Tokens, apply_tokens};
+    use egui::Color32;
+    use std::time::SystemTime;
+
+    #[derive(Default)]
+    pub struct LiveTokens {
+        path: Option<std::path::PathBuf>,
+        stamp: Option<SystemTime>,
+        last_check: f64,
+        pub active_tokens: Option<Tokens>,
+    }
+
+    impl LiveTokens {
+        pub fn from_env() -> Self {
+            let path = std::env::var_os("GRIDCRAFT_THEME_FILE")
+                .map(std::path::PathBuf::from)
+                .or_else(|| {
+                    std::env::var_os("HOME")
+                        .map(|h| std::path::PathBuf::from(h).join(".config/gridcraft/theme.json"))
+                });
+            Self { path, last_check: -1.0, active_tokens: None, stamp: None }
+        }
+
+        pub fn poll(&mut self, ctx: &egui::Context, applied_dark: &mut bool) -> bool {
+            let Some(path) = &self.path else { return false };
+            let now = ctx.input(|i| i.time);
+            if self.last_check >= 0.0 && now - self.last_check < 0.3 {
+                ctx.request_repaint_after(std::time::Duration::from_millis(300));
+                return false;
+            }
+            self.last_check = now;
+            ctx.request_repaint_after(std::time::Duration::from_millis(300));
+            let Ok(meta) = std::fs::metadata(path) else { return false };
+            let stamp = meta.modified().ok();
+            if stamp.is_some() && stamp == self.stamp {
+                return false;
+            }
+            self.stamp = stamp;
+            let Ok(text) = std::fs::read_to_string(path) else { return false };
+            match serde_json::from_str::<serde_json::Value>(&text) {
+                Ok(v) => {
+                    let dark = v.get("dark").and_then(|d| d.as_bool())
+                        .or_else(|| v.get("kind").and_then(|k| k.as_str()).map(|k| k == "dark"))
+                        .unwrap_or_else(|| ctx.global_style().visuals.dark_mode);
+                    let mut t = if dark { Tokens::dark() } else { Tokens::light() };
+                    t.dark = dark;
+                    let unknown = apply_overrides(&mut t, &v);
+                    self.active_tokens = Some(t);
+                    *applied_dark = dark;
+                    apply_tokens(ctx, t);
+                    if !unknown.is_empty() {
+                        log::warn!("unknown token keys: {unknown:?}");
+                    }
+                    ctx.request_repaint();
+                    true
+                }
+                Err(e) => {
+                    log::warn!("theme file: {e}");
+                    false
+                }
+            }
+        }
+    }
+
+    fn color(v: &serde_json::Value) -> Option<Color32> {
+        let s = v.as_str()?.trim_start_matches('#');
+        let b = |i: usize| u8::from_str_radix(s.get(i..i + 2)?, 16).ok();
+        match s.len() {
+            6 => Some(Color32::from_rgb(b(0)?, b(2)?, b(4)?)),
+            8 => Some(Color32::from_rgba_unmultiplied(b(0)?, b(2)?, b(4)?, b(6)?)),
+            _ => None,
+        }
+    }
+
+    pub fn apply_overrides(t: &mut Tokens, v: &serde_json::Value) -> Vec<String> {
+        let mut unknown = Vec::new();
+        let Some(obj) = v.as_object() else { return unknown };
+        for (k, val) in obj {
+            match k.as_str() {
+                "window" => if let Some(c) = color(val) { t.window = c; },
+                "ribbon" => if let Some(c) = color(val) { t.ribbon = c; },
+                "ribbon_border" | "ribbonBorder" => if let Some(c) = color(val) { t.ribbon_border = c; },
+                "text" => if let Some(c) = color(val) { t.text = c; },
+                "text_dim" | "textDim" => if let Some(c) = color(val) { t.text_dim = c; },
+                "text_disabled" | "textDisabled" => if let Some(c) = color(val) { t.text_disabled = c; },
+                "accent" => if let Some(c) = color(val) { t.accent = c; },
+                "accent_dark" | "accentDark" => if let Some(c) = color(val) { t.accent_dark = c; },
+                "accent_soft" | "accentSoft" => if let Some(c) = color(val) { t.accent_soft = c; },
+                "hover" => if let Some(c) = color(val) { t.hover = c; },
+                "pressed" => if let Some(c) = color(val) { t.pressed = c; },
+                "separator" => if let Some(c) = color(val) { t.separator = c; },
+                "grid_bg" | "gridBg" => if let Some(c) = color(val) { t.grid_bg = c; },
+                "gridline" => if let Some(c) = color(val) { t.gridline = c; },
+                "header_bg" | "headerBg" => if let Some(c) = color(val) { t.header_bg = c; },
+                "header_text" | "headerText" => if let Some(c) = color(val) { t.header_text = c; },
+                "header_line" | "headerLine" => if let Some(c) = color(val) { t.header_line = c; },
+                "header_sel_bg" | "headerSelBg" => if let Some(c) = color(val) { t.header_sel_bg = c; },
+                "header_sel_text" | "headerSelText" => if let Some(c) = color(val) { t.header_sel_text = c; },
+                "header_all_bg" | "headerAllBg" => if let Some(c) = color(val) { t.header_all_bg = c; },
+                "sel_fill" | "selFill" => if let Some(c) = color(val) { t.sel_fill = c; },
+                "sel_border" | "selBorder" => if let Some(c) = color(val) { t.sel_border = c; },
+                "input_bg" | "inputBg" => if let Some(c) = color(val) { t.input_bg = c; },
+                "input_border" | "inputBorder" => if let Some(c) = color(val) { t.input_border = c; },
+                "tab_bar" | "tabBar" => if let Some(c) = color(val) { t.tab_bar = c; },
+                "tab_active" | "tabActive" => if let Some(c) = color(val) { t.tab_active = c; },
+                "status_bar" | "statusBar" => if let Some(c) = color(val) { t.status_bar = c; },
+                "cell_text" | "cellText" => if let Some(c) = color(val) { t.cell_text = c; },
+                "menu_bg" | "menuBg" => if let Some(c) = color(val) { t.menu_bg = c; },
+                "shadow" => if let Some(c) = color(val) { t.shadow = c; },
+                "danger" => if let Some(c) = color(val) { t.danger = c; },
+                "dark" | "kind" => {}
+                _ => unknown.push(k.clone()),
+            }
+        }
+        unknown
+    }
+}
