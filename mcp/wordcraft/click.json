{
  "name": "click",
  "description": "Click at window coordinates (desktop app only).",
  "parameters": {
    "type": "object",
    "properties": {
      "x": {
        "type": "number",
        "description": "X coordinate in screen points"
      },
      "y": {
        "type": "number",
        "description": "Y coordinate in screen points"
      },
      "count": {
        "type": "number",
        "description": "1-3 clicks"
      },
      "shift": {
        "type": "boolean"
      },
      "cmd": {
        "type": "boolean"
      }
    },
    "required": [
      "x",
      "y"
    ]
  }
}