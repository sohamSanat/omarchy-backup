{"name":"ui_click","description":"Live app: click an element by id or at x,y (points). Supports right/middle button, double-click (count=2) and modifiers.","parameters":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"button":{"default":null,"description":"left | right | middle","type":["string","null"]},"count":{"default":null,"description":"2 for double-click.","format":"uint32","minimum":0,"type":["integer","null"]},"id":{"default":null,"description":"Element id from `ui_elements` (e.g. `timeline.track.V1.lock`, `tools.Razor`, `project.item.12`).","type":["string","null"]},"modifiers":{"default":null,"description":"{\"shift\":bool,\"alt\":bool,\"command\":bool,\"ctrl\":bool}"},"x":{"default":null,"description":"Or screen coordinates in points.","format":"double","type":["number","null"]},"y":{"default":null,"format":"double","type":["number","null"]}},"type":"object"}}