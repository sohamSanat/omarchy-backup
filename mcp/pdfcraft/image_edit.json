{
  "name": "image_edit",
  "description": "Change one of a page's images (number from page_images): action move (rect: new box in top-left-origin points), rotate (quarters clockwise, default 1), flip_horizontal, flip_vertical, replace (path: an image file, drawn in the same place) or delete. Undoable.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "move",
          "rotate",
          "flip_horizontal",
          "flip_vertical",
          "replace",
          "delete"
        ],
        "type": "string"
      },
      "doc": {
        "description": "Document id from doc_open or doc_list.",
        "minimum": 1,
        "type": "integer"
      },
      "image": {
        "minimum": 1,
        "type": "integer"
      },
      "page": {
        "minimum": 1,
        "type": "integer"
      },
      "path": {
        "type": "string"
      },
      "quarters": {
        "type": "integer"
      },
      "rect": {
        "items": {
          "type": "number"
        },
        "maxItems": 4,
        "minItems": 4,
        "type": "array"
      }
    },
    "required": [
      "doc",
      "page",
      "image",
      "action"
    ],
    "type": "object"
  }
}