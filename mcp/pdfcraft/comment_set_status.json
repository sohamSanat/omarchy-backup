{
  "name": "comment_set_status",
  "description": "Set a comment's review status (Acrobat: Set status), recorded as a status reply. Undoable.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "author": {
        "type": "string"
      },
      "doc": {
        "description": "Document id from doc_open or doc_list.",
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "description": "The comment's id (from comment_list).",
        "type": "string"
      },
      "index": {
        "description": "1-based position on the page, as comment_list reports.",
        "minimum": 1,
        "type": "integer"
      },
      "page": {
        "description": "With `index`, instead of `id`.",
        "minimum": 1,
        "type": "integer"
      },
      "status": {
        "enum": [
          "none",
          "accepted",
          "rejected",
          "cancelled",
          "completed"
        ],
        "type": "string"
      }
    },
    "required": [
      "doc",
      "status"
    ],
    "type": "object"
  }
}