{
  "name": "content_update",
  "description": "Move/resize (rect), retype (text) or restyle (font, size, bold, italic, color, align) an added item (page, index from content_list). Images: rotate (degrees, multiple of 90, counter-clockwise), flip_h / flip_v (toggle), crop [left, bottom, right, top] as fractions trimmed, image (a file that replaces the picture). Undoable.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "align": {
        "enum": [
          "left",
          "center",
          "right",
          "justify"
        ],
        "type": "string"
      },
      "bold": {
        "type": "boolean"
      },
      "color": {
        "type": "string"
      },
      "crop": {
        "items": {
          "maximum": 0.49,
          "minimum": 0,
          "type": "number"
        },
        "maxItems": 4,
        "minItems": 4,
        "type": "array"
      },
      "doc": {
        "description": "Document id from doc_open or doc_list.",
        "minimum": 1,
        "type": "integer"
      },
      "flip_h": {
        "type": "boolean"
      },
      "flip_v": {
        "type": "boolean"
      },
      "font": {
        "enum": [
          "helvetica",
          "times",
          "courier"
        ],
        "type": "string"
      },
      "image": {
        "description": "Replace the picture with this file.",
        "type": "string"
      },
      "index": {
        "minimum": 1,
        "type": "integer"
      },
      "italic": {
        "type": "boolean"
      },
      "page": {
        "minimum": 1,
        "type": "integer"
      },
      "rect": {
        "items": {
          "type": "number"
        },
        "maxItems": 4,
        "minItems": 4,
        "type": "array"
      },
      "rotate": {
        "type": "integer"
      },
      "size": {
        "maximum": 500,
        "minimum": 1,
        "type": "number"
      },
      "text": {
        "type": "string"
      }
    },
    "required": [
      "doc",
      "page",
      "index"
    ],
    "type": "object"
  }
}