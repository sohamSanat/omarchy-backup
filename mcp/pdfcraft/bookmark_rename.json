{
  "name": "bookmark_rename",
  "description": "Change a bookmark's title. Undoable.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "Document id from doc_open or doc_list.",
        "minimum": 1,
        "type": "integer"
      },
      "path": {
        "description": "The bookmark: 1-based positions from the top level, e.g. [2, 1] = the first child of the second bookmark.",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "type": "array"
      },
      "title": {
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "doc",
      "path",
      "title"
    ],
    "type": "object"
  }
}