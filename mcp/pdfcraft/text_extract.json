{
  "name": "text_extract",
  "description": "Extract the text of some or all pages, in reading order.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "doc": {
        "description": "Document id from doc_open or doc_list.",
        "minimum": 1,
        "type": "integer"
      },
      "pages": {
        "description": "1-based page numbers to extract (default: all).",
        "items": {
          "minimum": 1,
          "type": "integer"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "doc"
    ],
    "type": "object"
  }
}