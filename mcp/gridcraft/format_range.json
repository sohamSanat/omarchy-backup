{"name":"format_range","description":"Apply several formats to a range in one call: bold, italic, underline, font name/size, font color, fill color, number format, horizontal alignment, wrap, borders. Colors are \"#RRGGBB\" (fontColor also \"auto\", fillColor also \"none\"). numberFormat is a name (General, Number, Currency, Accounting, Comma, Percentage, Short Date, Long Date, Time, Fraction, Scientific, Text) or a format code (\"#,##0.00\", \"0%\", \"yyyy-mm-dd\"). Each property runs one command; the result lists them.","parameters":{"additionalProperties":false,"properties":{"bold":{"description":"Bold on/off","type":"boolean"},"borders":{"description":"A border preset name, or {preset, style?, color?}","oneOf":[{"description":"Border preset","enum":["bottom","top","left","right","none","all","outside","thickOutside","thickBottom","doubleBottom","topBottom","topThickBottom","topDoubleBottom","insideHorizontal","insideVertical","inside","diagonalDown","diagonalUp"],"type":"string"},{"additionalProperties":false,"properties":{"color":{"description":"Border color \"#RRGGBB\"","type":"string"},"preset":{"description":"Border preset","enum":["bottom","top","left","right","none","all","outside","thickOutside","thickBottom","doubleBottom","topBottom","topThickBottom","topDoubleBottom","insideHorizontal","insideVertical","inside","diagonalDown","diagonalUp"],"type":"string"},"style":{"description":"thin|medium|thick|dashed|dotted|double|hair…","type":"string"}},"required":["preset"],"type":"object"}]},"fillColor":{"description":"Background color \"#RRGGBB\" or \"none\"","type":"string"},"fontColor":{"description":"Text color \"#RRGGBB\" or \"auto\"","type":"string"},"fontName":{"description":"Font family, e.g. \"Calibri\"","type":"string"},"fontSize":{"description":"Font size in points","maximum":409,"minimum":1,"type":"number"},"horizontalAlign":{"description":"Horizontal alignment","enum":["left","center","right","justify"],"type":"string"},"italic":{"description":"Italic on/off","type":"boolean"},"numberFormat":{"description":"Number format name or code","type":"string"},"range":{"description":"A1-style range, e.g. \"A1:D10\", \"B:B\", \"Sheet2!A1:C3\"","type":"string"},"underline":{"description":"Single underline on/off","type":"boolean"},"wrapText":{"description":"Wrap text on/off","type":"boolean"}},"required":["range"],"type":"object"}}