+      hl.exec_cmd("omarchy-shell shell summon reomarchy.workspace-switcher '{\"selectWorkspace\":" .. workspace .. "}'")
+    end
+    hl.bind(key, select_ws, { ignore_mods = true })
+    hl.bind("SUPER + " .. key, select_ws)
+  end
 end)
 
