+            font.family: root.monoFont
+            font.pixelSize: Style.space(11)
+            font.bold: true
+          }
+        }
+      }
+
+      // Bottom Right: Type indicator
+      Row {
+        anchors.right: parent.right
+        anchors.verticalCenter: parent.verticalCenter
