+static void load_omarchy_theme_env(void) {
+  if (getenv("OMARCHY_THEME_NAME") && getenv("OMARCHY_THEME_ACCENT"))
+    return;
+  const char *home = getenv("HOME");
+  if (!home) return;
+  char env_path[512];
+  snprintf(env_path, sizeof(env_path), "%s/.local/state/omarchy/theme-mode.env", home);
+  FILE *fp = fopen(env_path, "r");
+  if (!fp) return;
+  char line[256];
+  while (fgets(line, sizeof(line), fp)) {
+    char *p = line;
+    while (*p == ' ' || *p == '\t') p++;
+    if (strncmp(p, "export ", 7) == 0) p += 7;
+    char *eq = strchr(p, '=');
+    if (!eq) continue;
+    *eq = '\0';
+    char *key = p;
+    char *val = eq + 1;
+    while (*val == '"' || *val == '\'') val++;
+    int vlen = strlen(val);
+    while (vlen > 0 && (val[vlen-1] == '\n' || val[vlen-1] == '\r' || val[vlen-1] == '"' || val[vlen-1] == '\''))
+      val[--vlen] = '\0';
+    setenv(key, val, 0);
+  }
+  fclose(fp);
+}
