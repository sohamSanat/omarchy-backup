diff --git i/ClipboardHistory.js w/ClipboardHistory.js
index 0d2ff2a..96eb1a1 100644
--- i/ClipboardHistory.js
+++ w/ClipboardHistory.js
@@ -134,6 +134,34 @@ function clearHistory() {
   return []
 }
 
+function isAttachment(entry) {
+  if (!entry) return false
+  if (entry.type === "image") return true
+  var paths = filePaths(entry)
+  return paths.length > 0
+}
+
+function clearAttachments(values) {
+  var list = Array.isArray(values) ? values : []
+  var next = []
+  for (var i = 0; i < list.length; i++) {
+    var entry = list[i]
+    if (entry && !isAttachment(entry)) {
+      next.push(entry)
+    }
+  }
+  return next
+}
+
+function attachmentCount(values) {
+  var list = Array.isArray(values) ? values : []
+  var count = 0
+  for (var i = 0; i < list.length; i++) {
+    if (isAttachment(list[i])) count++
+  }
+  return count
+}
+
 function parseEntryJson(line) {
   var raw = String(line || "").trim()
   if (!raw) return null
@@ -279,6 +307,9 @@ if (typeof module !== "undefined") {
     togglePinAt: togglePinAt,
     movePinnedAt: movePinnedAt,
     clearHistory: clearHistory,
+    clearAttachments: clearAttachments,
+    isAttachment: isAttachment,
