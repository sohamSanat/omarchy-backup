+def read_opencode_recent_parts(since_time_ms: int, provider_session_id: str | None = None) -> list[dict]:
+    """Reads recent message/tool execution parts from OpenCode SQLite database."""
+    db_path = Path.home() / ".local/share/opencode/opencode.db"
+    if not db_path.is_file():
+        return []
+    if not provider_session_id:
+        return []
+    try:
+        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=2.0)
+        cur = conn.cursor()
+        cur.execute(
+            "SELECT id, time_created, data FROM part WHERE session_id = ? AND time_created > ? ORDER BY time_created ASC",
+            (provider_session_id, since_time_ms),
+        )
+        rows = cur.fetchall()
+        conn.close()
+        parts = []
+        for rid, t_created, d_str in rows:
+            try:
+                p_data = json.loads(d_str)
+                p_data["_part_id"] = rid
+                p_data["_time_created"] = t_created
+                parts.append(p_data)
+            except Exception:
+                pass
+        return parts
+    except Exception:
+        return []
