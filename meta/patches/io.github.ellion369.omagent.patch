+    if diff < 86400:
+        hours = diff // 3600
+        return f"{hours}h ago"
+    if diff < 86400 * 2:
+        return "Yesterday"
+    if diff < 86400 * 7:
+        days = diff // 86400
+        return f"{days}d ago"
+    return time.strftime("%b %d", time.localtime(updated_at_ms / 1000))
+
