+def _safe_session_id(session_id: str, *, allow_last: bool = False) -> str:
+    value = str(session_id or "").strip()
+    if allow_last and value == "last":
+        return value
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", value) or value in {".", ".."}:
+        raise ValueError("session ID contains unsafe path characters")
+    return value
+
+
+def _atomic_write_json(path: Path, data: object) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(path.suffix + ".tmp")
+    tmp.write_text(json.dumps(data, indent=2), "utf-8")
+    tmp.replace(path)
+
+
+def _store_session_summaries() -> list[dict]:
+    try:
+        snapshots = _get_session_store().list_snapshots()
+    except Exception as exc:
+        if DEBUG:
+            print(f"Controller store unavailable: {exc}", file=sys.stderr)
+        return []
+    sessions = []
+    for data in snapshots:
+        if not isinstance(data, dict):
+            continue
+        entries = data.get("entries", [])
+        title = str(data.get("title", ""))
+        if not title and entries:
+            for entry in entries:
+                if entry.get("rowKind") == "you":
+                    title = str(entry.get("rowText", ""))
+                    break
+        if not title:
+            continue
+        updated_at = int(data.get("updatedAt", 0) or 0)
+        preview = ""
+        for entry in reversed(entries):
+            if entry.get("rowKind") in {"text", "error"}:
+                preview = clean_preview_text(entry.get("rowText", ""))
+                break
+        sessions.append({
+            "id": str(data.get("sessionId", "")),
+            "title": clip(title, 75, collapse=True),
+            "agentLabel": str(data.get("agentLabel", "Jarvis") or "Jarvis"),
+            "agentName": str(data.get("agentName", "jarvis") or "jarvis"),
+            "timeAgo": format_time_ago(updated_at),
+            "updatedAt": updated_at,
+            "preview": preview,
+            "messageCount": len(entries),
+        })
+    return sessions
+
