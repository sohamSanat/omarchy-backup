+from __future__ import annotations
+
+import os
+import unittest
+
+from omagent_core.secrets import redact_data, redact_text, resolve_secret
+
+
+class SecretResolutionTests(unittest.TestCase):
+    def test_environment_secret_wins_over_legacy_config(self):
+        original = os.environ.get("GEMINI_API_KEY")
+        os.environ["GEMINI_API_KEY"] = "from-environment"
+        try:
+            resolved = resolve_secret("GEMINI_API_KEY", {"gemini_api_key": "from-config"}, "gemini_api_key")
+        finally:
+            if original is None:
+                os.environ.pop("GEMINI_API_KEY", None)
+            else:
+                os.environ["GEMINI_API_KEY"] = original
+        self.assertEqual(resolved.value, "from-environment")
+        self.assertEqual(resolved.source, "environment")
+
+    def test_redaction_covers_headers_assignments_and_query_parameters(self):
+        value = "Authorization: Bearer abc123 api_key=secret https://example.test/?token=query"
+        redacted = redact_text(value)
+        self.assertNotIn("abc123", redacted)
+        self.assertNotIn("secret", redacted)
+        self.assertNotIn("query", redacted)
+        self.assertIn("[REDACTED]", redacted)
+
+    def test_redaction_recurses_into_evidence_containers(self):
+        value = {"commands": ["TOKEN=secret"], "nested": {"note": "Bearer abc"}}
+        redacted = redact_data(value)
+        self.assertNotIn("secret", str(redacted))
+        self.assertNotIn("abc", str(redacted))
+
+    def test_legacy_config_is_reported_as_legacy_source(self):
+        original = os.environ.pop("GEMINI_API_KEY", None)
+        try:
+            resolved = resolve_secret("GEMINI_API_KEY", {"gemini_api_key": "legacy"}, "gemini_api_key")
+        finally:
+            if original is not None:
+                os.environ["GEMINI_API_KEY"] = original
+        self.assertEqual(resolved.value, "legacy")
+        self.assertEqual(resolved.source, "legacy-config")
+
+
+if __name__ == "__main__":
+    unittest.main()
