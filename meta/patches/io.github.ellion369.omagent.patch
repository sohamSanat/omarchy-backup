+def _manifest_from_fleet(session_id: str, run_id: str, fleet_data: dict) -> dict:
+    manifest = RunManifest(
+        RunIdentity(
+            conversation_id=session_id,
+            run_id=run_id,
+            provider_session_id=fleet_data.get("providerSessionId") or None,
+        ),
+        workspace=fleet_data.get("cwd"),
+        workspace_owned=fleet_data.get("workspaceOwned") is True,
+        evidence_generation=fleet_data.get("evidenceGeneration") or f"evidence-{run_id}",
+        artifact_revision=fleet_data.get("artifactRevision") or "",
+        provider=fleet_data.get("provider"),
+        reviewer=fleet_data.get("reviewer"),
+    )
+    if fleet_data.get("workspaceOwned") is True and fleet_data.get("cwd"):
+        worktree = manifest.reserve("worktree", str(fleet_data["cwd"]))
+        manifest.mark_created(worktree)
+    if fleet_data.get("herdrWorkspaceId"):
+        workspace = manifest.reserve("herdr_workspace", str(fleet_data["herdrWorkspaceId"]))
+        manifest.mark_created(workspace)
+    created_task_ids = fleet_data.get("createdFirstmateTasks")
+    created_task_set = set(created_task_ids) if isinstance(created_task_ids, list) else None
+    for key, kind in (
+        ("herdrPaneId", "pane"),
+        ("herdrMotionPaneId", "pane"),
+        ("herdrCompPaneId", "pane"),
+        ("herdrRevPaneId", "pane"),
+        ("fmTaskId", "firstmate_task"),
+        ("fmMotionTaskId", "firstmate_task"),
+        ("fmCompTaskId", "firstmate_task"),
+        ("fmRevTaskId", "firstmate_task"),
+    ):
+        identifier = fleet_data.get(key)
+        if identifier and (kind != "firstmate_task" or created_task_set is None or str(identifier) in created_task_set):
+            resource = manifest.reserve(kind, str(identifier))
+            manifest.mark_created(resource)
+    if manifest.resources:
+        manifest.commit()
+    return manifest.as_dict()
+
+
+def _persist_fleet_ownership(session_id: str, fleet_data: dict, run_id: str) -> None:
+    store = _get_session_store()
+    manifest = _manifest_from_fleet(session_id, run_id, fleet_data)
+    existing = store.load_manifest(run_id)
+    if existing:
+        merged = {(item.get("kind"), item.get("identifier")): item for item in existing.get("resources", [])}
+        for item in manifest.get("resources", []):
+            key = (item.get("kind"), item.get("identifier"))
+            prior = merged.get(key)
+            if prior is None or prior.get("state") == "intended":
+                merged[key] = item
+        manifest["resources"] = list(merged.values())
+        manifest["workspace"] = manifest.get("workspace") or existing.get("workspace")
+        manifest["workspace_owned"] = bool(manifest.get("workspace_owned") or existing.get("workspace_owned"))
+        manifest["evidence_generation"] = manifest.get("evidence_generation") or existing.get("evidence_generation") or f"evidence-{run_id}"
+        manifest["artifact_revision"] = manifest.get("artifact_revision") or existing.get("artifact_revision")
+        manifest["provider"] = manifest.get("provider") or existing.get("provider")
+        manifest["reviewer"] = manifest.get("reviewer") or existing.get("reviewer")
+        for key in ("parent_run_id", "attempt_id", "provider_session_id"):
+            if not manifest["identity"].get(key) and existing.get("identity", {}).get(key):
+                manifest["identity"][key] = existing["identity"][key]
+        manifest["committed"] = any(item.get("state") == "owned" for item in manifest["resources"])
+    if manifest == existing:
+        return
+    store.save_manifest(manifest)
+
