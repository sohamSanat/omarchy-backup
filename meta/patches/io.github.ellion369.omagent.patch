+def import_review_receipt(path: Path, run_id: str) -> ReviewReceipt | None:
+    """Move a valid reviewer file into the controller-owned receipt channel."""
+    if not run_id:
+        return load_review_receipt(path)
+    receipt = load_review_receipt(path)
+    if receipt is None:
+        return None
+    store = _get_session_store()
+    try:
+        was_blocked = store.state(run_id) == "blocked"
+        store.save_review_receipt(run_id, receipt)
+        if was_blocked:
+            store.set_state(run_id, "starting", reason="independent review receipt received")
+    except Exception as exc:
+        if DEBUG:
+            print(f"review receipt rejected by controller: {exc}", file=sys.stderr)
+        return None
+    return store.load_review_receipt(run_id)
