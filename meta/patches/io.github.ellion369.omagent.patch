+def deconstruct_reference_image(
+    image_path: str,
+    user_request: str,
+    domain: str,
+    ui_set: int,
+    config: dict | None = None,
+) -> dict:
+    """Subagent 1: Analyzes and deconstructs visual design language from the reference image with strict anti-copying enforcement."""
+    img_p = Path(image_path).expanduser().resolve()
+    if not img_p.is_file():
+        return {}
+
+    prof = extract_image_visual_profile(img_p)
+    w, h = prof["width"], prof["height"]
+    aspect = prof["aspect"]
+    fmt = prof["format"]
+    is_dark = prof["is_dark"]
+    bg_hex = prof["bg_color"]
+    accent_hex = prof["accent_color"]
+    top_hexes = [c["hex"] for c in prof["top_colors"][:4]]
