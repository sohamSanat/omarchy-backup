+def cmd_import_session_file(path_value: str) -> int:
+    handoff_root = HANDOFF_DIR.resolve()
+    candidate = Path(path_value).resolve()
+    try:
+        candidate.relative_to(handoff_root)
+    except ValueError:
+        print(json.dumps({"ok": False, "error": "handoff path is outside the state directory"}))
+        return 1
+    try:
+        payload = json.loads(candidate.read_text("utf-8"))
+        if not isinstance(payload, dict):
+            raise ValueError("handoff payload must be an object")
+        conversation_id = _safe_session_id(str(payload.get("sessionId") or "last"), allow_last=True)
+        store = _get_session_store()
+        store.save_snapshot(conversation_id, payload)
+        _atomic_write_json(STATE_DIR / "last.json", payload)
+        if conversation_id != "last":
+            _atomic_write_json(SESSION_DIR / f"{conversation_id}.json", payload)
+        candidate.unlink(missing_ok=True)
+        print(json.dumps({"ok": True, "conversationId": conversation_id}))
+        return 0
+    except Exception as exc:
+        print(json.dumps({"ok": False, "error": str(exc)}))
+        return 1
+
+
+def cmd_migrate_legacy() -> int:
+    snapshots: list[dict] = []
+    for path in sorted(SESSION_DIR.glob("*.json")):
+        if any(path.name.endswith(suffix) for suffix in (".history.json", ".fleet.json", ".ui_pending.json", ".uiset.json")):
+            continue
+        try:
+            value = json.loads(path.read_text("utf-8"))
+            if isinstance(value, dict):
+                snapshots.append(value)
+        except Exception as exc:
+            print(json.dumps({"ok": False, "error": f"could not read {path.name}: {exc}"}))
+            return 1
+    report = migrate_snapshots(_get_session_store(), snapshots)
+    print(json.dumps({"ok": report.ok, "imported": report.imported, "recoveryRequired": report.recovery_required, "skipped": report.skipped}))
+    return 0 if report.ok else 1
