+def classify_intent(request: str, prior_agent: str = "") -> str:
+    req_lower = request.strip().lower()
+
+    # Explicit prefix overrides
+    if req_lower.startswith(("/code ", "code: ")):
+        return LANE_CODE
+    if req_lower.startswith(("/web ", "web: ", "/search ", "search: ")):
+        return LANE_WEB
+    if req_lower.startswith(("/ask ", "ask: ")):
+        return LANE_GENERAL
+
+    # Regex heuristic check
+    for pattern in CODE_INDICATORS:
+        if re.search(pattern, req_lower, re.IGNORECASE):
+            return LANE_CODE
+
+    for pattern in WEB_INDICATORS:
+        if re.search(pattern, req_lower, re.IGNORECASE):
+            return LANE_WEB
+
+    # Sticky lane: If continuing a coding session and user didn't explicitly override
+    if prior_agent in ("firstmate-pi", "antigravity-agy") and not req_lower.startswith(("/ask", "ask:", "/web", "web:")):
+        return LANE_CODE
+
+    return LANE_GENERAL
 
 
