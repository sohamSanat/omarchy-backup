+def run_lane_web(request: str, config: dict, session_id: str, *, run_id: str = "") -> int:
+    api_key = config.get("gemini_api_key", "").strip()
+    cwd = work_dir()
+
+    emit(
+        "agent",
+        name="jarvis-web",
+        label="Jarvis (Web)",
+        session=session_id,
+        cwd=str(cwd),
+        resume=[],
+        resumeLabel="Expand",
+        pid=0,
+    )
+
+    if not api_key:
+        emit("error", text="Gemini API key is missing. Please add it to ~/.config/omagent/config.json")
+        emit("done", ok=False, code=1, stopped=False)
+        return 1
+
+    emit("tool", text="Searching web...")
+    search_query = clean_prefix(request)
+
+    # Load prior conversation history for multi-turn context
+    history = load_session_history(session_id)
+    search_query_resolved = resolve_contextual_query(
+        search_query,
+        history,
+        api_key,
+        model=config.get("fast_model", "gemini-3.5-flash"),
+    )
+    raw_results = search_duckduckgo(search_query_resolved)
+    retrieval = assess_retrieval(
+        search_query,
+        [Source(url=item.get("link", ""), title="", text=item.get("snippet", ""), quality="unknown") for item in raw_results],
+    )
+    if not retrieval.usable:
+        emit("error", text="Web retrieval returned no usable evidence; no ungrounded answer was generated.")
+        emit("done", ok=False, code=1, stopped=False)
+        return 1
+
+    snippets_text = "\n".join(
+        f"[{i+1}] {source.text} (Source: {source.url})"
+        for i, source in enumerate(retrieval.sources)
+    )
+    prompt_text = (
+        f"User Query: {search_query}\n\n"
+        f"Live Web Search Results:\n{snippets_text}\n\n"
+        f"Synthesize an accurate, grounded, and concise answer using the web results above and the ongoing conversation context. "
+        f"Cite relevant sources where helpful. Retrieval warnings: {json.dumps(retrieval.warnings)}"
+    )
+
+    contents = build_conversation_contents(history, prompt_text)
+
+    system_instruction = get_system_instruction(lane="web")
+
+    ok, err, full_text = stream_gemini_api(
+        prompt=contents,
+        api_key=api_key,
+        model=config.get("web_model", "gemini-3.5-flash"),
+        system_instruction=system_instruction,
+    )
+
+    if not ok:
+        emit("error", text=err)
+        emit("done", ok=False, code=1, stopped=False)
+        return 1
+
+    # Save clean user prompt and assistant response
+    history_to_save = list(history)
+    history_to_save.append({"role": "user", "parts": [{"text": search_query}]})
+    save_session_history(session_id, history_to_save, full_text)
+    quality_state = record_lane_quality("web", request, full_text, evidence=[source.url for source in retrieval.sources], run_id=run_id)
+
+    emit("done", ok=True, code=0, stopped=False, terminal_state=quality_state)
+    return 0
