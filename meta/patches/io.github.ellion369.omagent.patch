+def _update_review_binding(cwd: Path, run_id: str) -> None:
+    if not run_id:
+        return
+    store = _get_session_store()
+    manifest = store.load_manifest(run_id)
+    if not manifest:
+        return
+    manifest["artifact_revision"] = _artifact_revision(cwd)
+    if not manifest.get("evidence_generation"):
+        manifest["evidence_generation"] = f"evidence-{run_id}"
+    store.save_manifest(manifest)
+    request = {
+        "run_id": run_id,
+        "workspace": manifest.get("workspace") or str(cwd),
+        "provider": manifest.get("provider") or "",
+        "reviewer_id": (manifest.get("reviewer") or {}).get("reviewer_id") or "",
+        "provider_session_id": (manifest.get("identity") or {}).get("provider_session_id") or "",
+        "evidence_generation": manifest.get("evidence_generation") or "",
+        "artifact_revision": manifest.get("artifact_revision") or "",
+        "ui_evidence_digests": _expected_ui_review_scope(run_id),
+    }
+    request_path = cwd / ".omagent" / "review-receipts" / f"{run_id}.request.json"
+    request_path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = request_path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(request, indent=2) + "\n", encoding="utf-8")
+    temporary.replace(request_path)
+
