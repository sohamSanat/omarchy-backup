+def sanitize_rest_model(model: str | None) -> str:
+    """Sanitizes model name for Google generativelanguage REST API endpoints.
+    Models like gemini-3.8-flash, 3.7, 3.6, 2.5, 1.5 do not exist on REST v1beta and cause 25s hangs or 404s.
+    """
+    m = str(model or "").strip()
+    if not m:
+        return "gemini-3.5-flash"
+    if m in VALID_REST_MODELS:
+        return m
+    for bad in ("3.8", "3.7", "3.6", "2.5", "1.5", "gemini-pro", "gemini-flash"):
+        if bad in m:
+            return "gemini-3.5-flash"
+    return "gemini-3.5-flash"
 
 
