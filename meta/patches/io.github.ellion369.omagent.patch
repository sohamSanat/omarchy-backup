+def _implementation_evidence(cwd: Path) -> list[str]:
+    try:
+        result = subprocess.run(
+            ["git", "-C", str(cwd), "status", "--porcelain"],
+            capture_output=True, text=True, timeout=5,
+        )
+        if result.returncode == 0 and result.stdout.strip():
+            return ["implementation: git working tree has changes"]
+    except (OSError, subprocess.SubprocessError):
+        pass
+    try:
+        if any(path.is_file() for path in cwd.rglob("*") if not any(part.startswith(".") for part in path.parts)):
+            return ["implementation: workspace contains project files"]
+    except OSError:
+        pass
+    return []
