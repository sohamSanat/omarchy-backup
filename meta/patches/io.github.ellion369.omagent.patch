+def _mark_setup_failed(run_id: str) -> None:
+    if not run_id:
+        return
+    try:
+        store = _get_session_store()
+        if store.state(run_id) in {"starting", "working"}:
+            store.set_state(run_id, "setup_failed", reason="external setup failed")
+    except Exception as exc:
