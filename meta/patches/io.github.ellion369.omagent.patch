+def generate_grill_me_round(project_prompt: str, ui_set: int, round_num: int, previous_decisions: list[dict], config: dict | None = None, ref_analysis: dict | None = None) -> dict:
+    # Layer 1: Fast LLM Dynamic Generation Attempt (3.5s timeout)
+    llm_res = call_llm_dynamic_grill_questions(
+        project_prompt, ui_set, round_num, previous_decisions, ref_analysis=ref_analysis, config=config
+    )
+    if llm_res and len(llm_res.get("questions", [])) == 6:
+        return llm_res
+
+    # Layer 2: High-Speed Algorithmic Dynamic Synthesizer (<5ms, guaranteed 6 questions)
+    return generate_algorithmic_dynamic_grill_questions(
+        project_prompt, ui_set, round_num, previous_decisions, ref_analysis=ref_analysis
+    )
