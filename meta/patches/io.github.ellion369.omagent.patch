+def detect_ui_archetype(request: str) -> int | None:
+    req_lower = request.lower()
+
+    if re.search(r"\b(set\s*1|skill\s*set\s*1|full\s*aesthetic|linear\s*style|stripe\s*press|swiss\s*style|braun\s*style)\b", req_lower):
+        return 1
+    if re.search(r"\b(full\s*aesthetic|ultra\s*aesthetic|pure\s*aesthetic)\b", req_lower) or re.search(r"\baesthetic\s+(ui|landing|page|site|website|design)\b", req_lower):
+        return 1
+
+    if re.search(r"\b(set\s*2|skill\s*set\s*2|saas\s*archetype|saas\s*app|saas\s*style|enterprise\s*dashboard|b2b\s*saas)\b", req_lower):
+        return 2
+    if re.search(r"\bsaas\b", req_lower) and any(w in req_lower for w in ("app", "dashboard", "platform", "product", "tool", "portal")):
+        return 2
+
+    if re.search(r"\b(set\s*3|skill\s*set\s*3|jaw\s*drop|jaw\s*dropping|jaw\s*droping|3d\s*showcase|awwwards\s*style|threejs\s*world|webgl\s*showcase)\b", req_lower):
+        return 3
+    if re.search(r"\b(jaw\s*drop|jaw\s*dropping|jaw\s*droping)\b", req_lower):
+        return 3
+
+    return None
