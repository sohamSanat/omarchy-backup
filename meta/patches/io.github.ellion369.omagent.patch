+def format_time_ago(updated_at_ms: int) -> str:
+    now_ms = int(time.time() * 1000)
+    diff = max(0, (now_ms - updated_at_ms) // 1000)
+    if diff < 60:
+        return "Just now"
+    if diff < 3600:
+        mins = max(1, diff // 60)
+        return f"{mins}m ago"
+    if diff < 86400:
+        hours = diff // 3600
+        return f"{hours}h ago"
+    if diff < 86400 * 2:
+        return "Yesterday"
+    if diff < 86400 * 7:
+        days = diff // 86400
+        return f"{days}d ago"
+    return time.strftime("%b %d", time.localtime(updated_at_ms / 1000))
