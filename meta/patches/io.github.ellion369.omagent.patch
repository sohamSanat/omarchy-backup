+def parse_ui_set_choice(text: str) -> int | None:
+    t = text.strip().lower()
+
+    if t in ("1", "1.", "(1)", "[1]", "#1"):
+        return 1
+    if t in ("2", "2.", "(2)", "[2]", "#2"):
+        return 2
+    if t in ("3", "3.", "(3)", "[3]", "#3"):
+        return 3
