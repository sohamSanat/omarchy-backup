+            f"harness={harness}\n"
+            f"model={model}\n"
+            f"role={role}\n"
+            f"skill={skill}\n"
+            f"kind=crewmate\n"
+            f"mode=local-only\n"
+            f"yolo=on\n"
+        )
+        meta_path.write_text(content, "utf-8")
