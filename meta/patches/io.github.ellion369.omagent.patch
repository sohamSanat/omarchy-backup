+def _reserve_run_resource(
+    session_id: str,
+    run_id: str,
+    *,
+    kind: str,
+    identifier: str,
+    workspace: str | None = None,
+    provider: str | None = None,
+) -> None:
+    """Persist a setup intent before an external resource is created."""
+    store = _get_session_store()
+    existing = store.load_manifest(run_id)
+    if existing:
+        manifest = RunManifest.from_dict(existing)
+    else:
+        manifest = RunManifest(
+            RunIdentity(session_id, run_id),
+            workspace=workspace,
+            evidence_generation=f"evidence-{run_id}",
+            provider=provider,
+        )
+    if manifest.workspace is None and workspace:
+        manifest.workspace = workspace
+    if manifest.provider is None and provider:
+        manifest.provider = provider
+    if not any(item.kind == kind and item.identifier == identifier for item in manifest.resources):
+        manifest.reserve(kind, identifier)
+    store.save_manifest(manifest)
+
+
+def _release_run_resource(run_id: str, kind: str, identifier: str) -> None:
+    store = _get_session_store()
+    existing = store.load_manifest(run_id)
+    if not existing:
+        return
+    manifest = RunManifest.from_dict(existing)
+    for resource in manifest.resources:
+        if resource.kind == kind and resource.identifier == identifier and resource.state in {"intended", "created", "owned"}:
+            resource.state = "released"
+    store.save_manifest(manifest)
+
+
+def _update_session_fleet_projection(session_id: str, run_id: str, updates: dict) -> None:
+    """Persist newly created ownership before the next external side effect."""
+    if not session_id or not run_id:
+        return
+    current = get_session_fleet(session_id) or {"sessionId": session_id}
+    current.update(updates)
+    save_session_fleet(session_id, current, run_id=run_id)
