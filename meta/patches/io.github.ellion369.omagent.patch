+def save_session_fleet(session_id: str, fleet_data: dict, *, run_id: str | None = None) -> None:
+    """Persists the compatibility fleet projection and its run-owned manifest."""
+    if not session_id or not fleet_data:
+        return
+    if run_id:
+        _persist_fleet_ownership(session_id, fleet_data, run_id)
+    try:
+        SESSION_DIR.mkdir(parents=True, exist_ok=True)
+        fleet_file = SESSION_DIR / f"{session_id}.fleet.json"
+        fleet_file.write_text(json.dumps(fleet_data, indent=2), "utf-8")
+    except Exception as e:
+        if DEBUG:
+            print(f"Error saving fleet info for {session_id}: {e}", file=sys.stderr)
