+def resolve_compound_skill(prompt: str) -> tuple[str, list[str], str]:
+    prompt_lower = prompt.lower()
+    # 1. Exact skill name mentioned (e.g. "ce-debug", "ce-plan", "lfg")
+    for skill in COMPOUND_SKILLS_MAP:
+        if skill in prompt_lower:
+            meta = COMPOUND_SKILLS_MAP[skill]
+            return skill, meta["aux"], meta["desc"]
+
+    # 2. Check compound promote before general prototype
+    for pattern in COMPOUND_SKILLS_MAP["ce-promote"]["keywords"]:
+        if re.search(pattern, prompt_lower, re.IGNORECASE):
+            return "ce-promote", COMPOUND_SKILLS_MAP["ce-promote"]["aux"], COMPOUND_SKILLS_MAP["ce-promote"]["desc"]
+
+    # 3. Check specialized skills (skip generic ce-work, ce-plan, ce-promote)
+    for skill, data in COMPOUND_SKILLS_MAP.items():
+        if skill in ("ce-work", "ce-plan", "ce-promote"):
+            continue
+        for pattern in data["keywords"]:
+            if re.search(pattern, prompt_lower, re.IGNORECASE):
+                return skill, data["aux"], data["desc"]
+
+    # 4. Check planning
+    for pattern in COMPOUND_SKILLS_MAP["ce-plan"]["keywords"]:
+        if re.search(pattern, prompt_lower, re.IGNORECASE):
+            return "ce-plan", COMPOUND_SKILLS_MAP["ce-plan"]["aux"], COMPOUND_SKILLS_MAP["ce-plan"]["desc"]
+
+    # 5. Check general implementation (ce-work)
+    for pattern in COMPOUND_SKILLS_MAP["ce-work"]["keywords"]:
+        if re.search(pattern, prompt_lower, re.IGNORECASE):
+            return "ce-work", COMPOUND_SKILLS_MAP["ce-work"]["aux"], COMPOUND_SKILLS_MAP["ce-work"]["desc"]
+
+    return "ce-work", COMPOUND_SKILLS_MAP["ce-work"]["aux"], COMPOUND_SKILLS_MAP["ce-work"]["desc"]
