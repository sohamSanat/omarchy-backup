+def extract_project_subject(prompt: str) -> str:
+    """Extracts a clean, descriptive subject phrase representing the core product/domain requested by the user.
+    Ensures prompt primacy so the agent always knows the exact product being built."""
+    cleaned = re.sub(r'\[(?:image|img|ref|attached):\s*[^\]]+\]', '', prompt, flags=re.I)
+    cleaned = re.sub(r'[\w/.-]+\.(?:png|jpg|jpeg|webp|gif|svg)', '', cleaned, flags=re.I)
+    cleaned = re.sub(r'^\s*(?:please\s+)?(?:build|make|create|design|code|generate|develop)\s+(?:me\s+)?(?:an?\s+)?', '', cleaned, flags=re.I)
+    cleaned = re.sub(r'^\s*(?:a|an|the)\s+', '', cleaned, flags=re.I)
+    cleaned = re.sub(r'\s+(?:website|landing\s+page|web\s+app|webapp|site|app|page)\b', '', cleaned, flags=re.I)
+    cleaned = re.sub(r'\s+(?:with|using|guided\s+by|featuring|including)\b.*$', '', cleaned, flags=re.I)
+    cleaned = cleaned.strip()
+    if len(cleaned) > 3:
+        return cleaned.title()
+    stopwords = {"make", "build", "create", "design", "website", "landing", "page", "app", "for", "with", "the", "and", "that", "this"}
+    words = [w for w in re.findall(r"\b[a-zA-Z]{3,}\b", prompt.lower()) if w not in stopwords]
+    if words:
+        return " ".join(words[:4]).title()
+    return "Bespoke Digital Experience"
+
