+def _repair_checks(profile: str, cwd: Path, config: dict, ui_contract: dict | None = None) -> list[CheckResult]:
+    evidence = _implementation_evidence(cwd)
+    evidence.extend(run_declared_verification(cwd, config, profile))
+    if profile == "ui":
+        rendered_paths = [str(path) for path in cwd.rglob("*") if path.is_file() and path.suffix.lower() in {".png", ".jpg", ".jpeg", ".webp"}]
+        return _ui_quality_checks(ui_contract, evidence, rendered_paths)
+    implementation = [item for item in evidence if item.startswith(("file:", "implementation:"))]
+    verification = [item for item in evidence if item.startswith("verification:") and "passed" in item]
+    return [
+        CheckResult("task_contract", True, ["repair preserved task contract"]),
+        CheckResult("implementation", bool(implementation), implementation or ["no implementation evidence after repair"]),
+        CheckResult("verification", bool(verification), verification or ["no deterministic verification evidence after repair"]),
+        CheckResult("review", True, ["independent review remains required"], blocking=False),
+    ]
+
+
+def make_fleet_repair_runner(
+    *,
+    cwd: Path,
+    config: dict,
+    profile: str,
+    task_id: str | None,
+    pane_id: str | None,
+    provider_session_id: str | None,
+    request: str,
+    ui_contract: dict | None = None,
+):
+    def repair(attempt: int, failed: list[str]):
+        if not task_id and not pane_id:
+            return None
+        prompt = (
+            f"Repair attempt {attempt} for the same run and workspace. Failed gates: {', '.join(failed)}. "
+            f"Preserve the task contract. Original request: {request[:800]}"
+        )
+        try:
+            if task_id and shutil.which("firstmate"):
+                FirstmateAdapter(FM_STATE_DIR, runner=subprocess.run).send_task(task_id, prompt)
+            elif pane_id:
+                HerdrAdapter().send_text(pane_id, prompt + "\n")
+            else:
+                return None
+        except (FirstmateError, HerdrError):
+            return None
+        deadline = time.monotonic() + 45
+        checks: list[CheckResult] = []
+        while time.monotonic() < deadline:
+            checks = _repair_checks(profile, cwd, config, ui_contract)
+            if all(item.passed for item in checks if item.blocking):
+                return checks, None
+            time.sleep(1)
+        return checks, None
+
+    return repair
+
+
+def _review_receipt_matches_manifest(receipt: ReviewReceipt, run_id: str) -> bool:
+    if not run_id:
+        return True
+    manifest = _get_session_store().load_manifest(run_id)
+    if not manifest:
+        return False
+    reviewer = manifest.get("reviewer") or {}
+    identity = manifest.get("identity") or {}
+    scope_matches = True
+    if receipt.review_scope:
+        expected = _expected_ui_review_scope(run_id)
+        scope_matches = bool(
+            expected
+            and receipt.review_scope == "ui"
+            and receipt.selected_concept_id.strip()
+            and receipt.render_manifest_digest == expected["render_manifest_digest"]
+            and receipt.interaction_report_digest == expected["interaction_report_digest"]
+            and receipt.accessibility_report_digest == expected["accessibility_report_digest"]
+        )
+    return bool(
+        manifest.get("provider")
+        and identity.get("provider_session_id")
+        and manifest.get("provider") == receipt.provider
+        and identity.get("provider_session_id") != receipt.provider_session_id
+        and reviewer.get("reviewer_id") == receipt.reviewer_id
+        and reviewer.get("provider_session_id") == receipt.provider_session_id
+        and receipt.run_id == run_id
+        and receipt.workspace == (manifest.get("workspace") or "")
+        and receipt.evidence_generation == (manifest.get("evidence_generation") or "")
+        and receipt.artifact_revision == (manifest.get("artifact_revision") or "")
+        and scope_matches
+    )
+
+
+def _typed_ui_evidence(evidence: list[str]) -> UiEvidenceResult | None:
+    parsed: UiEvidenceResult | None = None
+    for item in evidence:
+        if not item.startswith("ui_evidence:"):
+            continue
+        try:
+            parsed = UiEvidenceResult.from_dict(json.loads(item[len("ui_evidence:"):]))
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+    return parsed
+
+
+def _ui_quality_checks(
+    contract: dict | None,
+    evidence: list[str],
+    rendered_paths: list[str] | None = None,
+    recent_runs: list[dict] | None = None,
+) -> list[CheckResult]:
+    """Build fail-closed UI checks from the frozen contract and local evidence."""
+    if not isinstance(contract, dict):
+        return [
+            CheckResult("subject_fidelity", False, ["no frozen UI design contract"]),
+            CheckResult("design_contract", False, ["no frozen UI design contract"]),
+            CheckResult("reference_boundary", True, ["no reference image supplied"], blocking=False),
+            CheckResult("reference_fidelity", True, ["no reference image supplied"], blocking=False),
+            CheckResult("concept_novelty", False, ["no concept evidence"]),
+            CheckResult("rendered_evidence", False, ["no rendered UI evidence"]),
+            CheckResult("interaction_quality", False, ["no interaction evidence"]),
+            CheckResult("accessibility", False, ["no accessibility evidence"]),
+            CheckResult("visual_review", True, ["independent visual review is required"], blocking=False),
+        ]
+    try:
+        contract_value = DesignContract.from_dict(contract)
+        contract_value.validate()
+    except (TypeError, ValueError) as exc:
+        return [
+            CheckResult("subject_fidelity", False, [f"invalid UI contract: {exc}"]),
+            CheckResult("design_contract", False, [f"invalid UI contract: {exc}"]),
+            CheckResult("reference_boundary", True, ["reference boundary unavailable"], blocking=False),
+            CheckResult("reference_fidelity", True, ["reference fidelity unavailable"], blocking=False),
+            CheckResult("concept_novelty", False, ["invalid UI contract"]),
+            CheckResult("rendered_evidence", False, ["invalid UI contract"]),
+            CheckResult("interaction_quality", False, ["invalid UI contract"]),
+            CheckResult("accessibility", False, ["invalid UI contract"]),
+            CheckResult("visual_review", True, ["independent visual review remains required"], blocking=False),
+        ]
+    concept_validation = validate_concept_diversity(contract_value.candidates)
+    reference = contract_value.reference_policy.as_dict() if contract_value.reference_policy else None
+    visual = None
+    if rendered_paths:
+        try:
+            visual = evaluate_visual_evidence(
+                rendered_paths,
+                reference=reference,
+                concepts=contract_value.candidates,
+                recent_runs=recent_runs or [],
+                product_family=contract_value.product_family,
+            )
+        except Exception as exc:
+            visual = None
+            evidence.append(f"visual_qa_error: {redact_text(str(exc))[:160]}")
+    typed_evidence = _typed_ui_evidence(evidence)
+    typed_live = bool(typed_evidence and typed_evidence.live_eligible)
+    has_rendered = bool(typed_live and rendered_paths and visual and visual.available)
+    interaction_evidence = []
+    accessibility_evidence = []
+    if typed_evidence is not None:
+        interaction_evidence = [f"ui_interaction_report:{json.dumps(typed_evidence.interaction.as_dict(), sort_keys=True)}"]
+        accessibility_evidence = [f"ui_accessibility_report:{json.dumps(typed_evidence.accessibility.as_dict(), sort_keys=True)}"]
+    has_interaction = bool(typed_live and typed_evidence and typed_evidence.interaction.results and all(item.get("status") in {"pass", "passed", "fixture-pass"} for item in typed_evidence.interaction.results))
+    has_accessibility = bool(typed_live and typed_evidence and typed_evidence.accessibility.results and all(item.get("status") in {"pass", "passed", "fixture-pass"} for item in typed_evidence.accessibility.results))
+    reference_required = reference is not None
+    boundary_passed = bool(visual.boundary.get("passed", not reference_required)) if visual else not reference_required
+    fidelity_passed = bool(visual and visual.reference.get("path") and visual.reference.get("fidelity_status") in {"review-required", "recorded"}) if reference_required else True
+    novelty_passed = bool(visual and visual.novelty.get("passed", False)) if has_rendered else False
+    contract_evidence = [f"ui_contract:{contract_value.version}", f"ui_subject:{contract_value.subject}"]
+    if visual:
+        evidence.append("visual_qa:" + json.dumps(visual.as_dict(), sort_keys=True))
+    return [
+        CheckResult("subject_fidelity", bool(contract_value.subject), contract_evidence),
+        CheckResult("design_contract", True, ["frozen structured UI concept contract"]),
+        CheckResult("reference_boundary", boundary_passed, ["ui_reference_boundary:" + json.dumps((visual.boundary if visual else {"required": reference_required, "passed": not reference_required}), sort_keys=True)]),
+        CheckResult("reference_fidelity", fidelity_passed, ["ui_reference_fidelity:" + ("reference evidence recorded" if reference_required else "not applicable")], blocking=reference_required),
+        CheckResult("concept_novelty", novelty_passed and concept_validation.valid, ["ui_concept_novelty:" + json.dumps(concept_validation.as_dict(), sort_keys=True)]),
+        CheckResult("rendered_evidence", has_rendered, ["ui_rendered_evidence:" + json.dumps({"typed": bool(typed_evidence), "live": typed_live, "paths": [str(item) for item in (rendered_paths or [])]}, sort_keys=True)]),
+        CheckResult("interaction_quality", has_interaction, interaction_evidence or ["no typed interaction evidence"]),
+        CheckResult("accessibility", has_accessibility, accessibility_evidence or ["no typed accessibility evidence"]),
+        CheckResult("visual_review", True, ["independent visual review remains required"], blocking=False),
+    ]
+
+
+def record_lane_quality(
+    profile: str,
+    request: str,
+    full_text: str,
+    *,
+    evidence: list[str] | None = None,
+    run_id: str = "",
+    review_receipt: ReviewReceipt | None = None,
+    repair_runner=None,
+    ui_contract: dict | None = None,
+    ui_evidence: UiEvidenceResult | None = None,
+) -> str:
+    if run_id:
+        store = _get_session_store()
+        stored_review = store.load_review_receipt(run_id)
+        if stored_review is not None:
+            if store.state(run_id) == "blocked":
+                store.set_state(run_id, "starting", reason="independent review receipt received")
+            review_receipt = stored_review
+        elif review_receipt is not None:
+            try:
+                was_blocked = store.state(run_id) == "blocked"
+                store.save_review_receipt(run_id, review_receipt)
+                if was_blocked:
+                    store.set_state(run_id, "starting", reason="independent review receipt received")
+            except Exception as exc:
+                if DEBUG:
+                    print(f"review receipt rejected by controller: {exc}", file=sys.stderr)
+                review_receipt = None
+            else:
+                review_receipt = store.load_review_receipt(run_id)
+    contract = TaskContract(
+        request=request,
+        profile=profile,
+        acceptance_criteria=[f"{profile} profile quality checks"],
+    )
+    engine = QualityEngine(contract, sink=_QualityEvidenceSink(run_id))
+    engine.begin_execution()
+    if run_id:
+        try:
+            current_state = _get_session_store().state(run_id)
+            if current_state == "planned":
+                _get_session_store().set_state(run_id, "starting", reason="quality execution started")
+                current_state = "starting"
+            if current_state == "starting":
+                _get_session_store().set_state(run_id, "working", reason="quality execution started")
+        except Exception as exc:
+            if DEBUG:
+                print(f"could not advance quality lifecycle: {exc}", file=sys.stderr)
+    evidence = list(evidence or [])
+    if ui_evidence is not None:
+        evidence.append("ui_evidence:" + json.dumps(ui_evidence.as_dict(), sort_keys=True, separators=(",", ":")))
+    if run_id and profile == "ui":
+        try:
+            stored_ui = _get_session_store().latest_evidence(run_id, "ui_evidence")
+        except Exception as exc:
+            stored_ui = None
+            if DEBUG:
+                print(f"could not load controller UI evidence: {exc}", file=sys.stderr)
+        if isinstance(stored_ui, dict) and isinstance(stored_ui.get("payload"), dict):
+            evidence.append("ui_evidence:" + json.dumps(stored_ui["payload"], sort_keys=True, separators=(",", ":")))
+    if profile == "web":
+        checks = [
+            CheckResult("retrieval_honesty", True, evidence or ["retrieval evidence recorded"]),
+            CheckResult("source_quality", True, evidence or ["retrieval source assessment recorded"]),
+            CheckResult("grounding", bool(full_text.strip()), ["provider answer was non-empty"], blocking=False),
+            CheckResult("injection_resistance", True, ["retrieved content treated as data"]),
+            CheckResult("failure_behavior", True, ["retrieval failure is explicit"]),
+        ]
+    elif profile == "coding":
+        implementation_evidence = [item for item in evidence if item.startswith(("file:", "implementation:"))]
+        verification_evidence = [item for item in evidence if item.startswith("verification:") and "passed" in item]
+        checks = [
+            CheckResult("task_contract", True, ["coding request captured"]),
+            CheckResult("implementation", bool(implementation_evidence), implementation_evidence or ["no implementation evidence recorded"]),
+            CheckResult("verification", bool(verification_evidence), verification_evidence or ["no deterministic verification evidence recorded"]),
+            CheckResult("review", True, ["independent review is not yet available"], blocking=False),
+        ]
+    elif profile == "ui":
+        typed_evidence = _typed_ui_evidence(evidence)
+        rendered_paths = []
+        for item in evidence:
+            if item.startswith("file:"):
+                path = Path(item[5:].strip())
+                if path.suffix.lower() in {".png", ".jpg", ".jpeg", ".webp"}:
+                    rendered_paths.append(str(path))
+        if typed_evidence is not None:
+            rendered_paths.extend(
+                str(render.screenshot_path)
+                for render in typed_evidence.manifest.renders
+                if Path(render.screenshot_path).suffix.lower() in {".png", ".jpg", ".jpeg", ".webp"}
+            )
+        recent_runs = []
+        if run_id:
+            try:
+                recent_runs = _get_session_store().recent_ui_visual_evidence(run_id)
+            except Exception as exc:
+                if DEBUG:
+                    print(f"could not load recent UI evidence: {exc}", file=sys.stderr)
+        check_evidence = list(evidence)
+        checks = _ui_quality_checks(ui_contract, check_evidence, rendered_paths, recent_runs)
+        if run_id and typed_evidence is not None:
+            try:
+                _get_session_store().record_evidence(run_id, {"kind": "ui_evidence", "payload": typed_evidence.as_dict()})
+            except Exception as exc:
+                if DEBUG:
+                    print(f"could not persist typed UI evidence: {exc}", file=sys.stderr)
+        for item in check_evidence:
+            if item.startswith("visual_qa:"):
+                try:
+                    payload = json.loads(item[10:])
+                    payload["product_family"] = (ui_contract or {}).get("product_family", "")
+                    _get_session_store().record_evidence(run_id, {"kind": "ui_visual_evidence", "payload": payload})
+                except Exception:
+                    if DEBUG:
+                        print("could not persist UI visual evidence", file=sys.stderr)
+    else:
+        checks = [
+            CheckResult("instruction_coverage", bool(full_text.strip()), ["provider answer was non-empty"]),
+            CheckResult("context_use", True, ["conversation history was loaded before synthesis"]),
+            CheckResult("clarity", True, ["quality review is not yet available"], blocking=False),
+            CheckResult("uncertainty", True, ["quality review is not yet available"], blocking=False),
+        ]
+    if run_id:
+        try:
+            if _get_session_store().state(run_id) == "working":
+                _get_session_store().set_state(run_id, "verifying", reason="deterministic quality checks started")
+        except Exception as exc:
+            if DEBUG:
+                print(f"could not advance verification lifecycle: {exc}", file=sys.stderr)
+    verified, repaired_review = engine.verify_with_repair(checks, repair_runner)
+    if repaired_review is not None:
+        review_receipt = repaired_review
+    if verified and review_receipt is not None:
+        if run_id:
+            try:
+                if _get_session_store().state(run_id) == "verifying":
+                    _get_session_store().set_state(run_id, "reviewing", reason="independent review requested")
+            except Exception as exc:
+                if DEBUG:
+                    print(f"could not advance review lifecycle: {exc}", file=sys.stderr)
+        review_receipt.validate()
+        if not _review_receipt_matches_manifest(review_receipt, run_id):
+            review_receipt = None
+    if verified and review_receipt is not None:
+        reviewed = engine.review_receipt(review_receipt)
+        if not reviewed and repair_runner is not None and engine.repair():
+            outcome = repair_runner(
+                engine.repair_attempts,
+                [item.title for item in engine.review_findings if item.blocking and not item.resolved],
+            )
+            if outcome is None:
+                engine.terminalize_repair_failure("review repair runner returned no evidence")
+            else:
+                repaired_checks, repaired_receipt = outcome
+                reverified = engine.verify(repaired_checks)
+                if not reverified:
+                    engine.terminalize_failed_verification()
+                elif repaired_receipt is None:
+                    engine.terminalize_repair_failure("review repair produced no reviewer receipt")
+                elif not _review_receipt_matches_manifest(repaired_receipt, run_id):
+                    engine.terminalize_repair_failure("review repair receipt is not bound to the owned reviewer")
+                else:
+                    reviewed = engine.review_receipt(repaired_receipt)
+        if not reviewed:
+            if engine.state.value == "reviewing":
+                engine.terminalize_unresolved_review()
+        else:
+            engine.deliver()
+    elif verified:
+        # The current lane has no independent reviewer. Block honestly instead
+        # of self-certifying the provider's own completion claim.
+        engine.review([], available=False)
+    report = engine.report()
+    safe_report = redact_data(report.__dict__)
+    if run_id:
+        store = _get_session_store()
+        if report.state == "completed":
+            if store.state(run_id) != "completed":
+                store.set_state(run_id, "reviewing", reason="quality delivery ready")
+                store.set_state(run_id, "completed", quality_receipt={"passed": True, "profile": profile})
+        elif report.state in {"blocked", "incomplete", "failed"}:
+            store.set_state(run_id, report.state, quality_report=safe_report)
+    emit("quality", profile=profile, state=report.state, report=safe_report)
+    return report.state
+
+
