+def build_conversation_contents(history: list[dict], current_user_text: str) -> list[dict]:
+    """Constructs alternating user/model turns for Gemini API with current prompt."""
+    clean_req = current_user_text.strip()
+    contents: list[dict] = []
+    for turn in history:
+        role = turn.get("role")
+        parts = turn.get("parts", [])
+        if role in ("user", "model") and parts and parts[0].get("text"):
+            contents.append({
+                "role": role,
+                "parts": [{"text": parts[0]["text"]}]
+            })
+
+    if contents and contents[-1]["role"] == "user":
+        if contents[-1]["parts"][0]["text"].strip() != clean_req:
+            contents[-1]["parts"][0]["text"] = clean_req
+    else:
+        contents.append({"role": "user", "parts": [{"text": clean_req}]})
+
+    while contents and contents[0]["role"] != "user":
+        contents.pop(0)
+
+    sanitized: list[dict] = []
+    for turn in contents:
+        if sanitized and sanitized[-1]["role"] == turn["role"]:
+            sanitized[-1]["parts"][0]["text"] += "\n" + turn["parts"][0]["text"]
+        else:
+            sanitized.append(turn)
+
+    if len(sanitized) > 16:
+        sanitized = sanitized[-16:]
+        while sanitized and sanitized[0]["role"] != "user":
+            sanitized.pop(0)
+
+    return sanitized
