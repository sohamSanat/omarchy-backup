+def resolve_project_cwd(task_prompt: str, config: dict) -> Path:
+    """Create a dedicated workspace without initializing Git or provider trust."""
+    base_dir = work_dir()
+    slug = slugify_task(task_prompt) or "ui-project"
+    target = base_dir / slug
+    if target.is_dir() and any(target.iterdir()):
+        suffix = 1
+        while True:
+            candidate = base_dir / f"{slug}-{suffix}"
+            if not candidate.is_dir() or not any(candidate.iterdir()):
+                target = candidate
+                break
+            suffix += 1
+    target.mkdir(parents=True, exist_ok=True)
+    return target
+
+
+def resolve_coding_worktree(task_prompt: str, config: dict, run_id: str = "", reserve_worktree=None) -> Path:
+    """Use an existing Git repository worktree or an explicit non-Git workspace.
+
+    Omagent never initializes a hidden repository, edits the user's ignore
+    file, mutates global provider trust, or prunes unrelated workspaces here.
+    """
+    slug = slugify_task(task_prompt) or "coding-task"
+    try:
+        repository = discover_repository(Path.cwd())
+    except WorkspaceError:
+        repository = None
+    if repository is not None:
+        managed_root = Path.home() / ".local" / "state" / "omagent" / "worktrees"
+        effective_run_id = run_id or f"run-{uuid.uuid4().hex}"
+        plan = plan_worktree(Path.cwd(), managed_root=managed_root, request=task_prompt, run_id=effective_run_id)
+        target = Path(plan.worktree_root)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        if reserve_worktree is not None:
+            reserve_worktree(target)
+        try:
+            result = subprocess.run(
+                ["git", "-C", str(repository.path), "worktree", "add", "-b", plan.branch, str(target)],
+                capture_output=True,
+                text=True,
+                timeout=15,
+            )
+        except (OSError, subprocess.SubprocessError) as exc:
+            raise WorkspaceError(f"Git worktree creation failed: {exc}") from exc
+        if result.returncode != 0 or not target.is_dir():
+            detail = result.stderr.strip()[:200] or "git worktree add returned failure"
+            raise WorkspaceError(f"Git worktree creation failed: {detail}")
+        return target
+
+    coding_root = Path.home() / "Projects" / "coding-tasks"
+    target = coding_root / slug
+    if target.is_dir() and any(target.iterdir()):
+        suffix = 1
+        while target.is_dir() and any(target.iterdir()):
+            target = coding_root / f"{slug}-{suffix}"
+            suffix += 1
+    target.mkdir(parents=True, exist_ok=True)
+    return target
+
