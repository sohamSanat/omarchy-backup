+    clean_text = re.sub(r'\[(?:image|img|ref|attached)[^\]]*\]', '', text, flags=re.I)
+    clean_text = re.sub(r'[\w/.-]+\.(?:png|jpg|jpeg|webp|gif|svg)', '', clean_text, flags=re.I)
+    t = clean_text.lower()
+    if any(k in t for k in ("sport", "sports", "athlete", "athletic", "athletics", "football", "basketball", "soccer", "fitness", "workout", "gym", "marathon", "training", "coach", "stadium")):
+        return "sports_athletics"
+    if any(k in t for k in ("hair", "salon", "barber", "grooming", "coiffure", "keratin", "curls", "strands", "shears", "stylist", "haircraft")):
+        return "haircraft"
+    if any(k in t for k in ("crypto", "bitcoin", "btc", "eth", "ethereum", "solana", "web3", "defi", "trading", "trader", "exchange", "wallet", "fintech", "neobank", "hedge fund", "wealth", "investment", "portfolio tracker", "token", "nft")):
+        return "fintech_crypto"
