+def _get_session_store() -> SessionStore:
+    global _SESSION_STORE, _SESSION_STORE_PATH
+    STATE_DIR.mkdir(parents=True, exist_ok=True)
+    if _SESSION_STORE is None or _SESSION_STORE_PATH != CONTROLLER_DB_PATH:
+        if _SESSION_STORE is not None:
+            _SESSION_STORE.close()
+        _SESSION_STORE = SessionStore(CONTROLLER_DB_PATH)
+        _SESSION_STORE_PATH = CONTROLLER_DB_PATH
+    return _SESSION_STORE
+
+
+def _close_session_store() -> None:
+    global _SESSION_STORE, _SESSION_STORE_PATH
+    if _SESSION_STORE is not None:
+        _SESSION_STORE.close()
+    _SESSION_STORE = None
+    _SESSION_STORE_PATH = None
+
