+    if configured is None:
+        configured = (config.get("routes") or {}).get(key)
+    if configured is None:
+        configured = _discover_verification_command(cwd, profile)
+    if not configured:
+        return [f"{prefix}: unavailable (no declared {key})"]
+    if isinstance(configured, str):
+        command = shlex.split(configured)
+    elif isinstance(configured, (list, tuple)) and all(isinstance(item, str) for item in configured):
+        command = list(configured)
+    else:
+        return [f"{prefix}: failed (invalid {key})"]
+    if not command:
+        return [f"{prefix}: failed (empty {key})"]
+    try:
+        result = subprocess.run(
+            command,
+            cwd=str(cwd),
+            capture_output=True,
+            text=True,
+            timeout=120,
+            check=False,
+        )
+    except (OSError, subprocess.SubprocessError) as exc:
+        return [f"{prefix}: failed ({redact_text(str(exc))[:160]})"]
+    status = "passed" if result.returncode == 0 else "failed"
+    detail = redact_text((result.stdout or result.stderr or "").strip())[:200]
+    marker = f"{prefix}: {status} command={redact_text(shlex.join(command))}"
+    return [marker, f"{prefix}_detail: {detail}"] if detail else [marker]
+
+
+def _artifact_revision(cwd: Path) -> str:
+    digest = hashlib.sha256()
+    try:
+        head = subprocess.run(
+            ["git", "-C", str(cwd), "rev-parse", "HEAD"],
+            capture_output=True, text=True, timeout=5,
+        )
+        diff = subprocess.run(
+            ["git", "-C", str(cwd), "diff", "--no-ext-diff", "--binary", "HEAD"],
+            capture_output=True, text=True, timeout=10,
+        )
+        status = subprocess.run(
+            ["git", "-C", str(cwd), "status", "--porcelain"],
+            capture_output=True, text=True, timeout=5,
+        )
+        if head.returncode == 0 and diff.returncode == 0 and status.returncode == 0:
+            digest.update(head.stdout.encode())
+            digest.update(diff.stdout.encode())
+            digest.update(status.stdout.encode())
+            return f"git-{digest.hexdigest()}"
+    except (OSError, subprocess.SubprocessError):
+        pass
+    for path in sorted(cwd.rglob("*")):
+        if not path.is_file() or any(part.startswith(".") for part in path.parts):
             continue
         try:
-            event = json.loads(line)
+            relative = path.relative_to(cwd).as_posix().encode()
+            digest.update(relative)
+            digest.update(path.read_bytes())
+        except (OSError, ValueError):
+            continue
+    return f"content-{digest.hexdigest()}"
+
+
+def _ui_evidence_digests(payload: dict | None) -> dict[str, str]:
+    if not isinstance(payload, dict):
+        return {}
+    try:
+        typed = UiEvidenceResult.from_dict(payload.get("payload", payload))
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return {}
+    return {
+        "render_manifest_digest": hashlib.sha256(json.dumps(typed.manifest.as_dict(), sort_keys=True, separators=(",", ":")).encode()).hexdigest(),
+        "interaction_report_digest": hashlib.sha256(json.dumps(typed.interaction.as_dict(), sort_keys=True, separators=(",", ":")).encode()).hexdigest(),
+        "accessibility_report_digest": hashlib.sha256(json.dumps(typed.accessibility.as_dict(), sort_keys=True, separators=(",", ":")).encode()).hexdigest(),
+    }
+
+
+def _expected_ui_review_scope(run_id: str) -> dict[str, str]:
+    if not run_id:
+        return {}
+    evidence = _get_session_store().latest_evidence(run_id, "ui_evidence")
+    return _ui_evidence_digests(evidence)
