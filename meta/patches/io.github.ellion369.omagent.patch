+def is_ui_creation_request(request: str) -> bool:
+    req_lower = request.lower()
+    if detect_ui_archetype(request) is not None:
+        return True
+
+    has_ui_target = bool(re.search(UI_TARGET_NOUNS, req_lower))
+    has_framework = bool(re.search(UI_FRAMEWORK_TERMS, req_lower))
+    has_verb = bool(re.search(UI_CREATION_VERBS, req_lower))
+    has_non_ui = bool(re.search(NON_UI_EXCLUSIONS, req_lower))
+
+    if has_non_ui and not has_ui_target:
+        return False
+
+    if has_verb and (has_ui_target or (has_framework and any(k in req_lower for k in ("page", "app", "ui", "site")))):
+        return True
+
+    if has_ui_target and any(k in req_lower for k in ("landing", "website", "web page", "webpage", "portfolio", "dashboard", "showcase")):
+        return True
+
+    return False
+
