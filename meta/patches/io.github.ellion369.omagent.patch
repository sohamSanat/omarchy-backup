+
+    try:
+        router_script = Path(__file__).resolve()
+        subprocess.Popen(
+            [sys.executable, str(router_script), "--deconstruct-ref", session_id, image_path, user_request],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            start_new_session=True,
+        )
+    except Exception as e:
+        if DEBUG:
+            print(f"Failed to spawn background reference deconstruction: {e}", file=sys.stderr)
