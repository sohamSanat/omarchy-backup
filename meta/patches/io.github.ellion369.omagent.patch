+def load_prior_learnings(cwd: Path) -> str:
+    """Scans for prior repo and system learnings (ce-compound) to inform the agent before coding."""
+    learning_dirs = [
+        cwd / "solutions",
+        cwd / "docs/solutions",
+        cwd / ".agents/learnings",
+        Path.home() / ".agents/learnings",
+    ]
+    learnings = []
+    seen_files = set()
+    for d in learning_dirs:
+        if d.is_dir():
+            for f in sorted(d.glob("*.md"))[:5]:
+                if f.name in seen_files:
+                    continue
+                seen_files.add(f.name)
+                try:
+                    content = f.read_text(encoding="utf-8", errors="ignore").strip()
+                    if content:
+                        lines = [line.strip() for line in content.splitlines() if line.strip() and not line.startswith("---")]
+                        snippet = " - ".join(lines[:2])
+                        learnings.append(f"• [{f.name}]: {clip(snippet, 180)}")
+                except Exception:
+                    continue
+    if learnings:
+        return "[Prior Repository Learnings & Caveats (ce-compound)]\n" + "\n".join(learnings[:8]) + "\n\n"
+    return ""
