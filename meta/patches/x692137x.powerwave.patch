+        var now = Date.now()
+        // Prevent rapid duplicate triggers within 1500ms
+        if (now - root.lastTriggerTime < 1500) {
+            console.log("[PowerWave] Debouncing trigger from", source)
+            return
+        }
+        root.lastTriggerTime = now
+        root.triggerSerial++
