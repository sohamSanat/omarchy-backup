+fn compute_preview_margin_top(region: &Region, bar_height: u32, outputs: &[OutputRect]) -> i32 {
+    let bar_height_i64 = i64::from(bar_height);
+    let top_candidate = i64::from(region.y);
+
+    let Some(output) = select_output_for_region(region, outputs) else {
+        return i64_to_i32_saturating(top_candidate);
+    };
+
+    let output_top = i64::from(output.y);
+    let output_bottom = i64::from(output.bottom());
+    let max_top = output_bottom.saturating_sub(bar_height_i64);
+
+    let clamped = top_candidate.clamp(output_top, max_top.max(output_top));
+    i64_to_i32_saturating(clamped)
+}
