+    def test_never_ending_practice_replenishment_and_cycling(self):
+        bindings = [
+            sensei.Binding(f"Action {i}", [f"SUPER + {i}"], "exec", f"cmd{i}", f"action-{i}", f"Action {i}")
+            for i in range(1, 8)
+        ]
+        self.paths.state_dir.mkdir(parents=True, exist_ok=True)
